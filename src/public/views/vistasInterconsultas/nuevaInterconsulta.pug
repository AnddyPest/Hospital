extends ../templates/layout.pug

include ../templates/mixins.pug
mixin interconsulta(dni, atencion, paciente)
    div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%" id=`formularioDerivacion`)
            div.row.align-items-center.mb-5.mt-5
                div.col.w-25
                    div.input-group
                        input.form-control.form-control-lg(type="text" id="inputDNI" name="inputDNI" placeholder="Ingrese D.N.I." aria-label="DNI" aria-describedby="basic-addon1" value=dni disabled)
                        span.input-group-text(id="dniSpan" style="background-color: #28a745;")
                            img(src="/icons/user-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    select.form-select.form-select-lg.h-100(id="selectEsp" name="selectEsp" aria-label=".form-select-lg example")
                        option.selected Seleccione Especialidad
                        
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectMedico" name="selectMedico" aria-label=".form-select-lg example")
                        option.selected Seleccione un Médico
            div.row.align-items-center.mb-5
                div.col.w-25
                    div.input-group.date(id="datepicker")
                        input.form-control.form-control-lg(type="text" id="inputFecha" placeholder="Seleccione una fecha")
                        span.input-group-text
                            img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="hourpicker", name="hourpicker")
                        option.selected(value="Seleccione un horario") Seleccione un Horario 
                div.col.w-25
                    select#motivo.form-select.form-select-lg.w-100.h-100(name="motivo")
                        option.selected(value="Seleccione un Motivo") Seleccione un Motivo                  
            div.row.align-items-center.mt-5
                div.col.w-25
                    button.btn.w-50.btn-info(class="btn-secondary custom-button2" id="botonNext" onclick="event.preventDefault(); aceptarDatos();") Confirmar Derivación
            div.row.align-items-center  
                div.col.w-25
                div.col.w-50
                    a.btn.w-75.btn-warning.mt-5(href="#" class="btn-secondary custom-button2" id="botonAtras" onclick="event.preventDefault(); location.reload();") Reiniciar Formulario
                div.col.w-25
            div.row.align-items-center   
                div.col.w-25
                div.col.w-50
                div.col.w-25
                    a.btn.w-50.btn-danger(href="/atencion" class="btn-secondary custom-button2" id="botonAtras") Cancelar

block content
    
    div
        img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh); object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Nueva Interconsulta", "/icons/user-plus-solid.svg")

        +interconsulta(dni, atencion, paciente)
                
    script.
        // Variables globales y elementos del DOM
        const dni = document.getElementById("inputDNI");
        const dniSpan = document.getElementById("dniSpan");
        const selectEsp = document.getElementById("selectEsp");
        const selectMedico = document.getElementById("selectMedico");
        const datePicker = document.getElementById("inputFecha");
        const hourpicker = document.getElementById("hourpicker");
        const motivo = document.getElementById("motivo");
        const btnNext = document.getElementById("botonNext");
        
        // Inicializar con los datos del paciente y la atención que ya tenemos
        const idPaciente = "#{paciente ? paciente.id : ''}";
        const idAtencion = "#{atencion ? atencion.id : ''}"; 
        const dniPaciente = "#{paciente ? paciente.dni : ''}";
        let idMedico = null;
        let fechaTurno = ""; 
        let horaTurno = ""; 
        let motivoTurno = ""; 

        // Caché de médicos por especialidad
        let cachedMedicos = {};

        // Método para fijar la especialidad y cargar médicos
        async function fijarTipo() {
            try {
                // Limpiar y mostrar estado de carga en el selector de médicos
                selectMedico.innerHTML = "";
                const loadingOption = document.createElement("option");
                loadingOption.textContent = "Cargando médicos...";
                loadingOption.disabled = true;
                loadingOption.selected = true;
                selectMedico.appendChild(loadingOption);
                
                const especialidad = selectEsp.value;
                
                // Verificar si ya tenemos los médicos de esta especialidad en caché
                if (cachedMedicos[especialidad]) {
                    poblarSelectorMedicos(cachedMedicos[especialidad]);
                } else {
                    try {
                        const response = await fetch(`/medicos/especialidades/${especialidad}`);
                        if (!response.ok) {
                            throw new Error(`Error ${response.status}: No se pudieron obtener los médicos`);
                        }
                        
                        const medicos = await response.json();
                        
                        // Guardar en caché
                        cachedMedicos[especialidad] = medicos;
                        
                        // Poblar el selector
                        poblarSelectorMedicos(medicos);
                    } catch (error) {
                        manejarError(error);
                    }
                }
            } catch (error) {
                console.error("Error general:", error);
                mostrarErrorEnSelector("Error al cargar médicos");
            }
        }

        // Función para poblar el selector con los médicos
        function poblarSelectorMedicos(medicos) {
            // Limpiar el selector
            selectMedico.innerHTML = "";
            
            // Opción por defecto
            const defaultOption = document.createElement("option");
            defaultOption.value = "";
            defaultOption.textContent = "Seleccione un Médico";
            defaultOption.selected = true;
            defaultOption.disabled = true;
            selectMedico.appendChild(defaultOption);
            
            // Verificar si hay médicos
            if (!medicos || medicos.length === 0) {
                const noOption = document.createElement("option");
                noOption.disabled = true;
                noOption.textContent = "No hay médicos disponibles";
                selectMedico.appendChild(noOption);
                return;
            }
            
            // Añadir cada médico
            medicos.forEach(medico => {
                const option = document.createElement("option");
                option.value = medico.id;
                option.textContent = `${medico.nombre} ${medico.apellido}`;
                selectMedico.appendChild(option);
            });
        }

        // Función para manejar errores
        function manejarError(error) {
            console.error("Error al cargar médicos:", error);
            mostrarErrorEnSelector("Error al obtener médicos");
        }

        // Función para mostrar un mensaje de error en el selector
        function mostrarErrorEnSelector(mensaje) {
            selectMedico.innerHTML = "";
            const errorOption = document.createElement("option");
            errorOption.textContent = mensaje;
            errorOption.disabled = true;
            errorOption.selected = true;
            selectMedico.appendChild(errorOption);
            
            // Añadir opción para reintentar
            const retryOption = document.createElement("option");
            retryOption.value = "retry";
            retryOption.textContent = "Reintentar";
            selectMedico.appendChild(retryOption);
            
            // Escuchar eventos de cambio para detectar el reintento
            const handleRetry = () => {
                if (selectMedico.value === "retry") {
                    fijarTipo(); // Reintentar la carga
                }
            };
            
            selectMedico.addEventListener("change", handleRetry, { once: true });
        }

        // Cargamos las especialidades en el selector
        document.addEventListener("DOMContentLoaded", async () => {
            try {
                const response = await fetch("/especialidades/listado");
                if (!response.ok) {
                    throw new Error("Error al obtener las especialidades");
                }
                const especialidades = await response.json();
                
                // Añadimos las especialidades médicas
                especialidades.forEach(esp => {
                    const option = document.createElement("option");
                    option.value = esp.id;  
                    option.textContent = esp.nombre;  
                    selectEsp.appendChild(option);
                });
                
                // Marcar el DNI como encontrado ya que viene de la pantalla anterior
                dniSpan.style.backgroundColor = "#28a745"; // Verde
                
                // Agregar llamada para cargar motivos
                await cargarMotivos();
                
            } catch (error) {
                console.error("Error al cargar las especialidades:", error);
            }
        });
            
        // Configuración del datepicker
        $(document).ready(function() {
            $('#datepicker input').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'es',
                startDate: new Date(),
            });
        });
        
        // Listener para cambio de especialidad
        document.addEventListener("DOMContentLoaded", () => {
            selectEsp.addEventListener("change", async () => {
                fijarTipo();
            });
        });
        
        // Listener para selección de médico
        document.addEventListener("DOMContentLoaded", () => {
            selectMedico.addEventListener("change", async () => {
                aceptarMedico();
            }); 
        });
        
        // Método para guardar el médico seleccionado
        async function aceptarMedico() {
            if(selectMedico.value === "Seleccione un Médico") {
                alert("Seleccione un médico");
            } else {
                idMedico = selectMedico.value;
                console.log("Médico seleccionado ID:", idMedico);
            }
        }

        // Listener para cambio de fecha
        document.addEventListener("DOMContentLoaded", () => {
            $('#datepicker input').on('changeDate', async () => {
                if(selectMedico.value !== "Seleccione un Médico" && idMedico) {
                    aceptarFecha();
                } else {
                    alert("Debe seleccionar un médico antes de seleccionar una fecha");
                    datePicker.value = "";
                }
            });
        });

        // Función para procesar la selección de fecha
        async function aceptarFecha() {
            const fecha = document.getElementById("inputFecha").value;
            if (fecha === "") {
                alert("Seleccione una fecha");
                return;
            }   
            
            try {
                // Convertir la fecha al formato YYYY-MM-DD
                const partesFecha = fecha.split("/");
                const fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`;
                
                fechaTurno = fecha;
                
                // Solicitar horarios disponibles
                const response = await fetch(`/turnos/listadohorarios/${idMedico}/${fechaFormateada}`);
                
                if(!response.ok) {
                    throw new Error(`Error ${response.status}: No se pudieron obtener los horarios disponibles`);
                }
                
                const horarios = await response.json();
                cargarHorariosDisponibles(horarios);
                
            } catch (error) {
                console.error("Error al obtener horarios:", error);
                alert("Error al cargar horarios disponibles: " + error.message);
                
                // Limpiar el selector de horarios y mostrar mensaje de error
                hourpicker.innerHTML = "";
                const errorOption = document.createElement("option");
                errorOption.textContent = "Error al cargar horarios. Intente nuevamente.";
                errorOption.disabled = true;
                errorOption.selected = true;
                hourpicker.appendChild(errorOption);
            }
        }

        // Función para cargar los horarios disponibles
        function cargarHorariosDisponibles(horarios) {
            // Limpiar el selector de horarios
            hourpicker.innerHTML = "";
            
            // Opción por defecto
            const defaultOption = document.createElement("option");
            defaultOption.value = "";
            defaultOption.textContent = "Seleccione un horario";
            defaultOption.selected = true;
            defaultOption.disabled = true;
            hourpicker.appendChild(defaultOption);
            
            // Definir horario laboral
            const startTime = new Date();
            startTime.setHours(8, 0, 0); // Entrada 8:00
            const endTime = new Date();
            endTime.setHours(16, 0, 0); // Salida 16:00
            
            // Generar horarios cada 40 minutos
            const intervaloMinutos = 40;
            let currentTime = new Date(startTime);
            
            // Registro de horarios ocupados
            const horariosOcupados = new Set();
            horarios.forEach(horario => {
                const hora = horario.hora.split(":")[0];
                const minuto = horario.hora.split(":")[1];
                horariosOcupados.add(`${hora}:${minuto}`);
            });
            
            // Generar opciones para cada horario disponible
            while (currentTime <= endTime) {
                const hora = currentTime.getHours().toString().padStart(2, "0");
                const minuto = currentTime.getMinutes().toString().padStart(2, "0");
                const horarioStr = `${hora}:${minuto}`;
                
                if (!horariosOcupados.has(horarioStr)) {
                    const option = document.createElement("option");
                    option.value = horarioStr;
                    option.textContent = horarioStr;
                    hourpicker.appendChild(option);
                }
                
                currentTime.setMinutes(currentTime.getMinutes() + intervaloMinutos);
            }
        }

        // Listener para selección de horario
        document.addEventListener("DOMContentLoaded", () => {
            hourpicker.addEventListener("change", async () => {
                aceptarHorario();
            })
        })
        
        // Función para registrar el horario seleccionado
        async function aceptarHorario() {
            const hora = hourpicker.value;
            if (hora === "Seleccione un horario") {
                alert("Seleccione un horario");
            } else {
                horaTurno = hora;
            }
        }

        // Función para validar y enviar todos los datos
        async function aceptarDatos() {
            motivoTurno = motivo.value;
            
            if (!idMedico || fechaTurno === "" || horaTurno === "" || motivoTurno === "") {
                alert("Complete todos los campos");
            } else {
                // Enviar datos para crear la derivación
                enviarDatos();
            }
        }

        // Función para enviar los datos al servidor
        async function enviarDatos() {
            const estado = "pendiente";
            
            try {
                // Formatear fecha y hora
                const partesFecha = fechaTurno.split("/");
                const fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`;
                const horaFormateada = `${horaTurno}:00`;
                
                console.log("Datos de la derivación:", {
                    fechaFormateada,
                    horaFormateada,
                    motivoTurno,
                    estado,
                    idPaciente,
                    idMedico,
                    idAtencion
                });
                
                // Enviar solicitud para crear derivación
                const response = await fetch("/turnos/admin/new", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        estado: estado,
                        fecha: fechaFormateada,
                        hora: horaFormateada,
                        motivo_Id: motivoTurno,
                        paciente_Id: idPaciente,
                        medico_Id: idMedico,
                        atencion_Id: idAtencion
                    })
                });
                
                if (response.redirected) {
                    alert("Derivación creada con éxito");
                    window.location.href = response.url;
                    return;
                }
                
                const contentType = response.headers.get("content-type");
                
            } catch (error) {
                console.error("Error al crear la derivación:", error);
                alert("Error al crear la derivación: " + error.message);
            }
        }

        // Agregar esta función para cargar los motivos
        async function cargarMotivos() {
            try {
                const response = await fetch("/motivos/listado");
                if (!response.ok) {
                    throw new Error("Error al obtener los motivos");
                }
                
                const motivos = await response.json();
                
                // Limpiar el selector
                motivo.innerHTML = "";
                
                // Opción por defecto
                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = "Seleccione un Motivo";
                defaultOption.selected = true;
                defaultOption.disabled = true;
                motivo.appendChild(defaultOption);
                
                // Añadir cada motivo
                motivos.forEach(m => {
                    const option = document.createElement("option");
                    option.value = m.id;
                    option.textContent = m.nombre;
                    motivo.appendChild(option);
                });
            } catch (error) {
                console.error("Error al cargar motivos:", error);
                const errorOption = document.createElement("option");
                errorOption.textContent = "Error al cargar motivos";
                errorOption.disabled = true;
                errorOption.selected = true;
                motivo.innerHTML = "";
                motivo.appendChild(errorOption);
            }
        }



