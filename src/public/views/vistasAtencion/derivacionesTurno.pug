extends ../templates/layout
include ../templates/mixins.pug

block content
    // Mensaje de error si existe
    if error
        div.alert.alert-danger.alert-dismissible.fade.show.position-absolute.top-0.start-50.translate-middle-x.mt-4(role="alert")
            strong= error
            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Cerrar")
    
    div
        img(src="/images/atencion.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Derivaciones", "/icons/truck-medical-solid.svg")
        
        div.position-absolute.top-50.start-50.translate-middle.text-center
            if paciente
                // Mostrar datos del paciente
                div.card.mb-4.bg-dark.text-white.border.border-info
                    div.card-header.bg-info.text-dark
                        h4.m-0 Datos del Paciente
                    div.card-body
                        h5.card-title #{paciente.nombre} #{paciente.apellido}
                        p.card-text DNI: #{paciente.dni}
                        
                // Formulario de derivación
                div.card.bg-dark.text-white.border.border-info
                    div.card-header.bg-info.text-dark
                        h4.m-0 Derivar a Hospital Externo
                    div.card-body
                        if hospitalesExternos && hospitalesExternos.length > 0
                            form(action=`/atenciones/derivar/${atencion.id}` method="POST")
                                div.mb-3
                                    label.form-label(for="hospitalExterno") Seleccione Hospital:
                                    select.form-select(name="hospitalExterno" id="hospitalExterno" required)
                                        option(value="" selected disabled) Seleccione un hospital
                                        each hospital in hospitalesExternos
                                            option(value=hospital.id) #{hospital.nombre} - Complejidad: #{hospital.complejidad}
                                
                                div.mb-3
                                    label.form-label(for="motivoDerivacion") Motivo de Derivación:
                                    textarea.form-control(name="motivoDerivacion" id="motivoDerivacion" rows="3" required)
                                
                                button.btn.btn-primary.w-100(onclick="event.preventDefault(); guardarDerivacion();")
                                    i.fas.fa-ambulance.me-2
                                    | Confirmar Derivación
                        else
                            div.alert.alert-warning
                                p No hay hospitales externos disponibles para derivación.
            else
                // Formulario de búsqueda si no hay paciente seleccionado
                div.row.align-items-center.mb-5.mt-5
                    div.row.w-75
                        div.input-group
                            input.form-control.form-control-lg(type="text" id="inputDNI" name="inputDNI" placeholder="Ingrese D.N.I." aria-label="DNI" aria-describedby="basic-addon1")
                            span.input-group-text(id="dniSpan" style="background-color: #0d6efd;")
                                img(src="/icons/user-solid.svg" style="width: 20px; height: 20px;")
                    button#btnBuscar.ms-2.btn.btn-primary.w-25.d-flex.align-items-center.justify-content-center.gap-2(type="button" class="custom-button2" style="height: 50px;" onclick="event.preventDefault(); cargarPaciente();")
                        | Buscar
                        img.ms-2(src="/icons/magnifying-glass-solid.svg", alt="Buscar", style="width: 20px; height: 20px;")
            
            // Botón para volver
            div.mt-4
                a.btn.btn-danger.btn-lg.px-5(href="/" alt="Inicio")
                    span Volver
                    img.ms-2(src="/icons/house-solid.svg", alt="Inicio", style="width: 20px; height: 20px; opacity: 0.8;")
    script.
        const atencionId = "#{atencion.id}";
        
        async function guardarDerivacion() {
           
            const hospitalExternoId = document.getElementById('hospitalExterno').value;
            const observaciones = document.getElementById('motivoDerivacion').value;
            console.log('ID de Hospital Externo:', hospitalExternoId);
            console.log('Observaciones:', observaciones);
            if (hospitalExternoId && observaciones) {
                try {
                    // Esperar la respuesta del servidor con await
                    const response = await fetch(`/atencion/derivacion/guardar/${atencionId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            hospitalExternoId,
                            observaciones,
                            
                        })
                    });
                    
                    // Procesar la respuesta
                    if (response.ok) {
                        alert('Derivación guardada con éxito.');
                        window.location.href = '/#'; // Redireccionar después de guardar
                        
                    } else {
                        const errorData = await response.json();
                        alert(`Error: ${errorData.message || 'No se pudo guardar la derivación'}`);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error de conexión al guardar la derivación.');
                }
            } else {
                alert('Por favor, complete todos los campos.');
            }
        }