extends ../templates/layout

include ../templates/mixins.pug
mixin atencionPaciente(turno)
    div.position-absolute.top-50.start-50.translate-middle.text-center(style="width: 90%;")
        div.card.bg-dark.text-light.border-info.shadow.mt-5
            div.card-header.bg-primary.text-white
                h4 Registro de Atención Médica
            
            div.card-body
                form#atencionForm.ms-5()
                    div.row
                        //- columna de datos del paciente con labels inline
                        div.col-md-5.ms-1
                            div.row.mb-1
                                div.col.text-start
                                    div.mb-1
                                        label.fw-bold.me-2 Fecha:
                                        span.text-light #{turno ? turno.fecha : new Date().toLocaleDateString()}
                                
                                div.col.text-start
                                    div.mb-1
                                        label.fw-bold.me-2 Hora:
                                        span.text-light #{turno ? turno.hora : new Date().toLocaleTimeString()}
                            hr.border-info.opacity-75.mt-1.mb-1
                            div.row.mb-1
                                div.col.mb-3.text-start
                                    label.fw-bold.me-2 Paciente:
                                    span.text-light #{turno.Paciente.nombre} #{turno.Paciente.apellido}
                                
                                div.col.mb-3.text-start
                                    label.fw-bold.me-2 DNI:
                                    span#dniPaciente.text-light #{turno.Paciente.dni}
                            hr.border-info.opacity-75.mt-1.mb-1    
                            div.d-flex.align-items-center
                                div.mb-2
                                    label.fw-bold.me-2 Obra Social:
                                    span.text-light #{turno.Paciente.obra_social || "No registrada"}
                                div.input-group
                                    span.input-group-text.bg-dark.text-light N°:
                                    input#afiliado.form-control.bg-dark.text-light(
                                        type="text" 
                                        name="numeroAfiliado"
                                        placeholder="Ingrese número de afiliado" required)
                            hr.border-info.opacity-75.mt-1.mb-1
                            div.row.mb-3
                                div.row-md-5
                                    label.form-label Observaciones:
                                    textarea#observaciones.form-control.bg-dark.text-light(rows="5"  name="observaciones")
                        //- datos de la consulta 
                        div.col-md-6.mb-2
                            
                            div.mb-3
                                label.form-label Diagnostico:
                                textarea#diagnostico.form-control.bg-dark.text-light(rows="10" name="diagnostico" required)
                            div.col
                                if turno.Medico
                                    div.d-flex.align-items-center.mb-3
                                        div.me-3
                                            label.fw-bold.ms-2.me-2 Dr./Dra.:
                                            span.text-light #{turno.Medico.nombre} #{turno.Medico.apellido}
                                        
                                        div.input-group.ms-5(style="max-width: 300px;")
                                            span.input-group-text.bg-dark.text-light Matricula N°:
                                            input#matricula.form-control.bg-dark.text-light(
                                                name="matricula"
                                                required
                                            )
                                                

                                else if turno.Enfermero
                                    div.d-flex.align-items-center.mb-3
                                        label.fw-bold.me-2 Enf.:
                                        span.text-light #{turno.Enfermero.nombre} #{turno.Enfermero.apellido}
                                    div.input-group.ms-5(style="max-width: 300px;")
                                            span.input-group-text.bg-dark.text-light Matricula N°:
                                            input#matricula.form-control.bg-dark.text-light(
                                                name="matricula"
                                                required
                                            )    
    
                            button#cleanForm.btn.btn-warning.me-5(onclick="event.preventDefault(); refreshPage();") Limpiar Formulario                                                        
                            button#saveForm.btn.btn-success(onclick="event.preventDefault(); guardarConsulta();") Guardar
                            //- campo fantasma para el id del turno
                            input(type="hidden" name="turnoId" value=turno ? turno.id : '')
                            
                            //- botones ver de agregar lo que haga falta
                    hr.border-info.opacity-75.mt-1.mb-1
                    div.d-flex.justify-content-between.mt-4
                        button#derivation.btn.btn-primary(onclick="event.preventDefault(); derivarPaciente();") Derivacion
                        button#prescription.btn.btn-info(onclick="event.preventDefault(); prescripcion();") Prescripcion
                        button#intern.btn.btn-warning(onclick="event.preventDefault(); internar();") Internacion
                        button#emergency.btn.btn-danger.me-5(onclick="event.preventDefault(); emergencia();") Emergencia
                        a#cancel.btn.btn-secondary.mt-2(href=`/atencion/paciente/${turno.Paciente.dni}`) Cancelar
block content
   

    div
        img(src="/images/atencion.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        
        
        +atencionPaciente(turno)
    script.
        document.addEventListener('DOMContentLoaded', initOptionPanel);
        const turno_Id = '#{turno ? turno.id : ''}';
        // limpia el formulario
        function refreshPage()  {
            window.location.reload();
        }

        async function guardarConsulta() {
            const diagnostico = document.getElementById('diagnostico').value;
            const observaciones = document.getElementById('observaciones').value;
            const afiliado = document.getElementById('afiliado').value;
            const matricula = document.getElementById('matricula').value;

            let validacion = true;
            const mensajeError = [];

            if(!diagnostico) {
                mensajeError.push('El campo diagnostico es obligatorio.');
                validacion = false;
            }
            if(!afiliado) {
                mensajeError.push('El campo afiliado es obligatorio.');
                validacion = false;
            }
            if(!matricula) {
                mensajeError.push('El campo matricula es obligatorio.');
                validacion = false;
            }
            if(!validacion) {
                alert(mensajeError.join('\n'));
                return;
            }
                const datosFormulario = {
                    diagnostico: diagnostico,
                    observaciones: observaciones,
                    afiliado: afiliado,
                    matricula: matricula,
                    turno_Id: turno_Id,
                }
                body = JSON.stringify(datosFormulario);
                const response = await fetch(`/atencion/guardarConsulta/${turno_Id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: body
                });
                if(response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        optionpanel('Consulta guardada ¿Requiere acciones adicionales?', 'success');
                        
                    } else {
                        alert('Error al guardar la consulta');
                    }
                } else {
                    alert('Error en la respuesta del servidor');
                    }
                };
        function initOptionPanel() {
            const modal = document.createElement("div");
            modal.className = "modal fade";
            modal.id = "optionModal";
            modal.tabIndex = "-1";
            modal.innerHTML = `
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark text-light">
                    <div class="modal-header" border-info">
                        <h5 class="modal-title">Atención!</h5>
                    </div>
                    <div class="modal-body">
                        <p id="optionMessage"></p>
                    </div>
                    <div class="modal-footer border-info">
                        <button type="button" class="btn btn-success" id="btnSi">Si</button>
                        <button type="button" class="btn btn-danger" id="btnNo">No</button>
                    </div>
                </div>
            </div>
            `;
            document.body.appendChild(modal);
        };
        
        function optionpanel(message, type) {
            return new Promise((resolve) => {
                const modal = new bootstrap.Modal(document.getElementById('optionModal'));
                document.getElementById('optionMessage').textContent = message;
                let dni = document.getElementById('dniPaciente').textContent;
                
                const btnSi = document.getElementById('btnSi');
                const btnNo = document.getElementById('btnNo');
                
                const handleYes = () => {
                    btnSi.removeEventListener('click', handleYes);
                    btnNo.removeEventListener('click', handleNo);
                    modal.hide();
                    resolve(true);
                };
                
                const handleNo = () => {
                    btnSi.removeEventListener('click', handleYes);
                    btnNo.removeEventListener('click', handleNo);
                    modal.hide();
                    resolve(false);
                    window.location.href = `/atencion/paciente/${dni}`;
                };
                
                btnSi.addEventListener('click', handleYes);
                btnNo.addEventListener('click', handleNo);
                
                modal.show();
            });
        };
                