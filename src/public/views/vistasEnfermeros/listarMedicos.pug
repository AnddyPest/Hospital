extends ../templates/layout.pug

include ../templates/mixins.pug

block content
      
        
        
    div
        img(src="/images/trabajadores.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Listado de Médicos", "/icons/user-doctor-solid.svg")
        
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id="tablaMedicos")
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        tr.table-info
                            th.col(style="width: 10%") ID
                            th.col(style="width: 22.5%") Nombre
                            th.col(style="width: 22.5%") Apellido
                            th.col(style="width: 22.5%") Telefono
                            th.col(style="width: 22.5%") Especialidad
                    
                    tbody
                        
            
            //-botones de ingreso a filtros y volver a la vista principal
            div.mt-3(id="filtros")
                button.btn.btn-info.me-4(type="button", id="especialidad" class="custom-button2") Filtrar por Especialidad
                button.btn.btn-info.ms-4.me-4(type="button", id="nombre" class="custom-button2") Buscar por Apellido
                a.btn.btn-danger.ms-4(href="/medicos" type="button", class="custom-button2" style="width: 50px; padding:5px;") 
                    img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")
            //--Inputs importados de mixins.pug de busqueda y botones de filtro
            +inputGroup("inputEspecialidad", "Ingrese la especialidad", "Filtrar", "Limpiar", "Volver")
            +inputGroup("inputApe", "Ingrese el Apellido", "Filtrar", "Limpiar", "Volver")
            
    script.
        //carga de medicos en tabla
        async function cargarMedicos() {
            try {
                const response = await fetch("/medicos/listado");
                console.log(response);
                if(!response.ok) {
                    throw new error("Error al obtener medicos de la DB");
                }
                const medicos = await response.json();

                const tbody = document.querySelector("#tablaMedicos tbody");
                tbody.innerHTML = ""; //Limpia la tabla si se hizo una modificacion o busqueda.

                medicos.forEach((medico) => {
                    const fila = `
                        <tr>
                            <td>${medico.id}</td>
                            <td>${medico.nombre}</td>
                            <td>${medico.apellido}</td>
                            <td>${medico.telefono}</td>
                            <td>${medico.especialidad}</td>
                        </tr>
                    `;
                    tbody.innerHTML += fila;
                });
            } catch (error) {
                console.error("Error al cargar los medicos:", error);
                alert("No se pudieron cargar los medicos.")
            }};

        cargarMedicos();
        


         document.addEventListener("DOMContentLoaded", () => {
            const tablaMedicos = document.getElementById("tablaMedicos");

            const btnEspecialidad = document.getElementById("especialidad");
            const btnNombre = document.getElementById("nombre");

            const containerFiltros = document.getElementById("filtros");

            const inputEspecialidad = document.getElementById("inputEspecialidad");
            const inputApe = document.getElementById("inputApe");

            const btnVolver = document.querySelectorAll(".volver");
        
            //boton para filtrar por especialidad
            btnEspecialidad.addEventListener("click", (e) => {
                e.preventDefault();
                containerFiltros.style.display = "none";
                inputEspecialidad.style.display = "block";
                inputEspecialidad.querySelector("input").focus();
            });

            //boton para filtrar por apellido
            btnNombre.addEventListener("click", (e) => {
                e.preventDefault();
                containerFiltros.style.display = "none";
                inputApe.style.display = "block";
                inputApe.querySelector("input").focus();
            });
            //Agregar un listener por cada boton de la clase volver!!!
            btnVolver.forEach((btn) => {
                btn.addEventListener("click", (e) => {
                e.preventDefault();
                inputEspecialidad.style.display = "none";
                inputApe.style.display = "none";
                containerFiltros.style.display = "block";
                });
            });
        
        });


        
            