extends ../templates/layout.pug

include ../templates/mixins.pug

block content
    
        
        
    div
        img(src="/images/trabajadores.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Nuevo Médico", "/icons/user-plus-solid.svg")
        
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%;" id="formularioMedico")
            div.d-flex.justify-content-center
                form.w-75(id="formMedico", method="POST", action="/medicos/admin/new")
                    div.form-floating.mb-3
                        input.form-control(type="text", id="nombre", name="nombre", placeholder="Nombre" required)
                        label(for="nombre") Nombre
                    div.form-floating.mb-3
                        input.form-control(type="text", id="apellido", name="apellido", placeholder="Apellido" required)
                        label(for="apellido") Apellido
                    div.form-floating.mb-3
                        input.form-control(type="text", id="especialidad", name="especialidad", placeholder="Especialidad" required)
                        label(for="especialidad") Especialidad
                    div.form-floating.mb-3
                        input.form-control(type="text", id="telefono", name="telefono", placeholder="Teléfono" required)
                        label(for="telefono") Teléfono
                    div.d-flex.justify-content-center.mt-4
                        button.btn.btn-primary.me-5.w-25(type="submit") Guardar Médico
                        a.btn.btn-danger.ms-5.w-25(href="/medicos/admin" type="button", id="cancelar") Cancelar

    script.
        
        document.getElementById("formMedico").addEventListener("submit", async function(event) {
            event.preventDefault();

            const form = document.getElementById("formMedico");
            
            const formData = new FormData(form);

            const datos = Object.fromEntries(formData.entries());

            try {
                const response = await fetch("/medicos/admin/new", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(datos),
                });

                const result = await response.json();
                console.log(result);
                console.log(response);
                if (response.ok) {
                    alert("Medico: "+result.nombre+" "+result.apellido+" agregado con exito."); //si ok
                    form.reset(); // limpia
                } else {
                    alert(result.error); // si no ok
                }
            } catch (error) {
                console.error("Error al enviar el formulario:", error);
                alert("Ha ocurrido un error inesperado");
            }
            
        })

        