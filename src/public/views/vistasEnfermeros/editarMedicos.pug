extends ../templates/layout.pug

include ../templates/mixins.pug

block content
    div
        img(src="/images/trabajadores.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh); object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Editar Médicos", "/icons/user-pen-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%;" id="formularioMedico")
            div.d-flex.justify-content-center
            form(id="formEditarMedico", onsubmit="event.preventDefault(); guardarCambios();")
                div.form-floating.mb-3
                    input.form-control(type="text", id="idMedico" name="id" readonly placeholder="ID")
                    label(for="idMedico") ID
                div.form-floating.mb-3
                    input.form-control(type="text", id="nombreMedico" name="nombre" placeholder="Nombre" required)
                    label(for="nombreMedico") Nombre
                div.form-floating.mb-3
                    input.form-control(type="text", id="apellidoMedico" name="apellido" placeholder="Apellido" required)
                    label(for="apellidoMedico") Apellido
                div.form-floating.mb-3
                    input.form-control(type="text", id="telefonoMedico" name="telefono" placeholder="Teléfono" required)
                    label(for="telefonoMedico") Teléfono
                div.form-floating.mb-3
                    input.form-control(type="text", id="especialidadMedico" name="especialidad" placeholder="Especialidad" required)
                    label(for="especialidadMedico") Especialidad
                div.d-flex.justify-content-center.mt-4
                    button.btn.btn-primary.me-5.w-25(type="submit") Guardar Cambios
                    a.btn.btn-danger.ms-5.w-25(type="button" href="/medicos/admin/seleccionar") Cancelar

    script.
        function getQueryParams() { //traemos los parametros de la pagina de seleccion
            const params = new URLSearchParams(window.location.search);
            return {
                id: params.get("id"),
                nombre: params.get("nombre"),
                apellido: params.get("apellido"),
                telefono: params.get("telefono"),
                especialidad: params.get("especialidad"),
            };
        }

        // cargamos los datos traidos en el form
        function cargarFormulario() {
            const { id, nombre, apellido, telefono, especialidad } = getQueryParams();
            document.getElementById("idMedico").value = id.trim();
            document.getElementById("nombreMedico").value = nombre.trim();
            document.getElementById("apellidoMedico").value = apellido.trim();
            document.getElementById("telefonoMedico").value = telefono.trim();
            document.getElementById("especialidadMedico").value = especialidad.trim();
        }

       
        cargarFormulario();

        async function guardarCambios() {
            const id = document.getElementById("idMedico").value.trim();
            const nombre = document.getElementById("nombreMedico").value.trim();
            const apellido = document.getElementById("apellidoMedico").value.trim();
            const telefono = document.getElementById("telefonoMedico").value.trim();
            const especialidad = document.getElementById("especialidadMedico").value.trim();

            try {
                const response = await fetch(`/medicos/editar/${id}`, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ nombre, apellido, telefono, especialidad }),
                });

                if (!response.ok) {
                    throw new Error("Error al guardar los cambios");
                }

                alert("Cambios guardados con éxito");
                window.location.href = "/medicos/admin/seleccionar"; // Redirige después de guardar
            } catch (error) {
                console.error("Error al guardar los cambios:", error);
                alert("No se pudieron guardar los cambios");
            }
        }


      



