extends ../templates/layout.pug

include ../templates/mixins.pug

block content
    div
        img(src="/images/enfermeras.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh); object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Editar Enfermeros", "/icons/user-pen-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%;" id="formularioEnfermero")
            div.d-flex.justify-content-center
            form(id="formEditarEnfermero", onsubmit="event.preventDefault(); guardarCambios();")
                div.form-floating.mb-3
                    input.form-control(type="text", id="idEnfermero" name="id" readonly placeholder="ID")
                    label(for="idEnfermero") ID
                div.form-floating.mb-3
                    input.form-control(type="text", id="nombreEnfermero" name="nombre" placeholder="Nombre" required)
                    label(for="nombreEnfermero") Nombre
                div.form-floating.mb-3
                    input.form-control(type="text", id="apellidoEnfermero" name="apellido" placeholder="Apellido" required)
                    label(for="apellidoEnfermero") Apellido
                div.form-floating.mb-3
                    input.form-control(type="text", id="telefonoEnfermero" name="telefono" placeholder="Teléfono" required)
                    label(for="telefonoEnfermero") Teléfono
                div.form-floating.mb-3
                    input.form-control(type="text", id="areaEnfermero" name="area" placeholder="Area" required)
                    label(for="areaEnfermero") Area
                div.d-flex.justify-content-center.mt-4
                    button.btn.btn-primary.me-5.w-25(type="submit") Guardar Cambios
                    a.btn.btn-danger.ms-5.w-25(type="button" href="/enfermeros/admin/seleccionar") Cancelar

    script.
        function getQueryParams() { //traemos los parametros de la pagina de seleccion
            const params = new URLSearchParams(window.location.search);
            return {
                id: params.get("id"),
                nombre: params.get("nombre"),
                apellido: params.get("apellido"),
                telefono: params.get("telefono"),
                area: params.get("area"),
            };
        }

        // cargamos los datos traidos en el form
        function cargarFormulario() {
            const { id, nombre, apellido, telefono, area } = getQueryParams();
            document.getElementById("idEnfermero").value = id.trim();
            document.getElementById("nombreEnfermero").value = nombre.trim();
            document.getElementById("apellidoEnfermero").value = apellido.trim();
            document.getElementById("telefonoEnfermero").value = telefono.trim();
            document.getElementById("areaEnfermero").value = area.trim();
        }

       
        cargarFormulario();

        async function guardarCambios() {
            const id = document.getElementById("idEnfermero").value.trim();
            const nombre = document.getElementById("nombreEnfermero").value.trim();
            const apellido = document.getElementById("apellidoEnfermero").value.trim();
            const telefono = document.getElementById("telefonoEnfermero").value.trim();
            const area = document.getElementById("areaEnfermero").value.trim();

            try {
                const response = await fetch(`/enfermeros/editar/${id}`, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ nombre, apellido, telefono, area }),
                });

                if (!response.ok) {
                    throw new Error("Error al guardar los cambios");
                }

                alert("Cambios guardados con éxito");
                window.location.href = "/enfermeros/admin/seleccionar"; // Redirige después de guardar
            } catch (error) {
                console.error("Error al guardar los cambios:", error);
                alert("No se pudieron guardar los cambios");
            }
        }


      



