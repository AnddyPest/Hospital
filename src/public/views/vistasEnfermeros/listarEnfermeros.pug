extends ../templates/layout.pug

include ../templates/mixins.pug

block content
      
        
        
    div
        img(src="/images/enfermeras.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Listado de Enfermeros", "/icons/user-nurse-solid.svg")
        
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id="tablaEnfermeros")
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        tr.table-info
                            th.col(style="width: 10%") ID
                            th.col(style="width: 22.5%") Nombre
                            th.col(style="width: 22.5%") Apellido
                            th.col(style="width: 22.5%") Telefono
                            th.col(style="width: 22.5%") Area
                    
                    tbody
                        
            
            //-botones de ingreso a filtros y volver a la vista principal
            div.mt-3(id="filtros")
                button.btn.btn-info.me-4(type="button", id="area" class="custom-button2") Filtrar por Area
                button.btn.btn-info.ms-4.me-4(type="button", id="nombre" class="custom-button2") Buscar por Apellido
                a.btn.btn-danger.ms-4(href="/enfermeros" type="button", class="custom-button2" style="width: 50px; padding:5px;") 
                    img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")
            //--Inputs importados de mixins.pug de busqueda y botones de filtro
            +inputGroup("inputArea", "Ingrese el Area", "Filtrar", "Limpiar", "Volver")
            +inputGroup("inputApe", "Ingrese el Apellido", "Filtrar", "Limpiar", "Volver")
            
    script.
        //carga de medicos en tabla
        async function cargarEnfermeros() {
            try {
                const response = await fetch("/enfermeros/listado");
                console.log(response);
                if(!response.ok) {
                    throw new error("Error al obtener enfermeros de la DB");
                }
                const enfermeros = await response.json();

                const tbody = document.querySelector("#tablaEnfermeros tbody");
                tbody.innerHTML = ""; //Limpia la tabla si se hizo una modificacion o busqueda.

                enfermeros.forEach((enfermero) => {
                    const fila = `
                        <tr>
                            <td>${enfermero.id}</td>
                            <td>${enfermero.nombre}</td>
                            <td>${enfermero.apellido}</td>
                            <td>${enfermero.telefono}</td>
                            <td>${enfermero.area}</td>
                        </tr>
                    `;
                    tbody.innerHTML += fila;
                });
            } catch (error) {
                console.error("Error al cargar los enfermeros:", error);
                alert("No se pudieron cargar los enfermeros.")
            }};

        cargarEnfermeros();
        


         document.addEventListener("DOMContentLoaded", () => {
            const tablaEnfermeros = document.getElementById("tablaEnfermeros");

            const btnArea = document.getElementById("area");
            const btnNombre = document.getElementById("nombre");

            const containerFiltros = document.getElementById("filtros");

            const inputArea = document.getElementById("inputArea");
            const inputApe = document.getElementById("inputApe");

            const btnVolver = document.querySelectorAll(".volver");
        
            //boton para filtrar por especialidad
            btnArea.addEventListener("click", (e) => {
                e.preventDefault();
                containerFiltros.style.display = "none";
                inputArea.style.display = "block";
                inputArea.querySelector("input").focus();
            });

            //boton para filtrar por apellido
            btnNombre.addEventListener("click", (e) => {
                e.preventDefault();
                containerFiltros.style.display = "none";
                inputApe.style.display = "block";
                inputApe.querySelector("input").focus();
            });
            //Agregar un listener por cada boton de la clase volver!!!
            btnVolver.forEach((btn) => {
                btn.addEventListener("click", (e) => {
                e.preventDefault();
                inputArea.style.display = "none";
                inputApe.style.display = "none";
                containerFiltros.style.display = "block";
                });
            });
        
        });


        
            