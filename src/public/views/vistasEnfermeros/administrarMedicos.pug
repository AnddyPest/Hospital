extends ../templates/layout.pug

include ../templates/mixins.pug

block content
        
        
        
    div
        img(src="/images/trabajadores.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Administrar Médicos", "/icons/user-doctor-solid.svg")
        
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(id="adminControl")
            div.d-flex.justify-content-center.align-items-center.gap-4
                a.btn.btn-success.ms-4(href="/medicos/admin/new" type="button", id="agregar" class="custom-button2" style="width: 350px;") 
                    span() Agregar Médico
                    img(src="/icons/user-plus-solid.svg", alt="Agregar Medico", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                a.btn.btn-warning(href="/medicos/admin/seleccionar", type="button", id="editar" class="custom-button2" style="width: 350px;") 
                    span() Editar Médico
                    img(src="/icons/user-pen-solid.svg", alt="Editar Medico", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                a.btn.btn-danger.me-4(href="/medicos/admin/borrar", type="button", id="borrar" class="custom-button2" style="width: 350px;") 
                    span() Borrar Médico
                    img(src="/icons/user-slash-solid.svg", alt="Borrar Medico", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                a.btn.btn-danger.ms-4(href="/medicos" type="button", class="custom-button2" style="width: 50px; padding:5px;") 
                    img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")
