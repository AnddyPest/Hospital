extends ../templates/layout.pug

include ../templates/mixins.pug

block content
        
        
        
    div
        img(src="/images/enfermeras.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Borrar Enfermeros", "/icons/user-slash-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id="tablaEnfermeros")
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        tr.table-info
                            th.col(style="width: 10%") ID
                            th.col(style="width: 22.5%") Nombre
                            th.col(style="width: 22.5%") Apellido
                            th.col(style="width: 22.5%") Telefono
                            th.col(style="width: 22.5%") Area
                            th.col(style="width: 10%") Borrar
                    
                    tbody

    script.
        //carga de medicos en tabla
        async function cargarEnfermeros() {
            try {
                const response = await fetch("/enfermeros/listado");
                console.log(response);
                if(!response.ok) {
                    throw new Error("Error al obtener enfermero de la DB");
                }
                const enfermeros = await response.json();

                const tbody = document.querySelector("#tablaEnfermeros tbody");
                tbody.innerHTML = ""; //Limpia la tabla si se hizo una modificacion o busqueda.

                enfermeros.forEach((enfermero) => {
                    const fila = `
                        <tr>
                            <td>${enfermero.id}</td>
                            <td>${enfermero.nombre}</td>
                            <td>${enfermero.apellido}</td>
                            <td>${enfermero.telefono}</td>
                            <td>${enfermero.area}</td>
                            <td>
                                <button type="button" class="btn btn-danger" style="width: 100%; padding:5px;" onclick="borrarEnfermero(${enfermero.id}, '${enfermero.nombre}', '${enfermero.apellido}')">
                                    <img src="/icons/user-slash-solid.svg" alt="Borrar" style="width: 25px; height: 25px;">
                                </button>
                            </td>
                            
                        </tr>
                    `;
                    tbody.innerHTML += fila;
                });
            } catch (error) {
                console.error("Error al cargar los enfermeros:", error);
                alert("No se pudieron cargar los enfermeros.")
            }};

        cargarEnfermeros();

        async function borrarEnfermero(id, nombre, apellido) {
            const confirmacion = confirm(`¿Estás seguro de que deseas borrar al enfermero ${nombre} ${apellido}?`);
            if (!confirmacion) {
                return;
            }
            try {
                const response = await fetch(`/enfermeros/borrar/${id}`, {
                    method: "DELETE",
                });

                if (!response.ok) {
                    throw new Error("Error al borrar al enfermero");
                }

                alert(`Enfermero ID: ${id}, Nombre y Apellido: ${nombre} ${apellido} borrado con éxito`);
                location.reload(); // Recarga la página para actualizar la tabla
            } catch (error) {
                console.error("Error al borrar el enfermero:", error);
                alert("No se pudo borrar el enfermero");
            }
        }

        