extends ../templates/layout

include ../templates/mixins.pug
mixin atencionPaciente(turno)
    div.position-absolute.top-50.start-50.translate-middle.text-center(style="width: 90%;")
        div.card.bg-dark.text-light.border-danger.shadow.mt-5
            div.card-header.bg-danger.text-white
                h4 Triage de Urgencia - Asignación de Prioridad

            div.card-body
                form#atencionForm.ms-5()
                    div.row
                        //- columna de datos del paciente con labels inline
                        div.col-md-5.ms-1
                            div.row.mb-1
                                div.col.text-start
                                    div.mb-1
                                        label.fw-bold.me-2 Fecha:
                                        span.text-light #{turno ? turno.fecha : new Date().toLocaleDateString()}
                                
                                div.col.text-start
                                    div.mb-1
                                        if turno && turno.orden
                                            label.fw-bold.me-2 Orden N°:
                                            span.text-light.fw-bold #{turno.orden}
                                        else
                                            label.fw-bold.me-2 Hora:
                                            span.text-light #{turno && turno.hora ? turno.hora : new Date().toLocaleTimeString()}
                                div.row.mb-1
                                    div.col.text-start
                                        div.mb-1
                                            label.fw-bold.me-2 Hora de atención:
                                            span#horaAtencion.text-light #{new Date().toLocaleTimeString('es-ES', { hour12: false, hour: '2-digit', minute: '2-digit' })}
                            hr.border-danger.opacity-75.mt-1.mb-1
                            div.row.mb-1
                                div.col.mb-3.text-start
                                    label.fw-bold.me-2 Paciente:
                                    span.text-light #{turno.Paciente.nombre} #{turno.Paciente.apellido}
                                
                                div.col.mb-3.text-start
                                    label.fw-bold.me-2 DNI:
                                    span#dniPaciente.text-light #{turno.Paciente.dni}
                            hr.border-danger.opacity-75.mt-1.mb-1    
                            div.d-flex.align-items-center
                                div.mb-2
                                    label.fw-bold.me-2 Obra Social:
                                    span.text-light #{turno.Paciente.obra_social || "No registrada"}
                                div.input-group
                                    span.input-group-text.bg-dark.text-light N°:
                                    input#afiliado.form-control.bg-dark.text-light(
                                        type="text" 
                                        name="numeroAfiliado"
                                        placeholder="Ingrese número de afiliado" required)
                            hr.border-danger.opacity-75.mt-1.mb-1
                            div.row.mb-3
                                div.row-md-5
                                    label.form-label Observaciones:
                                    textarea#observaciones.form-control.bg-dark.text-light(rows="5"  name="observaciones")
                        
                        //- Selector de prioridad y datos del enfermero
                        div.col-md-6.mb-2
                            
                            // Selector de prioridad
                            div.mb-4
                                label.form-label.fw-bold Seleccione nivel de prioridad:
                                div.d-flex.justify-content-between.gap-2.mt-3
                                    button.btn.flex-grow-1.priority-toggle(
                                        type="button" 
                                        id="prioridad-alta" 
                                        data-value="alta" 
                                        style="border: 3px solid #dc3545; min-height: 80px")
                                        div.d-flex.flex-column.align-items-center.justify-content-center
                                            span.badge.bg-danger.mb-2 ALTA
                                            span.fw-bold Emergencia
                                            small Atención inmediata
                                        
                                    button.btn.flex-grow-1.priority-toggle(
                                        type="button" 
                                        id="prioridad-media" 
                                        data-value="media" 
                                        style="border: 3px solid #ffc107; min-height: 80px")
                                        div.d-flex.flex-column.align-items-center.justify-content-center
                                            span.badge.bg-warning.text-dark.mb-2 MEDIA
                                            span.fw-bold Urgencia
                                            small Atención < 1 hora
                                        
                                    button.btn.flex-grow-1.priority-toggle(
                                        type="button" 
                                        id="prioridad-baja" 
                                        data-value="baja" 
                                        style="border: 3px solid #198754; min-height: 80px")
                                        div.d-flex.flex-column.align-items-center.justify-content-center
                                            span.badge.bg-success.mb-2 BAJA
                                            span.fw-bold No urgente
                                            small Puede esperar

                            // Datos del enfermero
                            div.col.mt-4
                                if turno.Enfermero
                                    div.d-flex.align-items-center.mb-3
                                        div.me-3
                                            label.fw-bold.ms-2.me-2 Enfermero/a:
                                            span.text-light #{turno.Enfermero.nombre} #{turno.Enfermero.apellido}
                                            
                                        // Campo oculto para enviar el ID del enfermero
                                        input#enfermeroId(type="hidden" name="enfermeroId" value=turno.Enfermero.id)
                                else
                                    div.d-flex.align-items-center.mb-3
                                        label.fw-bold.me-2 Enfermero/a:
                                        span.text-light Sin enfermero asignado
                                        input#enfermeroId(type="hidden" name="enfermeroId" value="")
    
                            div.row.mt-4
                                div.col-12.d-flex.justify-content-between
                                    button#cleanForm.btn.btn-warning(onclick="event.preventDefault(); refreshPage();") 
                                        i.fas.fa-sync-alt.me-1
                                        | Limpiar                                                  
                                    button#saveForm.btn.btn-success(onclick="event.preventDefault(); guardarYDerivar();") 
                                        i.fas.fa-chevron-right.me-1
                                        | Derivar a Urgencias
                                    button#altaBtn.btn.btn-info(onclick="event.preventDefault(); darAlta();")
                                        i.fas.fa-check-circle.me-1
                                        | Dar Alta
                            
                            //- campos ocultos
                            input(type="hidden" name="turnoId" value=turno ? turno.id : '')
                            input#prioridad-seleccionada(type="hidden" name="prioridad" value="")
                            
                    hr.border-danger.opacity-75.mt-3.mb-3
                    div.d-flex.justify-content-between.mt-4
                        a#cancel.btn.btn-secondary.mt-2(href="/urgencias/admin") Volver a Urgencias

block content
    div
        img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen Urgencias" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +atencionPaciente(turno)
    
    script.
        document.addEventListener('DOMContentLoaded', function() {
            setupPriorityToggles();
        });
        
        const turno_Id = '#{turno ? turno.id : ''}';
        let triajeId;
        const dni = document.getElementById('dniPaciente').textContent;
        
        // limpia el formulario
        function refreshPage() {
            window.location.reload();
        }

        // Función compartida para validar los datos del formulario
        function validarFormulario() {
            const prioridadSeleccionada = document.getElementById('prioridad-seleccionada').value;
            const afiliado = document.getElementById('afiliado').value;
            const enfermeroId = document.getElementById('enfermeroId').value;
            
            let validacion = true;
            const mensajeError = [];

            if(!prioridadSeleccionada) {
                mensajeError.push('Debe seleccionar un nivel de prioridad.');
                validacion = false;
            }
            
            if(!afiliado) {
                mensajeError.push('El campo afiliado es obligatorio.');
                validacion = false;
            }
            
                       
            if(!validacion) {
                alert(mensajeError.join('\\n'));
                return false;
            }
            
            return {
                prioridadSeleccionada,
                observaciones: document.getElementById('observaciones').value,
                afiliado,
                enfermeroId,
                horaAtencion: document.getElementById('horaAtencion').textContent
            };
        }

        // Función para guardar la consulta y derivar al paciente
        async function guardarYDerivar() {
            // Validación específica para derivación
            const prioridad = document.getElementById('prioridad-seleccionada').value;
            const afiliado = document.getElementById('afiliado').value;
            const observaciones = document.getElementById('observaciones').value;
            const horaAtencion = document.getElementById('horaAtencion').textContent;
            const dni = document.getElementById('dniPaciente').textContent;
            const enfermeroId = document.getElementById('enfermeroId').value;
            
            let validacion = true;
            const mensajeError = [];

            if(!prioridad) {
                mensajeError.push('Debe seleccionar un nivel de prioridad.');
                validacion = false;
            }
            
            if(!afiliado) {
                mensajeError.push('El campo afiliado es obligatorio.');
                validacion = false;
            }
            
            if(!validacion) {
                alert(mensajeError.join('\\n'));
                return;
            }

            // Configurar datos para actualización de situación
            let situacion = 'urgencia';
            let datosActualizacionSituacion = {
                situacion: situacion
            };
            
            // Configurar datos para el formulario de consulta
            const datosFormulario = {
                observaciones: observaciones,
                afiliado: afiliado,
                matricula: enfermeroId, // Usando el ID del enfermero como matrícula
                turno_Id: turno_Id,
                prioridadAsignada: prioridad // Guardamos la prioridad en el modelo de atención
            };
            
            try {
                // Guardamos la hora de atención en el turno
                await actualizarHoraTurno(horaAtencion);
                
                // Guardamos la consulta con prioridad
                const responseConsulta = await fetch(`/atencion/guardarConsulta/${turno_Id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(datosFormulario)
                });
                
                if(responseConsulta.ok) {
                    const data = await responseConsulta.json();
                    if (data.success) {
                        const atencionId = data.atencionId;
                        console.log("ID DE ATENCION: ", atencionId);
                        
                        // Actualizar situación a urgencia
                        let responseSituacion = await fetch(`/atencion/actualizarSituacion/${turno_Id}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(datosActualizacionSituacion)
                        });
                        
                        if (responseSituacion.ok) {
                            // Redirigir a la página de turnos de urgencias
                            window.location.href = `/turnos/urgencias/paciente/${dni}/atencion/${atencionId}`;
                        } else {
                            alert('Error al actualizar la situación del paciente');
                        }
                    } else {
                        alert('Error al guardar la consulta: ' + (data.message || 'Error desconocido'));
                    }
                } else {
                    alert('Error en la respuesta del servidor');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al procesar la solicitud: ' + error.message);
            }
        }

        // Función para dar de alta al paciente
        async function darAlta() {
            // Validación específica para alta (sin requerir prioridad)
            const afiliado = document.getElementById('afiliado').value;
            const enfermeroId = document.getElementById('enfermeroId').value;
            const observaciones = document.getElementById('observaciones').value;
            const horaAtencion = document.getElementById('horaAtencion').textContent;
            // Obtenemos la prioridad si está seleccionada, o usamos "baja" por defecto para altas
            const prioridad = document.getElementById('prioridad-seleccionada').value || "baja";
            
            let validacion = true;
            const mensajeError = [];
            
            if(!afiliado) {
                mensajeError.push('El campo afiliado es obligatorio.');
                validacion = false;
            }
            
            if(!validacion) {
                alert(mensajeError.join('\\n'));
                return;
            }
            
            // Confirmar el alta
            if (!confirm("¿Está seguro de dar el alta al paciente?")) {
                return;
            }
            
            // Preparar datos para enviar
            const datosFormulario = {
                observaciones: observaciones,
                afiliado: afiliado,
                matricula: enfermeroId, // Usando el ID del enfermero como matrícula
                turno_Id: turno_Id,
                prioridadAsignada: prioridad // Guardamos la prioridad en el alta también
            };
            
            try {
                // Actualizar la hora en el turno
               await actualizarHoraTurno(horaAtencion);
                
                // Guardamos la consulta
                const response = await fetch(`/atencion/guardarConsulta/${turno_Id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(datosFormulario)
                });
                
                if(response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        // Actualizar estado a "alta"
                        let situacion = 'alta';
                        let datosActualizacionSituacion = {
                            situacion: situacion}
                        let responseSituacion = await fetch(`/atencion/actualizarSituacion/${turno_Id}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(datosActualizacionSituacion)
                        });
                        
                        // Feedback y redirección
                        alert("Paciente dado de alta correctamente");
                        window.location.href = '/urgencias/admin';
                    } else {
                        alert('Error al guardar la consulta: ' + (data.message || 'Error desconocido'));
                    }
                } else {
                    alert('Error en la respuesta del servidor');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al procesar la solicitud: ' + error.message);
            }
        }
        
        // Nueva función para actualizar la hora en el turno
        async function actualizarHoraTurno(horaAtencion) {
            try {
                const response = await fetch(`/turnos/atencion/actualizarHora/${turno_Id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ hora: horaAtencion })
                });
                
                if (!response.ok) {
                    console.error('Error al actualizar la hora de atención');
                }
                return true;
            } catch (error) {
                console.error('Error:', error);
                return false;
            }
        }

        // Función para manejar los toggles de prioridad
        function setupPriorityToggles() {
            const toggleButtons = document.querySelectorAll('.priority-toggle');
            const hiddenInput = document.getElementById('prioridad-seleccionada');
            
            toggleButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Desactivar todos los botones primero
                    toggleButtons.forEach(btn => {
                        btn.classList.remove('active', 'text-white');
                        btn.style.backgroundColor = '';
                    });
                    
                    // Activar el botón seleccionado
                    this.classList.add('active', 'text-white');
                    
                    // Aplicar estilo según la prioridad
                    if(this.dataset.value === 'alta') {
                        this.style.backgroundColor = '#dc3545';
                    } else if(this.dataset.value === 'media') {
                        this.style.backgroundColor = '#ffc107';
                    } else {
                        this
                        this.style.backgroundColor = '#198754';
                    }
                    
                    // Actualizar el campo oculto
                    hiddenInput.value = this.dataset.value;
                });
            });
        }

