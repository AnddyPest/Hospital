extends ../templates/layout.pug

include ../templates/mixins.pug

block content
    div
        img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh); object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Nuevo Triage de Urgencia", "/icons/triangle-exclamation-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rounded-3(style="width: 80%" id="formularioNewTriage")
            

            div.row.align-items-center.mb-5.mt-5
                div.col.w-25
                    div.input-group
                        input.form-control.form-control-lg(type="text" id="inputDNI" name="inputDNI" placeholder="Ingrese D.N.I." aria-label="DNI" aria-describedby="basic-addon1")
                        span.input-group-text(id="dniSpan" style="background-color: #0d6efd;")
                            img(src="/icons/user-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    // Área fija - no seleccionable
                    select.form-select.form-select-lg.h-100.bg-danger.text-white(disabled)
                        option(selected) Triage de Ingreso
                        
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectEnfermero" name="selectEnfermero")
                        option(selected disabled) Seleccione un Enfermero
                        each enfermero in enfermeros || []
                            option(value=enfermero.id) #{enfermero.nombre} #{enfermero.apellido}
            div.row.align-items-center.mb-5
                div.col.w-25
                    div.input-group.date(id="datepicker")
                        input.form-control.form-control-lg(type="text" id="inputFecha" placeholder="Seleccione una fecha" value=fechaActual disabled)
                        span.input-group-text
                            img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    // Mostrar número de orden en lugar de hora
                    div.input-group
                        input.form-control.form-control-lg.text-center.bg-light(type="text" readonly value=`Orden ${siguienteOrden}`)
                        span.input-group-text.bg-danger
                            img(src="/icons/clock-regular.svg" style="width: 20px; height: 20px; filter: invert(1);")
                div.col.w-25
                    select#motivo.form-select.form-select-lg.w-100.h-100(name="motivo")
                        option(selected disabled value="") Seleccione un Motivo
                        each mot in motivoTurno || []
                            option(value=mot.id) #{mot.nombre}
                        
            div.row.align-items-center.mt-5
                div.col.w-25
                    button.btn.w-50.btn-danger(class="custom-button2" id="botonNext" onclick="event.preventDefault(); aceptarDatos();") Registrar Triage
            div.row.align-items-center  
                div.col.w-25
                div.col.w-50
                    a.btn.w-75.btn-warning.mt-5(href="#" class="btn-secondary custom-button2" id="botonReiniciar" onclick="event.preventDefault(); location.reload();") Reiniciar Formulario
                div.col.w-25
            div.row.align-items-center   
                div.col.w-25
                div.col.w-50
                div.col.w-25
                    a.btn.w-50.btn-dark(href="/urgencias/admin" class="btn-secondary custom-button2" id="botonAtras") Atrás

    script.
        //variables globales y elementos del DOM
        const dni = document.getElementById("inputDNI");
        const dniSpan = document.getElementById("dniSpan");
        const selectEnfermero = document.getElementById("selectEnfermero");
        const datePicker = document.getElementById("inputFecha");
        const motivo = document.getElementById("motivo");
        const btnNext = document.getElementById("botonNext");
        const numeroOrden = #{siguienteOrden}; // Número de orden asignado desde el servidor
        
        let idPaciente = ""; 
        let idEnfermero = null; 
        let fechaTurno = "#{fechaActual}"; // La fecha actual ya viene del servidor
        let motivoTurno = ""; 

        // Inicializar datepicker con la fecha actual
        $(document).ready(function() {
            $('#datepicker input').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'es',
                startDate: new Date(),
            });
        });

        //este metodo chequea que el dni exista y lo fija en el input
        document.addEventListener("DOMContentLoaded", () => {
            // Variables para control de debounce
            let dniTimeout;
            let lastCheckedDni = "";
            
            dni.addEventListener("input", async () => {
                // Limita a solo números y máximo 8 dígitos
                dni.value = dni.value.replace(/[^0-9]/g, "").slice(0, 8);
                
                // Controlar estados visuales iniciales
                if (dni.value === "") {
                    clearTimeout(dniTimeout);
                    updateDniStatus("empty");
                    return;
                }
                
                if (dni.value.length < 7) {
                    clearTimeout(dniTimeout);
                    updateDniStatus("incomplete");
                    return;
                }
                
                // Evitar búsqueda duplicada del mismo DNI
                if (dni.value === lastCheckedDni) return;
                
                // Cambiar a estado "buscando"
                updateDniStatus("searching");
                
                // Implementar debounce para evitar muchas solicitudes seguidas
                clearTimeout(dniTimeout);
                dniTimeout = setTimeout(async () => {
                    lastCheckedDni = dni.value;
                    await checkPatientDni(dni.value);
                }, 500);
            });
            
            // Función para verificar DNI con el servidor
            async function checkPatientDni(dniValue) {
                try {
                    const response = await fetch(`/pacientes/listado/${dniValue}`);
                    
                    if (response.ok) {
                        // DNI existe, cambiar a verde y guardar ID
                        const paciente = await response.json();
                        idPaciente = paciente.id;
                        updateDniStatus("found", paciente.nombre + " " + paciente.apellido);
                        console.log("Paciente encontrado, ID:", idPaciente);
                    } else if (response.status === 404) {
                        // DNI no existe
                        idPaciente = "";
                        updateDniStatus("not-found");
                    } else {
                        // Otro tipo de error
                        throw new Error(`Error de servidor: ${response.status}`);
                    }
                } catch (error) {
                    console.error("Error al comprobar el DNI:", error);
                    updateDniStatus("error");
                }
            }
            
            // Función para actualizar el estado visual del DNI
            function updateDniStatus(status, patientName = "") {
                dniSpan.removeEventListener("click", redirectANuevoPaciente);
                dniSpan.style.cursor = "default"
                switch (status) {
                    case "empty":
                        dniSpan.style.backgroundColor = "#0d6efd"; // Azul
                        dniSpan.title = "Ingrese DNI del paciente";
                        break;
                    case "incomplete":
                        dniSpan.style.backgroundColor = "#ffc107"; // Amarillo
                        dniSpan.title = "DNI incompleto";
                        break;
                    case "searching":
                        dniSpan.style.backgroundColor = "#ffc107"; // Amarillo
                        dniSpan.title = "Buscando paciente...";
                        break;
                    case "found":
                        dniSpan.style.backgroundColor = "#28a745"; // Verde
                        dniSpan.title = `Paciente encontrado: ${patientName}`;
                        break;
                    case "not-found":
                        dniSpan.style.backgroundColor = "#dc3545"; // Rojo
                        dniSpan.title = "Paciente no encontrado. Haz clic para cargar sus datos";
                        dniSpan.style.cursor = "pointer";
                        dniSpan.addEventListener("click", redirectANuevoPaciente);
                        break;
                    case "error":
                        dniSpan.style.backgroundColor = "#ffc107"; // Amarillo
                        dniSpan.title = "Error al verificar DNI";
                        break;
                }
            }
        });

        // Evento para seleccionar enfermero
        document.addEventListener("DOMContentLoaded", () => {
            selectEnfermero.addEventListener("change", async () => {
                if(selectEnfermero.value) {
                    idEnfermero = selectEnfermero.value;
                    alert(`Enfermero seleccionado: ${selectEnfermero.options[selectEnfermero.selectedIndex].text}`);
                } else {
                    alert("Seleccione un enfermero");
                }
            }); 
        });

        // Evento para seleccionar motivo
        document.addEventListener("DOMContentLoaded", () => {
            motivo.addEventListener("change", async () => {
                const motivoSeleccionado = motivo.value;
                if (motivoSeleccionado) {
                    alert(`Motivo seleccionado: ${motivo.options[motivo.selectedIndex].text}`);
                    motivoTurno = motivo.value;
                } else {
                    alert("Seleccione un Motivo");
                }
            })
        });
        
        // Validar y enviar los datos
        async function aceptarDatos() {
            motivoTurno = motivo.value;
            
            if (!idPaciente || !idEnfermero || !fechaTurno || !motivoTurno) {
                alert("Complete todos los campos");
                return;
            }
            
            alert(`Datos del triage:\nPaciente: ${idPaciente}\nEnfermero: ${idEnfermero}\nFecha: ${fechaTurno}\nMotivo: ${motivoTurno}\nOrden: ${numeroOrden}`);
            enviarDatos();
        }

        async function enviarDatos() {
            const estado = "pendiente";
            
            try {
                // Formatear fecha para base de datos
                const partesFecha = fechaTurno.split("/");
                const fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`;
                
                console.log("Datos del triage enviados:", {
                    fecha: fechaFormateada,
                    motivo_Id: motivoTurno,
                    estado,
                    paciente_Id: idPaciente,
                    enfermero_Id: idEnfermero
                });
                
                const response = await fetch("/turnos/urgencias/triage/crear", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        fecha: fechaFormateada,
                        motivo_Id: motivoTurno,
                        estado,
                        paciente_Id: idPaciente,
                        enfermero_Id: idEnfermero
                    })
                });
                
                // Verificar si la respuesta es una redirección
                if (response.redirected) {
                    alert("Triage registrado con éxito");
                    window.location.href = response.url;
                    return;
                }
                
                const contentType = response.headers.get("content-type");
                if (!response.ok) {
                    const errorData = contentType && contentType.includes("application/json") 
                        ? await response.json() 
                        : await response.text();
                    throw new Error(errorData.message || errorData || "Error al registrar el triage");
                }
                
                alert("Triage registrado con éxito");
                window.location.href = "/urgencias/admin";
                
            } catch (error) {
                console.error("Error al enviar los datos:", error);
                alert(`Error: ${error.message || "No se pudo registrar el triage"}`);
            }
        }

        function redirectANuevoPaciente() {
            window.location.href = "/pacientes/admin/new";
        }



