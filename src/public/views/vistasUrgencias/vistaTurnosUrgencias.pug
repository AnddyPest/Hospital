extends ../templates/layout

include ../templates/mixins.pug

block content
    div.container-fluid.pt-3
        +header("Gestión de Urgencias", "/icons/triangle-exclamation-solid.svg")
        
        div.card.mb-4
            div.card-header.bg-danger.text-white
                div.row.align-items-center
                    div.col
                        h5.mb-0 Turnos de Urgencia
                    // Eliminado el botón de nueva urgencia
            
            div.card-body
                // Filtros
                div.row.mb-3
                    div.col-md-4
                        div.input-group
                            span.input-group-text Filtrar por médico
                            select.form-select#filtroMedico
                                option(value="") Todos los médicos
                                // Los médicos se cargarán dinámicamente
                    
                    div.col-md-3
                        div.input-group
                            span.input-group-text Prioridad
                            select.form-select#filtroPrioridad
                                option(value="") Todas
                                option(value="alta") Alta
                                option(value="media") Media
                                option(value="baja") Baja
                    
                    div.col-md-3
                        div.input-group
                            span.input-group-text Búsqueda
                            input.form-control#busquedaGeneral(type="text" placeholder="Buscar paciente...")
                    
                    div.col-md-2
                        button.btn.btn-outline-secondary.w-100#resetFiltros
                            i.fas.fa-sync-alt.me-1
                            | Restablecer
                
                // Tabla de urgencias
                div.table-responsive
                    table.table.table-striped.table-hover#tablaTurnos
                        thead
                            tr
                                th Orden
                                th Paciente
                                th DNI
                                th Médico
                                th Prioridad
                                th Estado
                                th Acciones
                        tbody
                            if turnos && turnos.length > 0
                                each turno in turnos
                                    tr(data-medico=(turno.Medico ? turno.Medico.apellido : "") || "", data-prioridad=turno.prioridad || "media")
                                        td= turno.ordenUrgencia || "U-" + turno.orden
                                        td= turno.Paciente ? turno.Paciente.nombre + " " + turno.Paciente.apellido : "Sin asignar"
                                        td= turno.Paciente ? turno.Paciente.dni : ""
                                        td= turno.Medico ? turno.Medico.nombre + " " + turno.Medico.apellido : "Sin asignar" 
                                        td
                                            - var prioridadClase = "bg-warning text-dark"
                                            if turno.prioridad === "alta"
                                                - prioridadClase = "bg-danger text-white"
                                            else if turno.prioridad === "baja"
                                                - prioridadClase = "bg-success text-white"
                                            span.badge.rounded-pill(class=prioridadClase)= (turno.prioridad || "media").toUpperCase()
                                        td
                                            if turno.estado === "Atendido"
                                                span.badge.bg-success Atendido
                                            else if turno.estado === "En atención"
                                                span.badge.bg-primary En atención
                                            else if turno.estado === "Ausente"
                                                span.badge.bg-secondary.text-white Ausente
                                            else
                                                span.badge.bg-secondary Pendiente
                                        td.text-nowrap
                                            // Simplificado a solo dos botones: Atender y Ausente
                                            if turno.estado !== "Atendido" && turno.estado !== "Ausente"
                                                a.btn.btn-sm.btn-primary.me-1(href=`/atencion/paciente/turno/${turno.id}` title="Atender")
                                                    i.fas.fa-user-md
                                                button.btn.btn-sm.btn-warning(onclick=`marcarAusente(${turno.id})` title="Marcar Ausente")
                                                    i.fas.fa-user-slash
                            else
                                tr
                                    td.text-center(colspan="7") No hay turnos de urgencia registrados
        
        // Modal de confirmación para marcar ausente
        div#modalSimple.position-fixed.top-0.start-0.w-100.h-100.d-none(style="background-color: rgba(0,0,0,0.5); z-index: 2000;")
            div.position-absolute.top-50.start-50.translate-middle.bg-white.p-4.rounded.shadow(style="min-width: 300px; z-index: 2001;")
                h5.mb-3 Confirmar paciente ausente
                p ¿Confirma que el paciente no se ha presentado a la consulta de urgencia?
                div.d-flex.justify-content-end.mt-3.gap-2
                    button.btn.btn-secondary#btnCancelarSimple Cancelar
                    button.btn.btn-warning#btnConfirmarSimple Confirmar ausente
    
    style.
        /* Fix for modal appearing behind backdrop */
        .modal {
            z-index: 1050 !important;
        }
        .modal-backdrop {
            z-index: 1040 !important;
        }
        .modal-dialog {
            z-index: 1051 !important;
            margin-top: 20vh;
        }
        /* Make buttons more clickable */
        .modal-footer .btn {
            position: relative;
            z-index: 1052 !important;
            pointer-events: auto !important;
        }
        /* Ensure modals are visible */
        .modal.show {
            display: block !important;
        }
    
    script.
        // Variables globales
        let turnoSeleccionadoId = null;
        
        // Función para mostrar el modal simple
        function marcarAusente(id) {
            console.log("Marcando ausente turno ID:", id);
            turnoSeleccionadoId = id;
            
            // Mostrar el modal simple
            document.getElementById('modalSimple').classList.remove('d-none');
        }
        
        // Cuando el DOM esté cargado
        document.addEventListener('DOMContentLoaded', function() {
            console.log("DOM cargado, configurando eventos");
            
            // Configurar botones del modal simple
            document.getElementById('btnCancelarSimple').addEventListener('click', function() {
                document.getElementById('modalSimple').classList.add('d-none');
            });
            
            document.getElementById('btnConfirmarSimple').addEventListener('click', function() {
                if (turnoSeleccionadoId) {
                    confirmarAusencia(turnoSeleccionadoId);
                }
            });
            
            // Configurar filtros
            setupFiltros();
        });
        
        // Manejar la confirmación de ausencia
        async function confirmarAusencia(id) {
            try {
                console.log("Confirmando ausencia para turno:", id);
                
                // Modificado para usar el endpoint de edición con método PUT
                const response = await fetch(`/turnos/editar/${id}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        estado: "Ausente"
                    })
                });
                
                // Ocultar modal simple
                document.getElementById('modalSimple').classList.add('d-none');
                
                if (response.ok) {
                    mostrarAlerta('success', 'Paciente marcado como ausente correctamente');
                    
                    // Recargar después de un momento
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    throw new Error("Error del servidor: " + response.status);
                }
            } catch (error) {
                console.error("Error:", error);
                mostrarAlerta('danger', 'No se pudo marcar al paciente como ausente');
            }
        }
        
        // Mostrar alertas
        function mostrarAlerta(tipo, mensaje) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${tipo} alert-dismissible fade show`;
            alertDiv.setAttribute('role', 'alert');
            alertDiv.innerHTML = `
                <strong>${tipo === 'success' ? '¡Éxito!' : 'Error:'}</strong> ${mensaje}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            
            const tablaContainer = document.querySelector('.table-responsive');
            tablaContainer.parentNode.insertBefore(alertDiv, tablaContainer);
        }
        
        // Función para configurar filtros
        function setupFiltros() {
            // Cargar médicos
            const medicos = new Set();
            document.querySelectorAll('#tablaTurnos tbody tr').forEach(row => {
                const medicoNombre = row.getAttribute('data-medico');
                if (medicoNombre) medicos.add(medicoNombre);
            });
            
            // Poblar selector de médicos
            const filtroMedico = document.getElementById('filtroMedico');
            medicos.forEach(medico => {
                if (medico) {
                    const option = document.createElement('option');
                    option.value = medico;
                    option.textContent = medico;
                    filtroMedico.appendChild(option);
                }
            });
            
            // Función de filtrado
            function aplicarFiltros() {
                const valorMedico = filtroMedico.value.toLowerCase();
                const valorPrioridad = document.getElementById('filtroPrioridad').value.toLowerCase();
                const valorBusqueda = document.getElementById('busquedaGeneral').value.toLowerCase();
                
                document.querySelectorAll('#tablaTurnos tbody tr').forEach(row => {
                    const medico = (row.getAttribute('data-medico') || "").toLowerCase();
                    const prioridad = (row.getAttribute('data-prioridad') || "").toLowerCase();
                    const textoFila = row.textContent.toLowerCase();
                    
                    const coincideMedico = !valorMedico || medico.includes(valorMedico);
                    const coincidePrioridad = !valorPrioridad || prioridad === valorPrioridad;
                    const coincideBusqueda = !valorBusqueda || textoFila.includes(valorBusqueda);
                    
                    row.style.display = (coincideMedico && coincidePrioridad && coincideBusqueda) ? '' : 'none';
                });
            }
            
            // Eventos de filtrado
            filtroMedico.addEventListener('change', aplicarFiltros);
            document.getElementById('filtroPrioridad').addEventListener('change', aplicarFiltros);
            document.getElementById('busquedaGeneral').addEventListener('input', aplicarFiltros);
            
            // Reset filtros
            document.getElementById('resetFiltros').addEventListener('click', function() {
                filtroMedico.value = '';
                document.getElementById('filtroPrioridad').value = '';
                document.getElementById('busquedaGeneral').value = '';
                aplicarFiltros();
            });
        }

