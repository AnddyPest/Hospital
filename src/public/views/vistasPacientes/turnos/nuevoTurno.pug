extends ../../templates/layout.pug

include ../../templates/mixins.pug

        
block content

    div
        img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Nuevo Turno", "/icons/user-plus-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%" id=`formularioNewTurn`)
            div.row.align-items-center.mb-4
                div.col.w-25
                    input.form-control.form-control-lg.w-100(type="text" id="inputDNI" name="inputDNI" placeholder="Ingrese D.N.I." aria-label="DNI" aria-describedby="basic-addon1")
                div.col.w-25
                    button.btn.w-75.btn-info(id="dniLock" onclick="event.preventDefault(); fijarDni();", class="custom-button2") Chequear D.N.I.
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectEsp" name="selectEsp" aria-label=".form-select-lg example")
                        option.selected Seleccione un Area
                        option.value Triage de Ingreso
                div.col.w-25
                    button.btn.w-75.btn-info(id="espLock" onclick="event.preventDefault(); fijarTipo();" type="submit" class="custom-button2") Seleccionar Area
            div.row.align-items-center.mb-4
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectMedico" name="selectMedico" aria-label=".form-select-lg example")
                        option.selected Seleccione un Medico
                div.col.w-25
                    button.btn.w-75.btn-info(id="medicoLock" onclick="event.preventDefault(); aceptarMedico();" class="custom-button2") Seleccionar Medico
                div.col.w-25
                    div.input-group.date(id="datepicker")
                        input.form-control.form-control-lg(type="text" id="inputFecha" placeholder="Seleccione una fecha")
                        span.input-group-text
                            img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    button.btn.w-75.btn-info(id="dateLock" onclick="event.preventDefault(); aceptarFecha();" class="custom-button2") Seleccionar Fecha
                    
            div.row.align-items-center
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="hourpicker", name="hourpicker")
                        option.selected(value="Seleccione un horario") Seleccione un horario 
                div.col.w-25
                    button.btn.w-75.btn-info(id="hourLock" onclick="event.preventDefault(); aceptarHorario();" class="custom-button2") Seleccionar Horario
                div.col.w-25
                    input.form-control.form-control-lg.w-100(type="text" id="motivo" name="codigo" placeholder="Motivo" aria-label="ID Turno" aria-describedby="basic-addon1")
                div.col.w-25
                    button.btn.w-75.btn-info(class="btn-secondary custom-button2" id="botonNext" onclick="event.preventDefault(); enviarDatos();") Aceptar Datos
               
            
               
            

                
    script.
        //aca cargamos las especialidades en el select, sin repetir
        document.addEventListener("DOMContentLoaded", async () => {
            const selectTurno = document.getElementById("selectEsp");
            try {
                const response = await fetch("/medicos/especialidades");
                if (!response.ok) {
                    throw new Error("Error al obtener las especialidades");
                }
                const especialidades = await response.json();
                especialidades.forEach(especialidad => {
                    const option = document.createElement("option");
                    option.value = especialidad;
                    option.textContent = especialidad;
                    selectTurno.appendChild(option); 
                });
            } catch (error) {
                console.error("Error al cargar las especialidades:", error);
            }});
            //aca cargamos las fechas en el datepicker
        $(document).ready(function() {
            $('#datepicker input').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'es',
                startDate: new Date(),

            });
        });
        //aca generemos los horarios en el hourpicker
       /** document.addEventListener("DOMContentLoaded", () =>{
            const hourpicker = document.getElementById("hourpicker");
            const startTime = new Date();
            startTime.setHours(8, 0, 0); // entrada 8
            const endTime = new Date();
