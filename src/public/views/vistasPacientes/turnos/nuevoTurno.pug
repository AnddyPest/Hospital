extends ../../templates/layout.pug

include ../../templates/mixins.pug

        
block content

    div
        img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Nuevo Turno", "/icons/user-plus-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%" id=`formularioNewTurn`)
            div.row.align-items-center.mb-4
                div.col.w-25
                    input.form-control.form-control-lg.w-100(type="text" id="inputDNI" name="inputDNI" placeholder="Ingrese D.N.I." aria-label="DNI" aria-describedby="basic-addon1")
                div.col.w-25
                    button.btn.w-75.btn-info(id="dniLock" onclick="event.preventDefault(); fijarDni();", class="custom-button2") Chequear D.N.I.
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectEsp" name="selectEsp" aria-label=".form-select-lg example")
                        option.selected Seleccione un Area
                        option.value Triage de Ingreso
                div.col.w-25
                    button.btn.w-75.btn-info(id="espLock" onclick="event.preventDefault(); fijarTipo();" type="submit" class="custom-button2") Seleccionar Area
            div.row.align-items-center.mb-4
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectMedico" name="selectMedico" aria-label=".form-select-lg example")
                        option.selected Seleccione un Profesional
                div.col.w-25
                    button.btn.w-75.btn-info(id="medicoLock" onclick="event.preventDefault(); aceptarMedico();" class="custom-button2") Seleccionar Medico
                div.col.w-25
                    div.input-group.date(id="datepicker")
                        input.form-control.form-control-lg(type="text" id="inputFecha" placeholder="Seleccione una fecha")
                        span.input-group-text
                            img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    button.btn.w-75.btn-info(id="dateLock" onclick="event.preventDefault(); aceptarFecha();" class="custom-button2") Seleccionar Fecha
                    
            div.row.align-items-center
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="hourpicker", name="hourpicker")
                        option.selected(value="Seleccione un horario") Seleccione un horario 
                div.col.w-25
                    button.btn.w-75.btn-info(id="hourLock" onclick="event.preventDefault(); aceptarHorario();" class="custom-button2") Seleccionar Horario
                div.col.w-25
                    input.form-control.form-control-lg.w-100(type="text" id="motivo" name="codigo" placeholder="Motivo" aria-label="ID Turno" aria-describedby="basic-addon1")
                div.col.w-25
                    button.btn.w-75.btn-info(class="btn-secondary custom-button2" id="botonNext" onclick="event.preventDefault(); aceptarDatos();") Aceptar Datos
               
            
               
            

                
    script.
        //aca cargamos las especialidades en el select, sin repetir
        document.addEventListener("DOMContentLoaded", async () => {
            const selectTurno = document.getElementById("selectEsp");
            try {
                const response = await fetch("/medicos/especialidades");
                if (!response.ok) {
                    throw new Error("Error al obtener las especialidades");
                }
                const especialidades = await response.json();
                especialidades.forEach(especialidad => {
                    const option = document.createElement("option");
                    option.value = especialidad;
                    option.textContent = especialidad;
                    selectTurno.appendChild(option); 
                });
            } catch (error) {
                console.error("Error al cargar las especialidades:", error);
            }});
            //aca cargamos las fechas en el datepicker
        $(document).ready(function() {
            $('#datepicker input').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'es',
                startDate: new Date(),

            });
        });
        

        //variables globales y elementos del DOM
        const dni = document.getElementById("inputDNI");//ok
        const dniLock = document.getElementById("dniLock");//ok
        const selectEsp = document.getElementById("selectEsp");//ok
        const espLock = document.getElementById("espLock");//ok
        const selectMedico = document.getElementById("selectMedico");//ok
        const medicoLock = document.getElementById("medicoLock");//ok
        const dateLock = document.getElementById("datepicker");//ok
        const botonNext = document.getElementById("botonNext");//ok
        const hourpicker = document.getElementById("hourpicker");//ok
        const hourLock  = document.getElementById("hourLock");//ok
        const motivo = document.getElementById("motivo");//ok
        const btnNext = document.getElementById("botonNext");//ok
        let idPaciente= ""; 
        let idMedico= null; 
        let idEnfermero= null;
        let fechaTurno = ""; 
        let horaTurno = ""; 
        let motivoTurno = ""; 
        
        //este metodo chequea que el dni exista y lo fija en el input
        //luego habria que cambiar todas las alert por modals
        async function fijarDni() {
                try {
                    const dniValue = dni.value;
                    const response = await fetch(`/pacientes/listado/${dniValue}`);
                    if (!response.ok) {
                        if(response.status === 404) {
                            alert ("Paciente no encontrado");
                            dni.value = "";
                            dni.placeholder = "Ingrese D.N.I.";
                        }else{
                        throw new Error("Error al obtener los datos del paciente");
                        }
                    }
                    const paciente = await response.json();
                    if (paciente) {
                        idPaciente = paciente.id;
                        console.log(idPaciente);
                        
                        alert (`Paciente encontrado: ${paciente.nombre} ${paciente.apellido}`);
                    } else {
                        alert("Paciente no encontrado");
                    }
                }catch (error) {
                    console.error("Error al cargar los datos del paciente:", error);
                }
        };
        //metodo para fijar el area del turno
        async function fijarTipo() {
            if(selectEsp.value === "Seleccione un Area") {
                alert("Seleccione un Area");
            }
            if (selectEsp.value === "Triage de Ingreso") {
                const area = selectEsp.value;
                const response = await fetch(`/enfermeros/areas/${area}`)
                if (!response.ok) {
                    throw new Error("Error al obtener los enfermeros");
                }
                const enfermeros = await response.json();
                console.log(enfermeros);
                selectMedico.innerHTML = "";
                enfermeros.forEach(enfermero => {
                    const option = document.createElement("option");
                    option.value = enfermero.id;
                    option.textContent = `${enfermero.id} - ${enfermero.nombre} ${enfermero.apellido}`;
                    selectMedico.appendChild(option);
                });

            }else{
                try {
                    const especialidad = selectEsp.value;
                    const response = await fetch(`/medicos/especialidades/${especialidad}`);
                    if (!response.ok) {
                        throw new Error("Error al obtener los medicos");
                    }
                    const medicos = await response.json();
                    console.log(medicos);
                    
                    selectMedico.innerHTML = ""; // Limpiar opciones anteriores
                    medicos.forEach(medico => {
                        const option = document.createElement("option");
                        option.value = medico.id;
                        option.textContent = `${medico.id} - ${medico.nombre} ${medico.apellido}`;
                        selectMedico.appendChild(option); // Aquí usamos 'option' correctamente
                    });
                }catch (error) {
                    console.error("Error al cargar los medicos:", error);
                }
            };
        };    
         //metodo para fijar el medico del turno y guardar su id
        async function aceptarMedico() {
            if(selectMedico.value === "Seleccione un Profesional") {
                alert("Seleccione un Profesional");
            }else if (selectEsp.value === "Triage de Ingreso") {
                idEnfermero = selectMedico.value;
                console.log(idEnfermero);
                alert(`Enfermero seleccionado: ${selectMedico.options[selectMedico.selectedIndex].text}`);
            }else{
                idMedico = selectMedico.value;
                console.log(idMedico);
                alert(`Medico seleccionado: ${selectMedico.options[selectMedico.selectedIndex].text}`);
            };  
        };

        async function aceptarFecha() {
            const fecha = document.getElementById("inputFecha").value;
            if (fecha === "") {
                alert("Seleccione una fecha");
            }   
            if (selectEsp.value === "Triage de Ingreso") {
                alert (`Fecha seleccionada: ${fecha}`);
                fechaTurno = fecha;
                // Convertir la fecha al formato YYYY-MM-DD
                const partesFecha = fecha.split("/");
                const fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`;
                
                console.log("fecha en el front "+fechaFormateada);
                
                console.log(idEnfermero);

                const response = await fetch(`/turnos/listadohorariosenfermeros/${idEnfermero}/${fechaFormateada}`);
                if(!response.ok) {
                    throw new Error("Error al obtener los horarios disponibles");
                }
                const horarios = await response.json();
                console.log("ARRAY DE HORARIOS: "+horarios);
                hourpicker.innerHTML = "";
                const startTime = new Date();
                startTime.setHours(8, 0, 0); // entrada 8
                const endTime = new Date();
                endTime.setHours(16, 0, 0); // salida 16
                let currentTime = new Date(startTime);
                while (currentTime <= endTime) {
                    const option = document.createElement("option");
                    option.value = currentTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    option.textContent = currentTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    hourpicker.appendChild(option);
                    currentTime.setMinutes(currentTime.getMinutes() + 15); //los turnos son cada 40 minutos
                };
                horarios.forEach(horario => {
                    const horaOcupada = horario.hora.split(":")[0] + ":" + horario.hora.split(":")[1];
                    const option = document.createElement("option");
                    option.value = horaOcupada;
                    option.textContent = horaOcupada;
                    //buscamos la opcion en el select y la quitamos
                    const optionSelect = hourpicker.querySelector(`option[value="${horaOcupada}"]`);
                    if (optionSelect) {
                        hourpicker.removeChild(optionSelect);
                    }
                });
            } else {
                alert(`Fecha seleccionada: ${fecha}`);
                fechaTurno = fecha;
                // Convertir la fecha al formato YYYY-MM-DD
                const partesFecha = fecha.split("/");
                const fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`;
                
                console.log("fecha en el front "+fechaFormateada);
                
                console.log(idMedico);
                //ahora cargamos el hourpicker con los horarios disponibles
                const response = await fetch (`/turnos/listadohorarios/${idMedico}/${fechaFormateada}`);
                if (!response.ok) {
                    throw new Error("Error al obtener los horarios disponibles");
                }
                //si la respuesta es correcta, cargamos los horarios en el selectctamente
                const horarios = await response.json();
                console.log(horarios);
                //limpiamos el select de horarios
                hourpicker.innerHTML = "";
                //cargamos los horarios libres en el select y lugo quitamos los horarios ocupados
                //los horarios disponibles son los que no tienen un id de turno
                //entonces en el select cargamos todos los horarios y luego quitamos los ocupados
                const startTime = new Date();
                startTime.setHours(8, 0, 0); // entrada 8
                const endTime = new Date();
                endTime.setHours(16, 0, 0); // salida 16
                let currentTime = new Date(startTime);
                while (currentTime <= endTime) {
                    const option = document.createElement("option");
                    option.value = currentTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    option.textContent = currentTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    hourpicker.appendChild(option);
                    currentTime.setMinutes(currentTime.getMinutes() + 40); //los turnos son cada 40 minutos
                
                };
                //ahora quitamos los horarios ocupados quitando los segundos del recibido de la bd
                horarios.forEach(horario => {
                    const horaOcupada = horario.hora.split(":")[0] + ":" + horario.hora.split(":")[1];
                    const option = document.createElement("option");
                    option.value = horaOcupada;
                    option.textContent = horaOcupada;
                    //buscamos la opcion en el select y la quitamos
                    const optionSelect = hourpicker.querySelector(`option[value="${horaOcupada}"]`);
                    if (optionSelect) {
                        hourpicker.removeChild(optionSelect);
                    }
                });
            };
        };


            
        
        async function aceptarHorario() {
            const hora = hourpicker.value;
            if (hora === "Seleccione un horario") {
                alert("Seleccione un horario");
            } else {
                alert(`Horario seleccionado: ${hora}`);
                horaTurno = hora;
            }
        };

        async function aceptarDatos() {
            
            motivoTurno = motivo.value;
            if (motivoTurno === "") {
                alert("Ingrese un motivo");
            } else {
                alert(`Motivo seleccionado: ${motivoTurno}`);
            }
            if (idPaciente === "" || idMedico === "" || fechaTurno === "" || horaTurno === "" || motivoTurno === "") {
                alert("Complete todos los campos");
            } else {
                alert(`Datos seleccionados: ${idPaciente} ${idMedico} ${fechaTurno} ${horaTurno} ${motivoTurno}`);
                //aca llamamos al metodo para enviar los datos al servidor
                enviarDatos();
            }
        };

        async function enviarDatos() {
            
            const estado = "pendiente";

            
            // damos formato a la fecha para que sea YYYY-MM-DD
            const partesFecha = fechaTurno.split("/");
            const fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`;
            const horaFormateada = `${horaTurno}:00`;
            
             console.log("Datos Enviados: ",{
                fechaFormateada,
                horaFormateada,
                motivoTurno,
                estado,
                idPaciente,
                idMedico,
                idEnfermero,
            });
            try {
                const response = await fetch("/turnos/admin/new", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        estado: estado,
                        fecha: fechaFormateada,
                        hora: horaFormateada,
                        motivo: motivoTurno,
                        paciente_Id: idPaciente,
                        medico_Id: idMedico,
                        enfermero_Id: idEnfermero,
                    })
                });
                if (!response.ok) {
                    throw new Error("Error al enviar los datos del turno");
                }
                const data = await response.json();
                console.log(data);
                alert("Turno creado con exito");
                window.location.href = "/turnos/listado";
            } catch (error) {
                console.error("Error al enviar los datos:", error);
            }
        };

       
                        
       