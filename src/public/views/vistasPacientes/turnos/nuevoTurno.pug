extends ../../templates/layout.pug

include ../../templates/mixins.pug

        
block content

    div
        img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Nuevo Turno", "/icons/user-plus-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%" id=`formularioNewTurn`)
            div.row.align-items-center.mb-4
                div.col.w-25
                    input.form-control.form-control-lg.w-100(type="text" id="inputDNI" name="inputDNI" placeholder="Ingrese su DNI" aria-label="DNI" aria-describedby="basic-addon1")
                div.col.w-25
                    button.btn.w-75.btn-info(id="dniLock" onclick="event.preventDefault(); fijarDni();", class="custom-button2") Seleccionar DNI
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectTurno" name="selectTurno" aria-label=".form-select-lg example")
                        option.selected Seleccione un Area
                        option.value Triage de Ingreso
                div.col.w-25
                    button.btn.w-75.btn-info(id="typeLock" onclick="event.preventDefault(); fijarTipo();" type="submit" class="custom-button2") Seleccionar Area
            div.row.align-items-center
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectMedico" name="selectMedico" aria-label=".form-select-lg example")
                        option.selected Seleccione un Medico
                div.col.w-25
                    button.btn.w-75.btn-info(id="acceptBtn" onclick="event.preventDefault(); aceptarMedico();" class="custom-button2") Seleccionar Medico
                div.col.w-25
                    div.input-group.date(id="datepicker")
                        input.form-control.form-control-lg(type="text" id="inputFecha" placeholder="Seleccione una fecha")
                        span.input-group-text
                            img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    button.btn.w-75.btn-info(id="acceptBtn" onclick="event.preventDefault(); aceptarDatos();" class="custom-button2") Seleccionar Fecha
                    
            div.row.align-items-center
                div.col.w-25
                    h3 aca va el selector de horario
                div.col.w-25
                    h3 aca va el boton de select time
                div.col.w-25
                    h3 aca va el cuadrito con el codigo del turno
                div.col.w-25
                    button.btn.w-75(class="btn-secondary custom-button2" id="botonNext" onclick="event.preventDefault(); enviarDatos();" disabled) Siguiente
            div.row.justify-content-center.align-items-center.mt-3.mb-2s
                h1 Paso 1 de 3   
            
               
            

                
    script.
        document.addEventListener("DOMContentLoaded", async () => {
            const selectTurno = document.getElementById("selectTurno");
            try {
                const response = await fetch("/medicos/especialidades");
                if (!response.ok) {
                    throw new Error("Error al obtener las especialidades");
                }
                const especialidades = await response.json();
                especialidades.forEach(especialidad => {
                    const option = document.createElement("option");
                    option.value = especialidad;
                    option.textContent = especialidad;
                    selectTurno.appendChild(option); // Aquí usamos 'option' correctamente
                });
            } catch (error) {
                console.error("Error al cargar las especialidades:", error);
            }
            
        });
        $(document).ready(function() {
            $('#datepicker input').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'es',
                startDate: new Date(),

            });
        });
        const dni = document.getElementById("inputDNI");
        const selectTurno = document.getElementById("selectTurno");
        const dniLock = document.getElementById("dniLock");
        const typeLock = document.getElementById("typeLock");
        const inputId = document.getElementById("inputId");
        const inputNombre = document.getElementById("inputNombre");
        const inputApellido = document.getElementById("inputApellido");
        const botonNext = document.getElementById("botonNext");
        const acceptBtn = document.getElementById("acceptBtn");
        
        
        async function fijarDni() {
                try {
                    const dniValue = dni.value;
                    const response = await fetch(`/pacientes/listado/${dniValue}`);
                    if (!response.ok) {
                        throw new Error("Error al obtener los datos del paciente");
                    }
                    const paciente = await response.json();
                    if (paciente) {
                        dni.setAttribute("disabled", true);
                        dni.setAttribute("readonly", true);
                        dniLock.setAttribute("disabled", true);
                        selectTurno.removeAttribute("disabled");
                        typeLock.removeAttribute("disabled");
                    } else {
                        alert("Paciente no encontrado");
                    }
                }catch (error) {
                    console.error("Error al cargar los datos del paciente:", error);
                }
        };
        async function fijarTipo() {
            if(selectTurno.value != "Seleccione un Area") {
            selectTurno.setAttribute("disabled", true);
            typeLock.setAttribute("disabled", true);
            acceptBtn.removeAttribute("disabled");
            }else {
                alert("Seleccione un Area");
            }
            try {
                const especialidad = selectTurno.value;
                const response = await fetch(`/medicos/especialidades/${especialidad}`);
                if (!response.ok) {
                    throw new Error("Error al obtener los medicos");
                }
                const medicos = await response.json();
                console.log(medicos);
                const selectMedico = document.getElementById("selectMedico");
                selectMedico.innerHTML = ""; // Limpiar opciones anteriores
                medicos.forEach(medico => {
                    const option = document.createElement("option");
                    option.value = medico.id;
                    option.textContent = `${medico.nombre} ${medico.apellido}`;
                    selectMedico.appendChild(option); // Aquí usamos 'option' correctamente
                });
            }catch (error) {
                console.error("Error al cargar los medicos:", error);
            }
        };
       
                        
       