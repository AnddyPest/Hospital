extends ../templates/layout.pug

include ../templates/mixins.pug

        
block content

    div
        img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Nuevo Turno", "/icons/user-plus-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%" id=`formularioNewTurn`)
            div.row.align-items-center.mb-5.mt-5
                div.col.w-25
                    div.input-group
                        input.form-control.form-control-lg(type="text" id="inputDNI" name="inputDNI" placeholder="Ingrese D.N.I." aria-label="DNI" aria-describedby="basic-addon1")
                        span.input-group-text(id="dniSpan" style="background-color: #0d6efd;")
                            img(src="/icons/user-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    select.form-select.form-select-lg.h-100(id="selectEsp" name="selectEsp" aria-label=".form-select-lg example")
                        option.selected Seleccione un Area
                        
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectMedico" name="selectMedico" aria-label=".form-select-lg example")
                        option.selected Seleccione un Profesional
            div.row.align-items-center.mb-5
                div.col.w-25
                    div.input-group.date(id="datepicker")
                        input.form-control.form-control-lg(type="text" id="inputFecha" placeholder="Seleccione una fecha")
                        span.input-group-text
                            img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="hourpicker", name="hourpicker")
                        option.selected(value="Seleccione un horario") Seleccione un Horario 
                div.col.w-25
                    select#motivo.form-select.form-select-lg.w-100.h-100(name="motivo")
                        option.selected(value="Seleccione un Motivo") Seleccione un Motivo                  
            div.row.align-items-center.mt-5
                div.col.w-25
                    button.btn.w-50.btn-info(class="btn-secondary custom-button2" id="botonNext" onclick="event.preventDefault(); aceptarDatos();") Aceptar Datos
            div.row.align-items-center  
                div.col.w-25
                div.col.w-50
                    a.btn.w-75.btn-warning.mt-5(href="#" class="btn-secondary custom-button2" id="botonAtras" onclick="event.preventDefault(); location.reload();") Reiniciar Formulario
                div.col.w-25
            div.row.align-items-center   
                div.col.w-25
                div.col.w-50
                div.col.w-25
                    a.btn.w-50.btn-danger(href="/turnos/admin" class="btn-secondary custom-button2" id="botonAtras") Atras

                
    script.
        //variables globales y elementos del DOM
        const dni = document.getElementById("inputDNI");//ok
        const dniSpan = document.getElementById("dniSpan");//ok
        const selectEsp = document.getElementById("selectEsp");//ok
        const selectMedico = document.getElementById("selectMedico");//ok
        const datePicker = document.getElementById("inputFecha");//ok
        const hourpicker = document.getElementById("hourpicker");//ok
        const motivo = document.getElementById("motivo");//ok
        const btnNext = document.getElementById("botonNext");//ok
        let idPaciente= ""; 
        let idMedico= null; 
        let fechaTurno = ""; 
        let horaTurno = ""; 
        let motivoTurno = ""; 

        // Variables para almacenar en caché los profesionales
        let cachedMedicos = {}; // Objeto para almacenar médicos por especialidad

        // Método mejorado para fijar el área del turno
        async function fijarTipo() {
            try {
                // Limpiar y mostrar estado de carga
                selectMedico.innerHTML = "";
                const loadingOption = document.createElement("option");
                loadingOption.textContent = "Cargando médicos...";
                loadingOption.disabled = true;
                loadingOption.selected = true;
                selectMedico.appendChild(loadingOption);
                
                const selectedValue = selectEsp.value;
                
                // Eliminar la verificación para área y solo dejar especialidad
                const especialidadId = selectedValue.replace("esp_", "");
                
                // Verificar si ya tenemos los médicos de esta especialidad en caché
                if (cachedMedicos[especialidadId]) {
                    poblarSelectorProfesionales(cachedMedicos[especialidadId]);
                } else {
                    try {
                        // Usar ID de especialidad en lugar del nombre
                        const response = await fetch(`/medicos/especialidades/${especialidadId}`);
                        if (!response.ok) {
                            throw new Error(`Error ${response.status}: No se pudieron obtener los médicos`);
                        }
                        
                        const medicos = await response.json();
                        
                        // Guardar en caché
                        cachedMedicos[especialidadId] = medicos;
                        
                        // Poblar el selector
                        poblarSelectorProfesionales(medicos);
                    } catch (error) {
                        manejarError(error, "médicos");
                    }
                }
            } catch (error) {
                console.error("Error general:", error);
                mostrarErrorEnSelector("Error al cargar médicos");
            }
        }

        // Función para poblar el selector con los profesionales
        function poblarSelectorProfesionales(profesionales) {
            // Limpiar el selector
            selectMedico.innerHTML = "";
            
            // Opción por defecto
            const defaultOption = document.createElement("option");
            defaultOption.value = "";
            defaultOption.textContent = "Seleccione un Médico";
            defaultOption.selected = true;
            defaultOption.disabled = true;
            selectMedico.appendChild(defaultOption);
            
            // Verificar si hay profesionales
            if (!profesionales || profesionales.length === 0) {
                const noOption = document.createElement("option");
                noOption.disabled = true;
                noOption.textContent = "No hay médicos disponibles";
                selectMedico.appendChild(noOption);
                return;
            }
            
            // Añadir cada profesional
            profesionales.forEach(profesional => {
                const option = document.createElement("option");
                option.value = profesional.id;
                option.textContent = `${profesional.nombre} ${profesional.apellido}`;
                selectMedico.appendChild(option);
            });
        }

        // Función para manejar errores
        function manejarError(error, tipo) {
            console.error(`Error al cargar ${tipo}:`, error);
            mostrarErrorEnSelector(`Error al obtener ${tipo}`);
        }

        // Función para mostrar un mensaje de error en el selector
        function mostrarErrorEnSelector(mensaje) {
            selectMedico.innerHTML = "";
            const errorOption = document.createElement("option");
            errorOption.textContent = mensaje;
            errorOption.disabled = true;
            errorOption.selected = true;
            selectMedico.appendChild(errorOption);
            
            // Añadir opción para reintentar
            const retryOption = document.createElement("option");
            retryOption.value = "retry";
            retryOption.textContent = "Reintentar";
            selectMedico.appendChild(retryOption);
            
            // Escuchar eventos de cambio para detectar el reintento
            const handleRetry = () => {
                if (selectMedico.value === "retry") {
                    fijarTipo(); // Reintentar la carga
                }
            };
            
            selectMedico.addEventListener("change", handleRetry, { once: true });
        }

        // Reemplazar este código para cargar especialidades
        document.addEventListener("DOMContentLoaded", async () => {
            try {
                // Cargar especialidades desde el nuevo endpoint
                const responseEsp = await fetch("/especialidades/listado");
                if (!responseEsp.ok) {
                    throw new Error("Error al obtener las especialidades");
                }
                const especialidades = await responseEsp.json();
                
                // Limpiar y configurar el selector de especialidades
                selectEsp.innerHTML = "";
                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = "Seleccione una Especialidad";
                defaultOption.selected = true;
                defaultOption.disabled = true;
                selectEsp.appendChild(defaultOption);
                
                // Añadir las especialidades médicas
                especialidades.forEach(esp => {
                    const option = document.createElement("option");
                    option.value = `esp_${esp.id}`; 
                    option.textContent = esp.nombre;
                    selectEsp.appendChild(option);
                });
                
            } catch (error) {
                console.error("Error al cargar especialidades:", error);
                selectEsp.innerHTML = "<option disabled selected>Error al cargar datos</option>";
            }
        });

        //aca cargamos las fechas en el datepicker
        $(document).ready(function() {
            $('#datepicker input').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'es',
                startDate: new Date(),

            });
        });
        

        
        //este metodo chequea que el dni exista y lo fija en el input
        //luego habria que cambiar todas las alert por modals
        document.addEventListener("DOMContentLoaded", () => {
            // Variables para control de debounce
            let dniTimeout;
            let lastCheckedDni = "";
            
            dni.addEventListener("input", async () => {
                // Limita a solo números y máximo 8 dígitos
                dni.value = dni.value.replace(/[^0-9]/g, "").slice(0, 8);
                
                // Controlar estados visuales iniciales
                if (dni.value === "") {
                    clearTimeout(dniTimeout);
                    updateDniStatus("empty");
                    return;
                }
                
                if (dni.value.length < 7) {
                    clearTimeout(dniTimeout);
                    updateDniStatus("incomplete");
                    return;
                }
                
                // Evitar búsqueda duplicada del mismo DNI
                if (dni.value === lastCheckedDni) return;
                
                // Cambiar a estado "buscando"
                updateDniStatus("searching");
                
                // Implementar debounce para evitar muchas solicitudes seguidas
                clearTimeout(dniTimeout);
                dniTimeout = setTimeout(async () => {
                    lastCheckedDni = dni.value;
                    await checkPatientDni(dni.value);
                }, 500);
            });
            
            // Función para verificar DNI con el servidor
            async function checkPatientDni(dniValue) {
                try {
                    const response = await fetch(`/pacientes/listado/${dniValue}`);
                    
                    if (response.ok) {
                        // DNI existe, cambiar a verde y guardar ID
                        const paciente = await response.json();
                        idPaciente = paciente.id;
                        updateDniStatus("found", paciente.nombre + " " + paciente.apellido);
                        console.log("Paciente encontrado, ID:", idPaciente);
                    } else if (response.status === 404) {
                        // DNI no existe
                        idPaciente = "";
                        updateDniStatus("not-found");
                    } else {
                        // Otro tipo de error
                        throw new Error(`Error de servidor: ${response.status}`);
                    }
                } catch (error) {
                    console.error("Error al comprobar el DNI:", error);
                    updateDniStatus("error");
                }
            }
            
            // Función para actualizar el estado visual del DNI
            function updateDniStatus(status, patientName = "") {
                dniSpan.removeEventListener("click", redirectANuevoPaciente);
                dniSpan.style.cursor = "default"
                switch (status) {
                    case "empty":
                        dniSpan.style.backgroundColor = "#0d6efd"; // Azul
                        dniSpan.title = "Ingrese DNI del paciente";
                        break;
                    case "incomplete":
                        dniSpan.style.backgroundColor = "#ffc107"; // Amarillo
                        dniSpan.title = "DNI incompleto";
                        break;
                    case "searching":
                        dniSpan.style.backgroundColor = "#ffc107"; // Amarillo
                        dniSpan.title = "Buscando paciente...";
                        break;
                    case "found":
                        dniSpan.style.backgroundColor = "#28a745"; // Verde
                        dniSpan.title = `Paciente encontrado: ${patientName}`;
                        break;
                    case "not-found":
                        dniSpan.style.backgroundColor = "#dc3545"; // Rojo
                        dniSpan.title = "Paciente no encontrado. Haz clic par cargar sus datos";
                        dniSpan.style.cursor = "pointer";
                        dniSpan.addEventListener("click", redirectANuevoPaciente);
                        break;
                    case "error":
                        dniSpan.style.backgroundColor = "#ffc107"; // Amarillo
                        dniSpan.title = "Error al verificar DNI";
                        break;
                }
            }
        });
        // con esto hacemos que cuando se seleccione una especialidad, se carguen los medicos en el select
        //y si es Triage de Ingreso, se cargan los enfermeros
        document.addEventListener("DOMContentLoaded", () => {
            selectEsp.addEventListener("change", async () => {
                fijarTipo();
            });
        });
        document.addEventListener("DOMContentLoaded", () => {
            selectMedico.addEventListener("change", async () => {
                aceptarMedico();
            }); 
        });
         //metodo para fijar el medico del turno y guardar su id
        async function aceptarMedico() {
            if(selectMedico.value === "" || selectMedico.value === "Seleccione un Médico") {
                alert("Seleccione un Médico");
            } else {
                idMedico = selectMedico.value;
                console.log(idMedico);
                alert(`Médico seleccionado: ${selectMedico.options[selectMedico.selectedIndex].text}`);
            }
        };

        document.addEventListener("DOMContentLoaded", () => {
            $('#datepicker input').on('changeDate', async () => {
                if(selectMedico.value !== "Seleccione un Profesional") {
                aceptarFecha();
                } else {
                    alert("Debe seleccionar un profesional antes de seleccionar una fecha");
                    datePicker.value = "";
                }
            });
        });

        async function aceptarFecha() {
            const fecha = document.getElementById("inputFecha").value;
            if (fecha === "") {
                alert("Seleccione una fecha");
                return;
            }   
            
            try {
                // Convertir la fecha al formato YYYY-MM-DD
                const partesFecha = fecha.split("/");
                const fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`;
                
                alert(`Fecha seleccionada: ${fecha}`);
                fechaTurno = fecha;
                
                console.log("Médico ID:", idMedico);
                console.log("Fecha en el front:", fechaFormateada);
                
                const response = await fetch(`/turnos/listadohorarios/${idMedico}/${fechaFormateada}`);
                
                if (!response.ok) {
                    throw new Error(`Error al obtener horarios: ${response.status}`);
                }
                
                const horarios = await response.json();
                console.log("Horarios ocupados:", horarios);
                
                // Cargar los horarios disponibles - eliminar el parámetro esEnfermero
                cargarHorariosDisponibles(horarios);
                
            } catch (error) {
                console.error("Error al cargar horarios:", error);
                alert(`Error: ${error.message || "No se pudieron cargar los horarios disponibles"}`);
                
                // Resetear el selector de horarios
                hourpicker.innerHTML = "";
                const errorOption = document.createElement("option");
                errorOption.textContent = "Error al cargar horarios";
                errorOption.disabled = true;
                errorOption.selected = true;
                hourpicker.appendChild(errorOption);
            }
        }

        // Función separada para cargar horarios disponibles
        function cargarHorariosDisponibles(horarios) {
            // Limpiar el selector de horarios
            hourpicker.innerHTML = "";
            
            // Opción por defecto
            const defaultOption = document.createElement("option");
            defaultOption.value = "";
            defaultOption.textContent = "Seleccione un horario";
            defaultOption.selected = true;
            defaultOption.disabled = true;
            hourpicker.appendChild(defaultOption);
            
            // Definir horario laboral
            const startTime = new Date();
            startTime.setHours(8, 0, 0); // Entrada 8:00
            const endTime = new Date();
            endTime.setHours(16, 0, 0); // Salida 16:00
            
            // Usar solo el intervalo para médicos: 40 minutos
            const intervaloMinutos = 40;
            let currentTime = new Date(startTime);
            
            const horariosOcupados = new Set();
            horarios.forEach(horario => {
                const hora = horario.hora.split(":")[0];
                const minuto = horario.hora.split(":")[1];
                horariosOcupados.add(`${hora}:${minuto}`);
            });
            
            while (currentTime <= endTime) {
                const hora = currentTime.getHours().toString().padStart(2, "0");
                const minuto = currentTime.getMinutes().toString().padStart(2, "0");
                const horarioStr = `${hora}:${minuto}`;
                
                if (!horariosOcupados.has(horarioStr)) {
                    const option = document.createElement("option");
                    option.value = horarioStr;
                    option.textContent = horarioStr;
                    hourpicker.appendChild(option);
                }
                
                currentTime.setMinutes(currentTime.getMinutes() + intervaloMinutos);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            hourpicker.addEventListener("change", async () => {
                aceptarHorario();
            })
        })

        async function aceptarMotivo() {
            const motivoSeleccionado = motivo.value;
            if (motivoSeleccionado === "Seleccione un Motivo") {
                alert("Seleccione un Motivo");
            } else {
                alert(`Motivo seleccionado: ${motivoSeleccionado}`);
                motivoTurno = motivo.value;
            }
        };

        document.addEventListener("DOMContentLoaded", () => {
            motivo.addEventListener("change", async () => {
                aceptarMotivo();
            })
        })
        
        async function aceptarHorario() {
            const hora = hourpicker.value;
            if (hora === "Seleccione un horario") {
                alert("Seleccione un horario");
            } else {
                alert(`Horario seleccionado: ${hora}`);
                horaTurno = hora;
            }
        };

        async function aceptarDatos() {
            
            motivoTurno = motivo.value;
            
            if (idPaciente === "" || !idMedico || fechaTurno === "" || horaTurno === "" || motivoTurno === "") {
                alert("Complete todos los campos");
            } else {
                alert(`Datos seleccionados: ${idPaciente} ${idMedico} ${fechaTurno} ${horaTurno} ${motivoTurno}`);
                //aca llamamos al metodo para enviar los datos al servidor
                enviarDatos();
            }
        };

        async function enviarDatos() {
            motivoTurno = motivo.value;
            const estado = "pendiente";
            
            try {
                // Formatear fecha y hora para base de datos
                const partesFecha = fechaTurno.split("/");
                const fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`;
                const horaFormateada = `${horaTurno}:00`;
                
                console.log("Datos Enviados:", {
                    fechaFormateada,
                    horaFormateada,
                    motivo_Id: motivoTurno,
                    estado,
                    paciente_Id: idPaciente,
                    medico_Id: idMedico
                });
                
                const response = await fetch("/turnos/admin/new", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        estado: estado,
                        fecha: fechaFormateada,
                        hora: horaFormateada,
                        motivo_Id: motivoTurno,
                        paciente_Id: idPaciente,
                        medico_Id: idMedico
                    })
                });
                
                // Verificar el tipo de contenido antes de intentar parsear JSON
                const contentType = response.headers.get("content-type");
                
                if (contentType && contentType.includes("application/json")) {
                    const data = await response.json();
                    console.log(data);
                    
                    // VERIFICAR SI SUCCESS ES FALSE - ESTA ES LA PARTE IMPORTANTE
                    if (!data.success) {
                        throw new Error(data.error || "Error al crear el turno");
                    }
                    
                    // Si llegamos aquí, la operación fue exitosa
                    alert("Turno creado con éxito");
                    window.location.href = data.redirectUrl || "/turnos/admin";
                } else {
                    // Si no es JSON, podría ser un error
                    if (!response.ok) {
                        const errorText = await response.text();
                        console.log("Respuesta no JSON del servidor:", errorText);
                        throw new Error(`Error del servidor: ${response.status}`);
                    }
                    
                    // Si es redirección
                    if (response.redirected) {
                        alert("Turno creado con éxito");
                        window.location.href = response.url;
                    }
                }
            } catch (error) {
                console.error("Error al enviar los datos:", error);
                alert(error.message); // Mostrar el mensaje de error al usuario
            }
        };
        async function cargarMotivos() {
            try {
                const response = await fetch("/motivos/listado");
                if (!response.ok) {
                    throw new Error("Error al cargar los motivos");
                }
                const motivos = await response.json();
                
                // Limpiar el selector de motivos
                motivo.innerHTML = "";
                
                // Opción por defecto
                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = "Seleccione un Motivo";
                defaultOption.selected = true;
                defaultOption.disabled = true;
                motivo.appendChild(defaultOption);
                
                // Añadir cada motivo
                motivos.forEach(mot => {
                    const option = document.createElement("option");
                    option.value = mot.id;
                    option.textContent = mot.nombre;
                    motivo.appendChild(option);
                });
                
            } catch (error) {
                console.error("Error al cargar los motivos:", error);
            }
        }
        function redirectANuevoPaciente() {
            window.location.href = "/pacientes/admin/new";
        }
        cargarMotivos();
        async function enviarDatosTurno() {
            try {  // Ahora con 8 espacios (nivel correcto dentro de script)
                const response = await fetch("/turnos/crear", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json" // Indica que esperas JSON
                    },
                    body: JSON.stringify({
                        fecha: fechaTurno,
                        hora: horaTurno,
                        motivo_Id: motivoSeleccionado,
                        paciente_Id: idPaciente,
                        medico_Id: idMedico,
                        enfermero_Id: idEnfermero
                        // Otros campos según sea necesario
                    })
                });
                
                if (!response.ok) {
                    const contentType = response.headers.get("content-type");
                    if (contentType && contentType.includes("application/json")) {
                        // Si es JSON, extraer el mensaje de error correctamente
                        const errorData = await response.json();
                        throw new Error(errorData.error || "Error al crear el turno");
                    } else {
                        // Si es texto u otro formato
                        const errorText = await response.text();
                        throw new Error(errorText || "Error al crear el turno");
                    }
                }
                
                // Si la respuesta es exitosa
                const data = await response.json();
                
                // Redirigir o mostrar mensaje de éxito
                if (data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                } else {
                    alert("Turno creado correctamente");
                    window.location.href = "/turnos/admin";
                }
            } catch (error) {
                console.error("Error al enviar los datos:", error);
                alert(error.message);
            }
        }


