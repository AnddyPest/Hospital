extends ../templates/layout.pug

include ../templates/mixins.pug

block content

        div
            img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
            
            +header("Lista de Turnos", "/icons/user-clock-solid.svg")
            
            div.position-absolute.top-50.start-50.translate-middle.text-center
                div.d-flex.justify-content-center
                    a(href="/turnos/listar/medicos" id="botonMedicos" class="btn btn-info btn-lg px-5 me-5 custom-button") 
                        span() Turnos Medicos
                        img(src="/icons/user-doctor-solid.svg", alt="Medicos", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                    a(href="/turnos/listar/triages" id="botonTriage" class="btn btn-info btn-lg px-5 ms-5 custom-button")
                        span() Triages
                        img(src="/icons/user-nurse-solid.svg", alt="Medicos", class="ms-5", style="width: 40px; height: 40px; opacity: 0.8;")
                    a.w-25.ms-5(href="/turnos" alt="Inicio" class="btn btn-danger btn-lg px-5 ms-5 custom-button")
                        span() Volver
                        img(src="/icons/house-solid.svg", alt="Inicio", class="ms-5", style="width: 40px; height: 40px; opacity: 0.8;")
        
        