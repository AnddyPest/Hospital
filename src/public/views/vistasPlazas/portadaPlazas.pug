extends ../templates/layout

include ../templates/mixins.pug

block content
   

    div
        img(src="/images/habitacion.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Gestión de Plazas", "/icons/bed-solid.svg")
              
        div.position-absolute.top-50.start-50.translate-middle.text-center
            div.d-flex.justify-content-center
                a(href="/administrativos/admin" id="botonAdmin" class="btn btn-info btn-lg px-5 me-5 custom-button") 
                    span() Comun
                    img(src="/icons/bed-solid.svg", alt="Medicos", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                a(href="/administrativos/listar" id="botonListar" class="btn btn-info btn-lg px-5 ms-5 custom-button")
                    span() Terapia Intermedia
                    img(src="/icons/user-nurse-solid.svg", alt="Medicos", class="ms-5", style="width: 40px; height: 40px; opacity: 0.8;")
            div.d-flex.justify-content-center.mt-5   
                a(href="/administrativos/admin" id="botonAdmin" class="btn btn-info btn-lg px-5 me-5 custom-button") 
                    span() Pre-quirúrgico
                    img(src="/icons/user-doctor-solid.svg", alt="Medicos", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                a(href="/administrativos/admin" id="botonAdmin" class="btn btn-info btn-lg px-5 ms-5 custom-button") 
                    span() Terapia Intensiva
                    img(src="/icons/bed-pulse-solid.svg", alt="Medicos", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
            div.d-flex.justify-content-center.mt-5   
                a.w-50(href="/" alt="Inicio" class="btn btn-danger btn-lg px-5 ms-5 custom-button")
                    span() Volver
                    img(src="/icons/house-solid.svg", alt="Inicio", class="ms-5", style="width: 40px; height: 40px; opacity: 0.8;")
                
                
                