extends ../templates/layout

include ../templates/mixins.pug

block content
   

    div
        img(src="/images/datos.png" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Gestión de Datos", "/icons/staff-snake-solid.svg")
              
        div.position-absolute.top-50.start-50.translate-middle.text-center
            div.d-flex.justify-content-center
                a(href="/especialidades" id="botonAdmin" class="btn btn-info btn-lg px-5 custom-button") 
                    span() Especialidades
                    img(src="/icons/user-doctor-solid.svg", alt="Medicos", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                a(href="/areas" id="botonListar" class="btn btn-info btn-lg px-5 ms-5 custom-button")
                    span() Areas
                    img(src="/icons/users-solid.svg", alt="Medicos", class="ms-5", style="width: 40px; height: 40px; opacity: 0.8;")
                a(href="/motivos" id="botonListar" class="btn btn-info btn-lg px-5 ms-5 custom-button")
                    span() Motivos de Turnos
                    img(src="/icons/notes-medical-solid.svg", alt="Medicos", class="ms-5", style="width: 40px; height: 40px; opacity: 0.8;")
            div.d-flex.justify-content-center.mt-5
                a(href="/hospitalesExternos" id="botonListar" class="btn btn-info btn-lg px-5 me-5 custom-button")
                    span() Hospitales Ext
                    img(src="/icons/truck-medical-solid.svg", alt="Medicos", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                a.w-25.ms-5(href="/" alt="Inicio" class="btn btn-danger btn-lg px-5 ms-5 custom-button")
                    span() Volver
                    img(src="/icons/house-solid.svg", alt="Inicio", class="ms-5", style="width: 40px; height: 40px; opacity: 0.8;")
        
        
        
        