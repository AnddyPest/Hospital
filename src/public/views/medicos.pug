extends ../templates/layout

include ../templates/mixins.pug

block content

    div
        img(src="/images/trabajadores.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh);  object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        div.position-absolute.start-50.translate-middle-x.text-center.text-white(style="top: 10%; opacity: 0.8;")
            h1(style="padding: 20px; background-color: rgba(0, 0, 0, 0.5); border-radius: 10px;")
                span(id="cabecera" style="font-size: 2.5rem;") Sistema de Gestión de Médicos
                img(src="/icons/user-doctor-solid.svg", alt="Medicos", class="ms-4", style="width: 60px; height: 60px;")
        
        //-botones de navegacion de la vista principal de medicos
        div.position-absolute.top-50.start-50.translate-middle.text-center
            div.d-flex.justify-content-center
                a(href="#" id="botonAdmin" class="btn btn-info btn-lg px-5 me-5 custom-button") 
                    span() Administrar Médicos
                    img(src="/icons/users-gear-solid.svg", alt="Medicos", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                a(href="#" id="botonListar" class="btn btn-info btn-lg px-5 ms-5 custom-button")
                    span() Listar / Buscar
                    img(src="/icons/rectangle-list-solid.svg", alt="Medicos", class="ms-5", style="width: 40px; height: 40px; opacity: 0.8;")

        //-tabla de medicos
        //-se muestra al presionar el boton Listar/Buscar
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%; display: none;" id="tablaMedicos")
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        tr.table-info
                            th.col(style="width: 10%") ID
                            th.col(style="width: 22.5%") Nombre
                            th.col(style="width: 22.5%") Apellido
                            th.col(style="width: 22.5%") Telefono
                            th.col(style="width: 22.5%") Especialidad
                    
                    tbody
                        tr
                            td 1
                            td Juan
                            td Sosa
                            td +54 9 11 1234-5678
                            td Cirujia
                        tr 
                            td 2
                            td Maria
                            td Gonzalez
                            td +54 9 11 2345-6789
                            td Pediatria
                        tr 
                            td 3
                            td Pedro
                            td Martinez
                            td +54 9 11 3456-7890
                            td Cardiologia
                        tr 
                            td 4
                            td Ana
                            td Lopez
                            td +54 9 11 4567-8901
                            td Neurologia
                        tr 
                            td 5
                            td Laura
                            td Fernandez
                            td +54 9 11 5678-9012
                            td Dermatologia
                        tr
                            td 6
                            td Carlos
                            td Ramirez
                            td +54 9 11 6789-0123
                            td Ginecologia
                        tr
                            td 7
                            td Sofia
                            td Torres
                            td +54 9 11 7890-1234
                            td Oftalmologia
                        tr
                            td 8
                            td Diego
                            td Morales
                            td +54 9 11 8901-2345
                            td Traumatologia
                        tr                          
                            td 9
                            td Valentina
                            td Castro
                            td +54 9 11 9012-3456
                            td Endocrinologia
                        tr
                            td 10
                            td Lucas
                            td Diaz
                            td +54 9 11 0123-4567
                            td Psiquiatria
            
            //-botones de ingreso a filtros y volver a la vista principal
            div.mt-3(id="filtros")
                button.btn.btn-info.me-4(type="button", id="especialidad" class="custom-button2") Filtrar por Especialidad
                button.btn.btn-info.ms-4.me-4(type="button", id="nombre" class="custom-button2") Buscar por Apellido
                button.btn.btn-danger.ms-4(type="button", id="back" class="back custom-button2" style="width: 50px; padding:5px;") 
                    img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")
            //--Inputs importados de mixins.pug de busqueda y botones de filtro
            +inputGroup("inputEspecialidad", "Ingrese la especialidad", "Filtrar", "Limpiar", "Volver")
            +inputGroup("inputApe", "Ingrese el Apellido", "Filtrar", "Limpiar", "Volver")
            //-*******************************************************************************************************************************
            
        //-botones de agregar, editar y borrar medicos
        //-se muestran al presionar el boton Administrar Medicos
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="display: none;" id="adminControl")
            div.d-flex.justify-content-center.align-items-center.gap-4
                button.btn.btn-success.ms-4(type="button", id="agregar" class="custom-button2" style="width: 350px;") 
                    span() Agregar Médico
                    img(src="/icons/user-plus-solid.svg", alt="Agregar Medico", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                button.btn.btn-warning(type="button", id="editar" class="custom-button2" style="width: 350px;") 
                    span() Editar Médico
                    img(src="/icons/user-pen-solid.svg", alt="Editar Medico", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                button.btn.btn-danger.me-4(type="button", id="borrar" class="custom-button2" style="width: 350px;") 
                    span() Borrar Médico
                    img(src="/icons/user-slash-solid.svg", alt="Borrar Medico", class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
                button.btn.btn-danger.ms-4(type="button", id="back" class="back custom-button2" style="width: 50px; padding:5px;") 
                    img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")

            //-formulario para cargar/editar/borrar medicos
            div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%; display: none;" id="formularioMedico")
                form(id="formMedico", method="POST", action="/medicos/guardar")
                    div.form-group.mb-3
                        label(for="nombre") Nombre:
                        input.form-control(type="text", id="nombre" name="nombre" required)
                    div.form-group.mb-3
                        label(for="apellido") Apellido:
                        input.form-control(type="text", id="apellido" name="apellido" required)
                    div.form-group.mb-3
                        label(for="telefono") Telefono:
                        input.form-control(type="text", id="telefono" name="telefono" required)
                    div.form-group.mb-3
                        label(for="especialidad") Especialidad:
                        input.form-control(type="text", id="especialidad" name="especialidad" required)
                    button.btn.btn-primary(type="submit") Guardar Médico
                    button.btn.btn-danger.ms-2(type="button", id="cancelar") Cancelar

            
    script. 
        document.addEventListener("DOMContentLoaded", ()=>{
            //Botones de la vista primaria de medicos (Administrar Medicos y Listar/Buscar)
            const btnAdmin = document.getElementById("botonAdmin");
            const btnListar = document.getElementById("botonListar");
            //boton para volver a la vista principal
            const btnBack = document.querySelectorAll(".back");
            //*******************************************************************************
            
            //Tabla de medicos
            const tablaMedicos = document.getElementById("tablaMedicos");
            //*********************************************************************************

            //Cabecera de pagina, para cambiar el texto segun el boton que se presione
            const cabecera = document.getElementById("cabecera");
            //*******************************************************************************

            //botones de filtro por appelido y especialidad
            const btnEspecialidad = document.getElementById("especialidad");
            const btnNombre = document.getElementById("nombre");
            //*******************************************************************************

            //Contenedor de filtros
            const containerFiltros = document.getElementById("filtros");

            //contenedor de botones de administracion de medicos
            const containerAdmin = document.getElementById("adminControl");
            //*******************************************************************************
            
            //inputs de especialidad y apellido
            const inputEspecialidad = document.getElementById("inputEspecialidad");
            const inputApe = document.getElementById("inputApe");
            
            //botones de volver para ambos tipos de filtro
            const btnVolver = document.querySelectorAll(".volver");
            

            //event listeners

            //boton para listar medicos
            btnListar.addEventListener("click", (e)=>{
                e.preventDefault();
                btnAdmin.style.display = "none";
                btnListar.style.display = "none";
                tablaMedicos.style.display = "block";
                cabecera.innerHTML = "Listado de Médicos";
            })

            //boton para filtrar por especialidad
            btnEspecialidad.addEventListener("click", (e)=>{
                e.preventDefault();
                containerFiltros.style.display = "none";
                inputEspecialidad.style.display = "block";
                inputEspecialidad.querySelector("input").focus();
            })

            //boton para filtrar por apellido
            btnNombre.addEventListener("click", (e)=>{
                e.preventDefault();
                containerFiltros.style.display = "none";
                inputApe.style.display = "block";
                inputApe.querySelector("input").focus();
            })
            //Agregar un listener por cada boton de la clase volver!!!
            btnVolver.forEach((btn)=>{
                btn.addEventListener("click", (e)=>{
                    e.preventDefault();
                    inputEspecialidad.style.display = "none";
                    inputApe.style.display = "none";
                    containerFiltros.style.display = "block";
                })
            })
            //volver a la vista principal de medicos
            btnBack.forEach((btnbk) => {
                btnbk.addEventListener("click", (e)=>{
                e.preventDefault();
                btnAdmin.style.display = "block";
                btnListar.style.display = "block";
                tablaMedicos.style.display = "none";
                containerAdmin.style.display = "none";
                cabecera.innerHTML = "Sistema de Gestión de Médicos";
                })
            })

            //boton para ingresar a administrar medicos
            btnAdmin.addEventListener("click", (e)=>{
                e.preventDefault();
                btnAdmin.style.display = "none";
                btnListar.style.display = "none";
                containerAdmin.style.display = "block";
                cabecera.innerHTML = "Administrar Médicos";
            })


        })

        //-EL VIERNES CONSULTAR: TEMA RESPONSIVE PARA TODO ESTO
                        
                        