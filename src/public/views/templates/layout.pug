    document.addEventListener("DOMContentLoaded", async () => {
      
      const currentPath = window.location.pathname;
      const collapsePersonal = document.querySelector("#collapsePersonal");
      const botonPersonal = collapsePersonal.previousElementSibling.querySelector("button");
      const collapseGestion = document.querySelector("#collapseGestion");
      const botonGestion = collapseGestion.previousElementSibling.querySelector("button");
      const collapsePacientes = document.querySelector("#collapsePacientes");
      const botonPacientes = collapsePacientes.previousElementSibling.querySelector("button");
      /**passwordLogin = document.getElementById('passwordLogin');
      passwordCreate = document.getElementById('passwordCreate');
      passwordConfirm = document.getElementById('passwordConfirm');
      ojoLogin = document.getElementById('ojoLogin');
      ojoCreate = document.getElementById('ojoCreate');
      ojoConfirm = document.getElementById('ojoConfirm');
      loginCard = document.getElementById('login');
      registerCard = document.getElementById('register');*/


      // acordedones o collapses
      if(["/medicos", "/enfermeros", "/administrativos", "/maestranzas"].some(path => currentPath.startsWith(path))) {
        collapsePersonal.classList.add("show");
        botonPersonal.setAttribute("aria-expanded", "true");
        botonPersonal.classList.remove("collapsed");
      } else if(["/camas", "/diagnosis", "/tratamiento", "/cirugias", "/equipos", "/farmacia", "/proveedores"].some(path => currentPath.startsWith(path))) {
        collapseGestion.classList.add("show");
        botonGestion.setAttribute("aria-expanded", "true");
        botonGestion.classList.remove("collapsed");
      } else if(["/pacientes", "/turnos"].some(path => currentPath.startsWith(path))) {
        collapsePacientes.classList.add("show");
        botonPacientes.setAttribute("aria-expanded", "true");
        botonPacientes.classList.remove("collapsed");
      }

      //const token = localStorage.getItem("token");
      
      /** Si hay token, verificar si aún es válido
      if (token) {
        try {
          const response = await fetch("/auth/verificador", {
            headers: {
              "Authorization": `Bearer ${token}`
            }
          });
          
          if (!response.ok) {
            // Token inválido o expirado, mostrar login
            console.log("Token expirado o inválido");
            localStorage.removeItem("token");
            localStorage.removeItem("userType");
            showLoginCard();
          } else {
            // Token válido, ocultar login
            hideLoginCards();
          }
        } catch (error) {
          console.error("Error al verificar token:", error);
          showLoginCard(); // Por si hay error de red
        }
      } else {
        // No hay token, mostrar login
        showLoginCard();
      }
    });
    
    function showLoginCard() {
      if (loginCard) {
        document.getElementById('pageOverlay').style.display = 'block';
        loginCard.style.display = "block";
        registerCard.style.display = "none";
        document.body.style.overflow = "hidden";
      }
    }
    
    function hideLoginCards() {
      if (loginCard) {
        loginCard.style.display = "none";
        registerCard.style.display = "none";
        document.getElementById('pageOverlay').style.display = 'none';
        document.body.style.overflow = "hiden";
      }
    }
    
    function registrarse() {
      loginCard.style.display = 'none';
      registerCard.style.display = 'block';
    };
    function volver() {
      loginCard.style.display = 'block';
      registerCard.style.display = 'none';
    };       
    //registrarse como nuevo usuario!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    async function nuevoUser() {
      const email = document.getElementById("email").value;
      const dni = document.getElementById("dni").value;
      const password = document.getElementById("passwordCreate").value;
      const confirmPassword = document.getElementById("passwordConfirm").value;

      if (password !== confirmPassword) {
        alert("Las contraseñas no coinciden");
        return;
      }

      let tipoUsuario = null;
      let idUsuario = null;

      // Buscar al usuario por DNI en los diferentes endpoints
      try {
        const endpoints = [
          { type: "medico", url: `medicos/buscardni/${dni}` },
          { type: "paciente", url: `pacientes/listado/${dni}` },
          { type: "administrativo", url: `administrativos/buscardni/${dni}` },
          { type: "maestranza", url: `maestranzas/buscardni/${dni}` },
          { type: "enfermero", url: `enfermeros/buscardni/${dni}` },
        ];

        for (const endpoint of endpoints) {
          const response = await fetch(endpoint.url); // Realiza la solicitud aquí

          if (response.ok) {
            const datos = await response.json();
            tipoUsuario = endpoint.type;
            idUsuario = datos.id; // Asegúrate de que 'datos' tenga el formato esperado
            console.log(`ID del ${tipoUsuario}: ${idUsuario}`);
            break; // Detén el bucle si se encuentra un usuario
          }
        }

        if (!idUsuario) {
          alert("No se encontró el usuario con el DNI proporcionado.");
          return;
        }
      } catch (error) {
        console.error("Error al buscar por DNI:", error);
        alert("DNI no encontrado o error en la búsqueda.");
        return;
      }

      // Registrar al usuario
      try {
        const response = await fetch("/auth/register", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            email,
            password,
            [`${tipoUsuario}_Id`]: idUsuario, // Enviar el ID correspondiente al tipo de usuario
          }),
        });

        if (response.ok) {
          alert("Usuario creado con éxito");
          window.location.href = "/";
        } else {
          alert("Error al crear el usuario");
        }
      } catch (error) {
        console.error("Error al registrar el usuario:", error);
        alert("Error al registrar el usuario");
      }
    }
    async function login() {
      const email = document.getElementById("username").value;
      const password = document.getElementById("passwordLogin").value;

      try {
        const response = await fetch("/auth/login", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ email, password }),
        });

        if (response.ok) {
          const data = await response.json();
          const userType = data.userType;
          localStorage.setItem("userType", userType);
          localStorage.setItem("token", data.token);
          window.location.href = "/";
        } else {
          alert("Error al iniciar sesión. Verifique sus credenciales.");
        }
      } catch (error) {
        console.error("Error al iniciar sesión:", error);
        alert("Error al iniciar sesión. Intente nuevamente más tarde.");
      }
    };
