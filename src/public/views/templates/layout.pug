doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Hospital
    link(rel="stylesheet", href="/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
    link(rel="stylesheet", href="/css/style.css")
    script(src="/js/bootstrap.bundle.min.js")
    
    script(src="https://code.jquery.com/jquery-3.6.0.min.js") // Incluye jQuery
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/locales/bootstrap-datepicker.es.min.js")

   
  body.bg-azul-claro
    // Barra de navegación superior
    nav.navbar.navbar-expand-lg.navbar-light.bg-azul-claro.fixed-top.top-navbar
      // Logo y título "Hospital" alineados a la izquierda
      div.d-flex.align-items-center
        img(src="/icons/staff-snake-solid.svg", alt="Prescripciones", class="ms-4", style="width: 3vw; height: 10vh;")
        a.navbar-brand.fs-1.ms-3(href="#") Hospital

      // Botón de colapso para dispositivos pequeños
      button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav", aria-controls="navbarNav", aria-expanded="false", aria-label="Toggle navigation")
        span.navbar-toggler-icon

      // Contenido del navbar
      div.collapse.navbar-collapse#navbarNav
        ul.navbar-nav.ms-auto
          // Icono de mensajería
          li.nav-item.me-2.ms3
            a.nav-link(href="#")
              img(src="/icons/envelope-solid.svg", alt="Prescripciones", class="ms-4", style="width: 20px; height: 20px;")
              span.ms-2 Buzon de Correo

          // Foto y nombre del usuario logueado
          li.nav-item.dropdown.me-2.ms-3
            a.nav-link.dropdown-toggle(href="#", id="userDropdown", role="button", data-bs-toggle="dropdown", aria-expanded="false")
              img(src="/icons/user-solid.svg", alt="Prescripciones", class="ms-4", style="width: 20px; height: 20px;")
              span.ms-2.me-2 Usuario
            ul.dropdown-menu.dropdown-menu-end(aria-labelledby="userDropdown")
              li
                a.dropdown-item(href="#") Perfil
              li
                a.dropdown-item(href="#") Configuración
              li
                hr.dropdown-divider
              li
                a.dropdown-item(href="#") Cerrar sesión

          // Icono de Home
          li.nav-item.ms-3.me-5
            a.nav-link(href="/", id="inicio")
              img(src="/icons/house-solid.svg", alt="Prescripciones", class="ms-4", style="width: 20px; height: 20px;")
              span.ms-2 Inicio

    // Barra de navegación lateral
    div.bg-azul-claro.left-navbar
      h5.text-center Menu
      div.accordion#accordionSidebar
        // Sección Personal
        div.accordion-item.bg-azul-claro
          h2.accordion-header
            button.accordion-button.collapsed(type="button", data-bs-toggle="collapse", data-bs-target="#collapsePersonal", aria-expanded="false", aria-controls="collapsePersonal") 
              | Personal 
              img(src="/icons/users-solid.svg", alt="Prescripciones", class="ms-4", style="width: 25px; height: 25px;")
              
          div.collapse#collapsePersonal(data-bs-parent="#accordionSidebar")
            div.accordion-body
              ul.list-group <!-- BOTON DE MEDICOS -->
                a(href="/medicos" , class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;" id="medico")
                  span
                    | Medicos
                  img(src="/icons/user-doctor-solid.svg", alt="Medicos", class="ms-2", style="width: 20px; height: 20px;")
                a(href="/enfermeros", type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Enfermeros
                  img(src="/icons/user-nurse-solid.svg", alt="Enfermeros", class="ms-2", style="width: 20px; height: 20px;")
                a(href="/administrativos", type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Administrativos
                  img(src="/icons/user-tie-solid.svg", alt="Admins", class="ms-2", style="width: 20px; height: 20px;")
                a(href="/maestranzas", type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Maestranza
                  img(src="/icons/screwdriver-wrench-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")

        // Sección Gestión
        div.accordion-item.bg-azul-claro
          h2.accordion-header
            button.accordion-button.collapsed(type="button", data-bs-toggle="collapse", data-bs-target="#collapseGestion", aria-expanded="false", aria-controls="collapseGestion")
              | Gestion
              img(src="/icons/users-gear-solid.svg", alt="Prescripciones", class="ms-4", style="width: 25px; height: 25px;")
          div.collapse#collapseGestion(data-bs-parent="#accordionSidebar")
            div.accordion-body
              ul.list-group
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Camas
                  img(src="/icons/bed-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Diagnosis
                  img(src="/icons/stethoscope-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Tratamiento
                  img(src="/icons/syringe-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Cirugias
                  img(src="/icons/bed-pulse-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Equipos
                  img(src="/icons/people-group-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Farmacia
                  img(src="/icons/pills-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Proveedores
                  img(src="/icons/building-user-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
        // Sección Pacientes
        div.accordion-item.bg-azul-claro
          h2.accordion-header
            button.accordion-button.collapsed(type="button", data-bs-toggle="collapse", data-bs-target="#collapsePacientes", aria-expanded="false", aria-controls="collapsePacientes")
              | Pacientes
              img(src="/icons/user-injured-solid.svg", alt="Prescripciones", class="ms-3", style="width: 25px; height: 25px;")
          div.collapse#collapsePacientes(data-bs-parent="#accordionSidebar")
            div.accordion-body
              ul.list-group
                a(href="/pacientes", type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Gestion
                  img(src="/icons/user-plus-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Historia Clinica
                  img(src="/icons/file-waveform-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                a(href="/turnos", type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Turnos
                  img(src="/icons/user-clock-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
                button(type="button", class="btn btn-light w-100 d-flex align-items-center justify-content-between" style="margin-bottom: 5px;")
                  span
                    | Prescripciones
                  img(src="/icons/prescription-bottle-medical-solid.svg", alt="Prescripciones", class="ms-2", style="width: 20px; height: 20px;")
             

    // Área de trabajo
    div.workspace
      div.p-4
        block content

    // Pie de página
    footer.bg-azul-claro.text-center.py-3.footer
      p.mb-0 Footer Content
  
  script.
    document.addEventListener("DOMContentLoaded", () => {
      const currentPath = window.location.pathname;
      const collapsePersonal = document.querySelector("#collapsePersonal");
      const botonPersonal = collapsePersonal.previousElementSibling.querySelector("button")
      const collapseGestion = document.querySelector("#collapseGestion");
      const botonGestion = collapseGestion.previousElementSibling.querySelector("button")
      const collapsePacientes = document.querySelector("#collapsePacientes");
      const botonPacientes = collapsePacientes.previousElementSibling.querySelector("button")

      if(["/medicos", "/enfermeros", "/administrativos", "/maestranzas"].some(path => currentPath.startsWith(path))) {
        collapsePersonal.classList.add("show")
        botonPersonal.setAttribute("aria-expanded", "true")
        botonPersonal.classList.remove("collapsed")
      } else if(["/camas", "/diagnosis", "/tratamiento", "/cirugias", "/equipos", "/farmacia", "/proveedores"].some(path => currentPath.startsWith(path))) {
        collapseGestion.classList.add("show")
        botonGestion.setAttribute("aria-expanded", "true")
        botonGestion.classList.remove("collapsed")
      } else if(["/pacientes", "/turnos"].some(path => currentPath.startsWith(path))) {
        collapsePacientes.classList.add("show")
        botonPacientes.setAttribute("aria-expanded", "true")
        botonPacientes.classList.remove("collapsed")
      }

    });
