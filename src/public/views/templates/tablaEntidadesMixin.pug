                  td= maestranza.id
                  td= maestranza.nombre
                  td= maestranza.apellido
                  td= maestranza.dni
                  td= maestranza.telefono
                  td= maestranza.area
                  if contexto === "editar"
                    td
                      button.btn.btn-warning.w-75.h-75(onclick=`editarMaestranza(${maestranza.id})`)
