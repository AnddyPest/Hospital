              if (response.ok) {
                alert('Personal de maestranza eliminado correctamente');
                const fila = document.querySelector(`tr[data-id="${id}"]`);
                if (fila) fila.remove();
                else location.reload();
              } else {
                const error = await response.json();
                alert(`Error al eliminar: ${error.message || 'Ha ocurrido un error'}`);
              }
            } catch (error) {
              console.error('Error:', error);
