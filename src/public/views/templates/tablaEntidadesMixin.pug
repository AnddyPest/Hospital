                  td= administrativo.area
                  if contexto === "editar"
                    td
                      button.btn.btn-warning.w-75.h-75(onclick=`editarAdministrativo(${administrativo.id})`)
                        img(src="/icons/user-pen-solid.svg", alt="Editar", style="width: 100%; height: 100%;")
                  else if contexto === "borrar"
                    td
                      button.btn.btn-danger.w-75.h-75(class="custom-button2" onclick=`borrarAdministrativo(${administrativo.id})`)
