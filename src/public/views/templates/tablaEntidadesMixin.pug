              if (response.ok) {
                alert('Paciente eliminado correctamente');
                const fila = document.querySelector(`tr[data-id="${id}"]`);
                if (fila) fila.remove();
                else location.reload();
              } else {
                const error = await response.json();
                alert(`Error al eliminar: ${error.message || 'Ha ocurrido un error'}`);
              }
            } catch (error) {
              console.error('Error:', error);
              alert('Error al procesar la solicitud');
            }
          }
        }
        
        // También añade las funciones para editar si son necesarias
        function editarMedico(id) {
          window.location.href = `/medicos/admin/editar?id=${id}`;
        }
        
        function editarEnfermero(id) {
          window.location.href = `/enfermeros/admin/editar?id=${id}`;
        }
        
        function editarAdministrativo(id) {
          window.location.href = `/administrativos/admin/editar?id=${id}`;
        }
        
        function editarMaestranza(id) {
          window.location.href = `/maestranzas/admin/editar?id=${id}`;
        }
        
        function editarPaciente(id) {
          window.location.href = `/pacientes/admin/editar?id=${id}`;
        }

