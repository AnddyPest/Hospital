    //- Sección de filtros (condicionales según tipo de entidad)
    if medicos
      div.mt-3.filter-buttons#filterButtons
        button.btn.btn-info.me-2(class="custom-button2" onclick="event.preventDefault(); mostrarFiltro('especialidad');") Filtrar por Especialidad
        button.btn.btn-info.me-2(class="custom-button2" onclick="event.preventDefault(); mostrarFiltro('apellido');") Buscar por Apellido
        button.btn.btn-danger(class="custom-button2" onclick="window.location.href='/medicos'") Volver
      
      div.mt-3#filtroApellidoContainer(style="display: none;")    
        +inputGroup("inputApellido", "Ingrese apellido", "Buscar", "Limpiar", "Volver")
      
      div.mt-3#filtroEspecialidadContainer(style="display: none;")
        +inputGroup("inputEspecialidad", "Ingrese especialidad", "Buscar", "Limpiar", "Volver")

    else if enfermeros || maestranzas || administrativos
      div.mt-3.filter-buttons#filterButtons
        button.btn.btn-info.me-2(class="custom-button2" onclick="event.preventDefault(); mostrarFiltro('area');") Filtrar por Área
        button.btn.btn-info.me-2(class="custom-button2" onclick="event.preventDefault(); mostrarFiltro('apellido');") Buscar por Apellido
        if enfermeros
          button.btn.btn-danger(class="custom-button2" onclick="window.location.href='/enfermeros'") Volver
        else if maestranzas
          button.btn.btn-danger(class="custom-button2" onclick="window.location.href='/maestranzas'") Volver
        else if administrativos
          button.btn.btn-danger(class="custom-button2" onclick="window.location.href='/administrativos'") Volver
      div.mt-3#filtroApellidoContainer(style="display: none;")    
        +inputGroup("inputApellido", "Ingrese apellido", "Buscar", "Limpiar", "Volver")
      
      div.mt-3#filtroAreaContainer(style="display: none;")
        +inputGroup("inputArea", "Ingrese área", "Buscar", "Limpiar", "Volver")

    else if pacientes
      div.mt-3.filter-buttons#filterButtons
        button.btn.btn-info.me-2(class="custom-button2" onclick="event.preventDefault(); mostrarFiltro('dni');") Filtrar por DNI
        button.btn.btn-danger(class="custom-button2" onclick="window.location.href='/pacientes'") Volver
      
      div.mt-3#filtroDniContainer(style="display: none;")    
        +inputGroup("inputDni", "Ingrese número de DNI", "Buscar", "Limpiar", "Volver")

    script.
        // Almacena todas las filas originales para poder filtrar
        let todasLasFilas = [];
        
        document.addEventListener('DOMContentLoaded', function() {
          // Guardar todas las filas de la tabla al cargar la página
          const tbody = document.querySelector('table tbody');
          if (tbody) {
            todasLasFilas = Array.from(tbody.querySelectorAll('tr'));
          }
          
          // Configuración de filtros y eventos
          configurarFiltros();
        });
        
        function mostrarFiltro(tipo) {
          // Ocultar los botones de filtro
          document.getElementById('filterButtons').style.display = 'none';
          
          // Mostrar el filtro adecuado según el tipo
          if (tipo === 'especialidad') {
            document.getElementById('filtroEspecialidadContainer').style.display = 'block';
            configurarBotonesFiltroDinamico('inputEspecialidad');
          } else if (tipo === 'apellido') {
            document.getElementById('filtroApellidoContainer').style.display = 'block';
            configurarBotonesFiltroDinamico('inputApellido');
          } else if (tipo === 'area') {
            document.getElementById('filtroAreaContainer').style.display = 'block';
            configurarBotonesFiltroDinamico('inputArea');
          } else if (tipo === 'dni') {
            document.getElementById('filtroDniContainer').style.display = 'block';
            configurarBotonesFiltroDinamico('inputDni');
          }
        }

        function configurarBotonesFiltroDinamico(idFiltro) {
          // Configurar el botón de búsqueda
          const buscarBtn = document.querySelector(`#${idFiltro} .btn-info`);
          if (buscarBtn) {
            buscarBtn.onclick = function() { filtrarTabla(idFiltro); };
          }
          
          // Configurar el botón de limpieza
          const limpiarBtn = document.querySelector(`#${idFiltro} .btn-warning`);
          if (limpiarBtn) {
            limpiarBtn.onclick = function() { 
              limpiarFiltro(idFiltro);
              mostrarTodasLasFilas(); 
            };
          }
          
          // Configurar el botón de volver
          const volverBtn = document.querySelector(`#${idFiltro} .btn-danger`);
          if (volverBtn) {
            volverBtn.onclick = function() {
              ocultarFiltros();
              mostrarTodasLasFilas();
            };
          }
        }

        function ocultarFiltros() {
          // Ocultar todos los posibles filtros
          const containers = [
            'filtroEspecialidadContainer', 
            'filtroApellidoContainer', 
            'filtroAreaContainer', 
            'filtroDniContainer'
          ];
          
          containers.forEach(container => {
            const elemento = document.getElementById(container);
            if (elemento) elemento.style.display = 'none';
          });
          
          // Mostrar nuevamente los botones de filtro
          document.getElementById('filterButtons').style.display = 'block';
        }

        function filtrarTabla(idFiltro) {
          const input = document.querySelector(`#${idFiltro} input`);
          if (!input) {
            console.error(`No se encontró el input para el filtro ${idFiltro}`);
            return;
          }
          
          const valorFiltro = input.value.trim().toLowerCase();
          if (!valorFiltro) {
            alert('Por favor ingrese un valor para filtrar');
            return;
          }
          
          // Determinar qué columna filtrar según el tipo de filtro
          let columnasAFiltrar = [];
          
          if (idFiltro === 'inputEspecialidad') {
            columnasAFiltrar = [4]; // Columna especialidad (índice 4)
          } else if (idFiltro === 'inputApellido') {
            columnasAFiltrar = [2]; // Columna apellido (índice 2)
          } else if (idFiltro === 'inputArea') {
            columnasAFiltrar = [5]; // Columna área (índice 5)
          } else if (idFiltro === 'inputDni') {
            columnasAFiltrar = [1]; // Columna DNI (índice 1)
          }
          
          const tbody = document.querySelector('table tbody');
          if (!tbody || todasLasFilas.length === 0) {
            console.error('No hay tabla o filas para filtrar');
            return;
          }
          
          // Limpiar tabla actual
          tbody.innerHTML = '';
          
          // Filtrar y añadir filas que coincidan
          let coincidencias = false;
          
          todasLasFilas.forEach(fila => {
            let mostrarFila = false;
            
            columnasAFiltrar.forEach(indice => {
              const celda = fila.cells[indice];
              if (celda && celda.textContent.toLowerCase().includes(valorFiltro)) {
                mostrarFila = true;
              }
            });
            
            if (mostrarFila) {
              tbody.appendChild(fila);
              coincidencias = true;
            }
          });
          
          // Mostrar mensaje si no hay coincidencias
          if (!coincidencias) {
            const colspanValue = document.querySelector('table thead th').getAttribute('colspan') || 
                                document.querySelectorAll('table thead th').length;
            
            const filaNoData = document.createElement('tr');
            const celdaNoData = document.createElement('td');
            
            celdaNoData.textContent = `No se encontraron resultados para "${valorFiltro}"`;
            celdaNoData.className = 'text-center';
            celdaNoData.colSpan = colspanValue;
            
            filaNoData.appendChild(celdaNoData);
            tbody.appendChild(filaNoData);
          }
        }

        function limpiarFiltro(idFiltro) {
          const input = document.querySelector(`#${idFiltro} input`);
          if (input) {
            input.value = '';
          }
        }
        
        function mostrarTodasLasFilas() {
          const tbody = document.querySelector('table tbody');
          if (tbody && todasLasFilas.length > 0) {
            // Limpiar tabla actual
            tbody.innerHTML = '';
            
            // Añadir todas las filas originales
            todasLasFilas.forEach(fila => {
              tbody.appendChild(fila.cloneNode(true));
            });
          }
        }
        
        function configurarFiltros() {
          // Añadir listeners para las teclas Enter en los campos de búsqueda
          const inputFields = document.querySelectorAll('.form-control');
          inputFields.forEach(input => {
            input.addEventListener('keypress', function(e) {
              if (e.key === 'Enter') {
                e.preventDefault();
                
                // Identificar el filtro padre
                let parentContainer = this.closest('div[id]');
                if (parentContainer) {
                  const id = parentContainer.id;
                  
                  // Obtener el ID del input
                  if (id.includes('filtroEspecialidad')) {
                    filtrarTabla('inputEspecialidad');
                  } else if (id.includes('filtroApellido')) {
                    filtrarTabla('inputApellido');
                  } else if (id.includes('filtroArea')) {
                    filtrarTabla('inputArea');
                  } else if (id.includes('filtroDni')) {
                    filtrarTabla('inputDni');
                  }
                }
              }
            });
          });
        }
        
        // FUNCIONES PARA BORRAR ENTIDADES
        async function borrarMedico(id) {
          if (confirm('¿Está seguro que desea eliminar este médico?')) {
            try {
              const response = await fetch(`/medicos/borrar/${id}`, {
                method: 'DELETE',
                headers: {
                  'Content-Type': 'application/json'
                }
              });
              
              if (response.redirected) {
                window.location.href = response.url;
                return;
              }
              
              if (response.ok) {
                alert('Médico eliminado correctamente');
                // Actualizar la tabla eliminando la fila
                const fila = document.querySelector(`tr[data-id="${id}"]`);
                if (fila) fila.remove();
                else location.reload(); // Si no encuentra la fila, recarga la página
              } else {
                const error = await response.json();
                alert(`Error al eliminar: ${error.message || 'Ha ocurrido un error'}`);
              }
            } catch (error) {
              console.error('Error:', error);
              alert('Error al procesar la solicitud');
            }
          }
        }
        
        async function borrarEnfermero(id) {
