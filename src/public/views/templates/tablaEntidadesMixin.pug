//-Header de la pag con título e icono

mixin inputGroup(id, placeholder, btnFiltrarText, btnLimpiarText, btnVolverText)
                div.mt-3(id=id)
                    div.d-flex.align-items-center.justify-content-center
                        input.form-control.me-4(type="text", placeholder=placeholder, aria-label=placeholder, style="width: 400px; padding: 15px 30px;")
                        button.btn.btn-info(type="button" class="custom-button2")= btnFiltrarText
                        button.btn.btn-warning.ms-2(type="button" class="custom-button2")= btnLimpiarText
                        button.btn.btn-danger.ms-2(type="button" id="volver" class="volver custom-button2")= btnVolverText

//-tablas de entidades con buscador

mixin tablaGeneralEntidades(contexto)
  div#tablaGeneralEntidades.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%")
    //- Tabla con datos
    div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
      table.table.table-hover.table-dark.table-bordered.border-info.table-striped
        if medicos 
          //- Tabla para médicos
          thead
            tr.table-info
              th.col(style="width: 5%") ID
              th.col(style="width: 19%") Nombre
              th.col(style="width: 19%") Apellido
              th.col(style="width: 19%") DNI
              th.col(style="width: 19%") Especialidad
              th.col(style="width: 19%") Teléfono
              if contexto === "editar" || contexto === "borrar"
                th.col(style="width: 10%") Acciones
          tbody
            if medicos && medicos.length > 0
              each medico in medicos
                tr(data-id=medico.id)
                  td= medico.id
                  td= medico.nombre
                  td= medico.apellido
                  td= medico.dni
                  td= medico.especialidad
                  td= medico.telefono
                  if contexto === "editar"
                    td
                      button.btn.btn-warning.w-75.h-75(onclick=`editarMedico(${medico.id})`)
                        img(src="/icons/user-pen-solid.svg", alt="Editar", style="width: 100%; height: 100%;")
                  else if contexto === "borrar"
                    td
                      button.btn.btn-danger.w-75.h-75(onclick=`borrarMedico(${medico.id})`)
                        img(src="/icons/user-slash-solid.svg", alt="Borrar", style="width: 100%; height: 100%;")
            else                    
              tr
                td(colspan="7").text-center No hay datos disponibles
                
        else if enfermeros
          //- Tabla para enfermeros
          thead
            tr.table-info
              th.col(style="width: 5%") ID
              th.col(style="width: 19%") Nombre
              th.col(style="width: 19%") Apellido
              th.col(style="width: 19%") DNI
              th.col(style="width: 19%") Teléfono
              th.col(style="width: 19%") Área
              if contexto === "editar" || contexto === "borrar"
                th.col(style="width: 10%") Acciones
          tbody
