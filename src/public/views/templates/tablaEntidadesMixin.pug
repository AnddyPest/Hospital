            tr.table-info
              th.col(style="width: 5%") ID
              th.col(style="width: 19%") Nombre
              th.col(style="width: 19%") Apellido
              th.col(style="width: 19%") DNI
              th.col(style="width: 19%") Teléfono
              th.col(style="width: 19%") Área
