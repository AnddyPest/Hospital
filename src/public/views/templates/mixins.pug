//-Tablas de entidades con busqueda y filtros para las paginas de listar

mixin tablaConBuscador(entityURL, entityName, singleEntityAttr)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id=`tabla${entityName}`)
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                   
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        tr.table-info
                            th.col(style="width: 5%") ID
                            th.col(style="width: 19%") DNI
                            th.col(style="width: 19%") Nombre
                            th.col(style="width: 19%") Apellido
                            th.col(style="width: 19%") Telefono
                            th.col(style="width: 19%") #{singleEntityAttr}
                    tbody

            div.mt-3(id="filtros")
                if entityName === "Paciente"
                    button.btn.btn-info.me-4(type="button", id=`btnNombre` class="custom-button2") Filtrar por DNI
                else
                    button.btn.btn-info.me-4(type="button", id=`btn${singleEntityAttr}` class="custom-button2") Filtrar por #{singleEntityAttr}
                    button.btn.btn-info.ms-4.me-4(type="button", id="btnNombre" class="custom-button2") Buscar por Apellido
                a.btn.btn-danger.ms-4(href=`/${entityURL}` type="button", class="custom-button2" style="width: 50px; padding:5px;") 
                    img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")
            if entityName === "Paciente"
                +inputGroup(`inputApe`, "Ingrese el DNI", "Filtrar", "Limpiar", "Volver")
                
            else    
                +inputGroup(`input${singleEntityAttr}`, `Ingrese ${singleEntityAttr}`, "Filtrar", "Limpiar", "Volver")
                +inputGroup("inputApe", "Ingrese el Apellido", "Filtrar", "Limpiar", "Volver")

        script.
            document.addEventListener("DOMContentLoaded", () => {
                async function cargarEntidad(entityURL, entityName, singleEntityAttr) {
                    try {
                        const response = await fetch(`/${entityURL}/listado`);
                        if (!response.ok) {
                            throw new Error(`Error al obtener los ${entityURL} de la DB: ${response.status} ${response.statusText}`);
                        }
                        const entidades = await response.json();

                        const tbody = document.querySelector(`#tabla${entityName} tbody`);
                        if (!tbody) {
                            throw new Error(`No se encontró el tbody para la tabla con ID 'tabla${entityName}'`);
                        }

                        tbody.innerHTML = ""; // Limpia la tabla antes de llenarla

                        entidades.forEach((entidad) => {
                            const fila = `
                                <tr>
                                    <td>${entidad.id || "N/A"}</td>
                                    <td>${entidad.dni || "N/A"}</td>
                                    <td>${entidad.nombre || "N/A"}</td>
                                    <td>${entidad.apellido || "N/A"}</td>
                                    <td>${entidad.telefono || "N/A"}</td>
                                    <td>${entidad[singleEntityAttr.toLowerCase()] || "N/A"}</td>
                                </tr>
                            `;
                            tbody.innerHTML += fila;
                        });
                    } catch (error) {
                        console.error(`Error al cargar los ${entityURL}:`, error);
                        alert(`No se pudieron cargar los ${entityURL}.`);
                    }
                }

                cargarEntidad("#{entityURL}", "#{entityName}", "#{singleEntityAttr}");

                const btnSingle = document.getElementById("btn#{singleEntityAttr}");
                const btnNombre = document.getElementById("btnNombre");
                const containerFiltros = document.getElementById("filtros");
                const inputSingle = document.getElementById("input#{singleEntityAttr}");
                const inputApe = document.getElementById("inputApe");
                const btnVolver = document.querySelectorAll(".volver");

                if (btnSingle) {
                    btnSingle.addEventListener("click", (e) => {
                        e.preventDefault();
                        containerFiltros.style.display = "none";
                        inputSingle.style.display = "block";
                        inputSingle.querySelector("input").focus();
                    });
                }

                if (btnNombre) {
                    btnNombre.addEventListener("click", (e) => {
                        e.preventDefault();
                        containerFiltros.style.display = "none";
                        inputApe.style.display = "block";
                        inputApe.querySelector("input").focus();
                    });
                }

                if (btnVolver.length > 0) {
                    btnVolver.forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            e.preventDefault();
                            if(inputSingle) {
                                inputSingle.style.display = "none";
                                };
                            
                            inputApe.style.display = "none";
                            containerFiltros.style.display = "block";
                        });
                    });
                }
            });

//-Tablas para las vistas de editar y borrar con botobn de volvler

mixin tablaEditErase(entityURL, entityName, singleEntityAttr, context)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id=`tabla${entityName}`)
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        tr.table-info
                            th.col(style="width: 5%") ID
                            th.col(style="width: 17%") DNI
                            th.col(style="width: 17%") Nombre
                            th.col(style="width: 17%") Apellido
                            th.col(style="width: 17%") Telefono
                            th.col(style="width: 17%") #{singleEntityAttr}
                            th.col(style="width: 10%") #{context.charAt(0).toUpperCase() + context.slice(1)}
                            
                    
                    tbody
            a.btn.btn-danger.ms-2.mt-5(href=`/${entityURL}/admin` type="button" id="volver" class="volver custom-button2") Volver

        script.
            //carga de medicos en tabla
            async function cargarEntidad(entityURL, entityName, singleEntityAttr, context) {
                try {
                    const response = await fetch(`/${entityURL}/listado`);
                    console.log(response);
                    if(!response.ok) {
                        throw new Error(`Error al obtener ${entityURL}  de la DB`);
                    }
                    const entidades = await response.json();

                    const tbody = document.querySelector(`#tabla${entityName} tbody`);
                    tbody.innerHTML = ""; //Limpia la tabla si se hizo una modificacion o busqueda.

                    entidades.forEach((entidad) => {
                        const fila = `
                            <tr>
                                <td>${entidad.id}</td>
                                <td>${entidad.dni}</td>
                                <td>${entidad.nombre}</td>
                                <td>${entidad.apellido}</td>
                                <td>${entidad.telefono}</td>
                                <td>${entidad[singleEntityAttr.toLowerCase()]}</td>
                                ${
                                    context === "Editar"
                                        ? `<td>
                                            <button type="button" class="btn btn-warning" style="width: 100%; padding:5px;" onclick="editarEntidad(${entidad.id}, '${entidad.dni}', '${entidad.nombre}', '${entidad.apellido}', '${entidad.telefono}', '${entidad[singleEntityAttr.toLowerCase()]}', '${context}')">
                                                <img src="/icons/user-pen-solid.svg" alt="Editar" style="width: 25px; height: 25px;">
                                            </button>
                                        </td>`
                                        : context === "Borrar"
                                        ? `<td>
                                            <button type="button" class="btn btn-danger" style="width: 100%; padding:5px;" onclick="borrarEntidad(${entidad.id}, '${entidad.nombre}', '${entidad.apellido}')">
                                                <img src="/icons/user-slash-solid.svg" alt="Borrar" style="width: 25px; height: 25px;">
                                            </button>
                                        </td>`
                                        : ""
                                }
                            </tr>
                        `;
                        tbody.innerHTML += fila;
                    });
                } catch (error) {
                    console.error(`Error al cargar los ${entityURL}:`, error);
                    alert(`No se pudieron cargar los ${entityURL}.`)
                }};

            cargarEntidad("#{entityURL}", "#{entityName}", "#{singleEntityAttr}", "#{context}");

            async function editarEntidad(id, dni, nombre, apellido, telefono, singleEntityAttr, context) {
                
                const dniLimpio = dni.trim();
                const nombreLimpio = nombre.trim();
                const apellidoLimpio = apellido.trim();
                const telefonoLimpio = telefono.trim();
                const attrLimpio = singleEntityAttr.trim();
                const contextLimpio = context.toLowerCase().trim();
                
                window.location.href = 
                `/#{entityURL}/admin/${contextLimpio }?id=${id}
                &dni=${encodeURIComponent(dniLimpio)}
                &nombre=${encodeURIComponent(nombreLimpio)}
                &apellido=${encodeURIComponent(apellidoLimpio)}
                &telefono=${encodeURIComponent(telefonoLimpio)}
                &attr=${encodeURIComponent(attrLimpio)}`; 
            }

            async function borrarEntidad(id, nombre, apellido) {
            const confirmacion = confirm(`¿Estás seguro de que deseas borrar al médico ${nombre} ${apellido}?`);
            if (!confirmacion) {
                return;
            }
            try {
                const response = await fetch(`/#{entityURL}/borrar/${id}`, {
                    method: "DELETE",
                });

                if (!response.ok) {
                    throw new Error(`Error al borrar el ${entityName}`);
                }

                alert(`#{entityName} ID: ${id}, Nombre y Apellido: ${nombre} ${apellido} borrado con éxito`);
                location.reload(); // Recarga la página para actualizar la tabla
            } catch (error) {
                console.error(`Error al borrar el #{entityName}:`, error);
                alert(`No se pudo borrar el #{entityName}`);
            }
            }

//- Crear nueva entidad

mixin nuevaEntidad(entityURL, entityName, singleEntityAttr)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%;" id=`formulario${entityName}`)
            div.d-flex.justify-content-center
                form.w-75(id=`form${entityName}`, method="POST", action=`/${entityURL}/admin/new`)
                    div.form-floating.mb-3
                        input.form-control(type="text", id="dni", name="dni", placeholder="DNI" required)
                        label(for="dni") DNI
                    div.form-floating.mb-3
                        input.form-control(type="text", id="nombre", name="nombre", placeholder="Nombre" required)
                        label(for="nombre") Nombre
                    div.form-floating.mb-3
                        input.form-control(type="text", id="apellido", name="apellido", placeholder="Apellido" required)
                        label(for="apellido") Apellido
                    div.form-floating.mb-3
                        input.form-control(type="text", id=`${singleEntityAttr.toLowerCase()}`, name=`${singleEntityAttr.toLowerCase()}` placeholder="Area" required)
                        label(for=`${singleEntityAttr}`) #{singleEntityAttr}
                    div.form-floating.mb-3
                        input.form-control(type="text", id="telefono", name="telefono", placeholder="Teléfono" required)
                        label(for="telefono") Teléfono
                    div.d-flex.justify-content-center.mt-4
                        button.btn.btn-primary.me-5.w-25(type="submit") Guardar #{entityName}
                        a.btn.btn-danger.ms-5.w-25(href=`/${entityURL}/admin` type="button", id="cancelar") Cancelar

        script.
            
            
            document.getElementById(`form#{entityName}`).addEventListener("submit", async function(event) {
                event.preventDefault();

                const form = document.getElementById(`form#{entityName}`);
                
                const formData = new FormData(form);

                const datos = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch(`/#{entityURL}/admin/new`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(datos),
                    });

                    const result = await response.json();
                    console.log(result);
                    console.log(response);
                    if (response.ok) {
                        alert(`#{entityName}: ${result.nombre} ${result.apellido} agregado con exito.`); //si ok
                        form.reset(); // limpia
                    } else {
                        alert(result.error); // si no ok
                    }
                } catch (error) {
                    console.error("Error al enviar el formulario:", error);
                    alert("Ha ocurrido un error inesperado");
                }
                
            })

//-editar entidades

mixin editEntidad(entityURL,entityName,singleEntityAttr)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%;" id="formularioEnfermero")
            div.d-flex.justify-content-center
            form(id=`form${entityName}`, onsubmit="event.preventDefault(); guardarCambios();")
                div.form-floating.mb-2
                    input.form-control(type="text", id="id" name="id" readonly placeholder="ID")
                    label(for="id") ID
                div.form-floating.mb-2
                    input.form-control(type="text", id="dni" name="dni" placeholder="DNI" required)
                    label(for="dni") DNI
                div.form-floating.mb-2
                    input.form-control(type="text", id="nombre" name="nombre" placeholder="Nombre" required)
                    label(for="nombre") Nombre
                div.form-floating.mb-2
                    input.form-control(type="text", id="apellido" name="apellido" placeholder="Apellido" required)
                    label(for="apellido") Apellido
                div.form-floating.mb-2
                    input.form-control(type="text", id="telefono" name="telefono" placeholder="Teléfono" required)
                    label(for="telefono") Teléfono
                div.form-floating.mb-2
                    input.form-control(type="text", id=`${singleEntityAttr.toLowerCase()}` name=`${singleEntityAttr.toLowerCase()}` placeholder="Area" required)
                    label(for=`${singleEntityAttr.toLowerCase()}`) #{singleEntityAttr}
                div.d-flex.justify-content-center.mt-4
                    button.btn.btn-primary.me-5.w-25(type="submit") Guardar Cambios
                    a.btn.btn-danger.ms-5.w-25(type="button" href=`/${entityURL}/admin/seleccionar`) Cancelar

        script.
            function getQueryParams() { //traemos los parametros de la pagina de seleccion
                const params = new URLSearchParams(window.location.search);
                return {
                    id: params.get("id"),
                    dni: params.get("dni"),
                    nombre: params.get("nombre"),
                    apellido: params.get("apellido"),
                    telefono: params.get("telefono"),
                    #{singleEntityAttr.toLowerCase()}: params.get("attr"),
                };
            }

            // cargamos los datos traidos en el form
            function cargarFormulario() {
                const { id, dni, nombre, apellido, telefono, #{singleEntityAttr.toLowerCase()} } = getQueryParams();
                document.getElementById("id").value = id.trim();
                document.getElementById("dni").value = dni.trim();
                document.getElementById("nombre").value = nombre.trim();
                document.getElementById("apellido").value = apellido.trim();
                document.getElementById("telefono").value = telefono.trim();
                document.getElementById(`#{singleEntityAttr.toLowerCase()}`).value = #{singleEntityAttr.toLowerCase()}.trim();
            }

        
            cargarFormulario();

            async function guardarCambios() {
                const id = document.getElementById("id").value.trim();
                const dni = document.getElementById("dni").value.trim();
                const nombre = document.getElementById("nombre").value.trim();
                const apellido = document.getElementById("apellido").value.trim();
                const telefono = document.getElementById("telefono").value.trim();
                const #{singleEntityAttr.toLowerCase()} = document.getElementById(`#{singleEntityAttr.toLowerCase()}`).value.trim();

                try {
                    const response = await fetch(`/#{entityURL}/editar/${id}`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({ dni, nombre, apellido, telefono, #{singleEntityAttr.toLowerCase()}}),
                    });

                    if (!response.ok) {
                        throw new Error("Error al guardar los cambios");
                    }

                    alert("Cambios guardados con éxito");
                    window.location.href = `/#{entityURL}/admin/seleccionar`; // Redirige después de guardar
                } catch (error) {
                    console.error("Error al guardar los cambios:", error);
                    alert("No se pudieron guardar los cambios");
                }
            }

//-Tablas de turnos con filtros y busqueda
mixin turnosListar(profesionalTypeOf, context)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id=`tabla${profesionalTypeOf}`)
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        if profesionalTypeOf === "Medico"
                            tr.table-info
                                th.col(style="width: 10%") Fecha
                                th.col(style="width: 20%") Paciente
                                th.col(style="width: 12%") D.N.I.
                                th.col(style="width: 15%") #{profesionalTypeOf}
                                th.col(style="width: 10%") Hora
                                th.col(style="width: 20%") Especialidad
                                th.col(style="width: 8%") Estado
                                if context === "editar"
                                    th.col(style="width: 5%") Editar
                                else if context === "borrar"
                                    th.col(style="width: 5%") Borrar
                        
                        else
                            tr.table-info
                                th.col(style="width: 10%") Fecha
                                th.col(style="width: 20%") Paciente
                                th.col(style="width: 15%") D.N.I.
                                th.col(style="width: 15%") #{profesionalTypeOf}
                                th.col(style="width: 10%") Hora
                                th.col(style="width: 10%") Estado
                                if context === "editar"
                                    th.col(style="width: 5%") Editar
                                else if context === "borrar"
                                    th.col(style="width: 5%") Borrar
                    tbody
            
            div.mt-3(style="width: 100%;" id="filtros")
                    div.d-flex.align-items-center.justify-content-center
                        div.row(style="width: 100%;")
                            div.col.w-25
                                div.input-group.date(id="datepicker")
                                    input.form-control(id="inputDate", type="text", placeholder="Seleccione Fecha")
                                    span.input-group-text
                                        img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                            div.col.w-25
                                input.form-control.me-4(id="inputDni", type="text", placeholder="Ingrese DNI")
                            
                            div.col.w-25(id="conMedico")
                                select.form-select.mb-3.me-4(id="inputEspecialidad")
                                    option.selected(value="0") Filtro de Medicos por Especialidad
                                select.form-select(id="inputProf", type="text", placeholder="Ingrese Profesional")
                                    option.selected(value="0") Seleccione #{profesionalTypeOf}
                    div.d-flex.align-items-center.justify-content-center.mt-4
                        div.row(style="width: 100%;")   
                            div.col.w-25
                                button.btn.btn-info.w-50(id="aplicarFiltros" type="button" class="custom-button2" onclick="event.preventDefault(); aplicarFiltros();") Aplicar Filtros
                            div.col.w-25
                                button.btn.btn-warning.w-50(type="button" class="custom-button2" onclick="event.preventDefault(); location.reload();") Limpiar Filtros
                            div.col.w-25
                                if context === "listar"
                                    a.btn.btn-danger.w-50(href="/turnos/listar", type="button" id="volver" class="volver custom-button2") Volver
                                else if context === "editar"
                                    a.btn.btn-danger.w-50(href="/turnos/admin/seleccionar", type="button" id="volver" class="volver custom-button2") Volver
                                else if context === "borrar"
                                    a.btn.btn-danger.w-50(href="/turnos/admin/borrar", type="button" id="volver" class="volver custom-button2") Volver

        script.
            const fecha = document.getElementById("inputDate");
            const dni = document.getElementById("inputDni");
            const especialidad = document.getElementById("inputEspecialidad");
            const profesional = document.getElementById("inputProf");
            const conMedico = document.getElementById("conMedico");
            const sinMedico = document.getElementById("sinMedico");
            const aplicarFiltrosBtn = document.getElementById("aplicarFiltros");

            document.addEventListener("DOMContentLoaded", () => {
                async function cargarTurnos(profesionalTypeOf) {
                    const response = await fetch("/turnos/listado/join");
                    
                    if (!response.ok) {
                        throw new Error("Error al obtener los turnos de la DB");
                    }
                    const turnos = await response.json();
                    console.log("JSON de los turnos:", turnos); //POR FIN CARAJO
                    const tbody = document.querySelector(`#tabla${profesionalTypeOf} tbody`);
                    tbody.innerHTML = ""; // Limpia la tabla antes de llenarla
                    if('#{profesionalTypeOf}' === "Medico") {
                        turnos.forEach((turno) => {
                            if (!turno.Medico) {return;} //si medico viene null vuelve al foreach
                            const partesFecha = turno.fecha.split("-");
                            const fechaFormateada = `${partesFecha[2]}/${partesFecha[1]}/${partesFecha[0]}`; 
                            const fila = `
                                <tr>
                                    <td>${fechaFormateada}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.nombre} ${turno.Paciente.apellido}` : "N/A"}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.dni}` : "N/A"}</td>
                                    <td>${turno.Medico ? `${turno.Medico.nombre} ${turno.Medico.apellido}`: "N/A"}</td>
                                    <td>${turno.hora}</td>
                                    <td>${turno.Medico ? `${turno.Medico.especialidad}`: "N/A"}</td>
                                    <td>${turno.estado}</td>
                                    ${
                                        '#{context}' === "Editar" || '#{context}' === "editar"
                                            ? `<td>
                                                <button type="button" class="btn btn-warning" style="width: 100%; padding:5px;" onclick="editarTurno(${turno.id}, '${turno.fecha}', '${turno.hora}', '${turno.estado}', '${turno.Paciente.dni}', '${turno.Medico.nombre} ${turno.Medico.apellido}', '${turno.Medico.especialidad}')">
                                                <img src="/icons/user-pen-solid.svg" alt="Editar" style="width: 25px; height: 25px;">
                                                </button>
                                            </td>`
                                            : '#{context}' === "Borrar" || '#{context}' === "borrar"
                                            ? `<td>
                                                <button type="button" class="btn btn-danger" style="width: 100%; padding:5px;" onclick="borrarTurno(${turno.id}, '${turno.fecha}', '${turno.hora}', '${turno.estado}', '${turno.Paciente.dni}', '${turno.Medico.nombre} ${turno.Medico.apellido}')">
                                                <img src="/icons/user-slash-solid.svg" alt="Borrar" style="width: 25px; height: 25px;">
                                                </button>
                                            </td>`
                                            : ""
                                    }
                                </tr>
                            `;
                            tbody.innerHTML += fila;
                        });
                    } else {
                        turnos.forEach((turno) => {
                            if (!turno.Enfermero) {return;}
                            const partesFecha = turno.fecha.split("-");
                            const fechaFormateada = `${partesFecha[2]}/${partesFecha[1]}/${partesFecha[0]}`; 
                            const fila = `
                                <tr>
                                    <td>${fechaFormateada}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.nombre} ${turno.Paciente.apellido}` : "N/A"}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.dni}` : "N/A"}</td>
                                    <td>${turno.Enfermero ? `${turno.Enfermero.nombre} ${turno.Enfermero.apellido}`: "N/A"}</td>
                                    <td>${turno.hora}</td>
                                    <td>${turno.estado}</td>
                                    ${
                                        '#{context}' === "Editar" || '#{context}' === "editar"
                                            ? `<td>
                                                <button type="button" class="btn btn-warning" style="width: 100%; padding:5px;" onclick="editarTurno(${turno.id}, '${turno.fecha}', '${turno.hora}', '${turno.estado}', '${turno.Paciente ? turno.Paciente.dni : ""}', '${turno.Enfermero ? turno.Enfermero.nombre + " " + turno.Enfermero.apellido : ""}', '')">
                                                <img src="/icons/user-pen-solid.svg" alt="Editar" style="width: 25px; height: 25px;">
                                                </button>
                                            </td>`
                                            : '#{context}' === "Borrar" || '#{context}' === "borrar"
                                            ? `<td>
                                                <button type="button" class="btn btn-danger" style="width: 100%; padding:5px;" onclick="borrarTurno(${turno.id}, '${turno.fecha}', '${turno.hora}', '${turno.estado}', '${turno.Paciente ? turno.Paciente.dni : ""}', '${turno.Enfermero ? turno.Enfermero.nombre + " " + turno.Enfermero.apellido : ""}')">
                                                <img src="/icons/user-slash-solid.svg" alt="Borrar" style="width: 25px; height: 25px;">
                                                </button>
                                            </td>`
                                            : ""
                                    }
                                </tr>
                            `;
                            tbody.innerHTML += fila;
                        });
                    }
                    if('#{profesionalTypeOf}' === "Enfermero") {
                        especialidad.remove();
                    }


                }
                cargarTurnos('#{profesionalTypeOf}');
            });

