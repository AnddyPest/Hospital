//-Botones y campos de texto para filtrar y limpiar

mixin inputGroup(id, placeholder, btnFiltrarText, btnLimpiarText, btnVolverText)
                div.mt-3(id=id, style="display: none;")
                    div.d-flex.align-items-center.justify-content-center
                        input.form-control.me-4(type="text", placeholder=placeholder, aria-label=placeholder, style="width: 400px; padding: 15px 30px;")
                        button.btn.btn-info(type="button" class="custom-button2")= btnFiltrarText
                        button.btn.btn-warning.ms-2(type="button" class="custom-button2")= btnLimpiarText
                        button.btn.btn-danger.ms-2(type="button" id="volver" class="volver custom-button2")= btnVolverText

//-Header de la pag con título e icono

mixin header(title, iconSrc)
    div.position-absolute.start-50.translate-middle-x.text-center.text-white(style="top: 10%; opacity: 0.8;")
        h1(style="padding: 20px; background-color: rgba(0, 0, 0, 0.5); border-radius: 10px;")
            span(id="cabecera" style="font-size: 2.5rem;")= title
            img(src=iconSrc, alt="Medicos", class="ms-4", style="width: 60px; height: 60px;")

//-Botones de admin de entidades

mixin adminGeneral(entityURL, entityName)
    div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.w-75(id="adminControl")
        div.d-flex.justify-content-center.align-items-center.gap-4.mt-5
            a.btn.btn-success.ms-4(href=`/${entityURL}/admin/new` type="button", id="agregar" class="custom-button2" style="width: 350px;") 
                span() Agregar #{entityName}
                img(src="/icons/user-plus-solid.svg", alt=`Agregar ${entityName}`, class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
            a.btn.btn-warning(href=`/${entityURL}/admin/seleccionar`, type="button", id="editar" class="custom-button2" style="width: 350px;") 
                span() Editar #{entityName}
                img(src="/icons/user-pen-solid.svg", alt=`Editar ${entityName}`, class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
            a.btn.btn-danger.me-4(href=`/${entityURL}/admin/borrar`, type="button", id="borrar" class="custom-button2" style="width: 350px;") 
                span() Borrar #{entityName}
                img(src="/icons/user-slash-solid.svg", alt=`Borrar ${entityName}`, class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
            a.btn.btn-danger.ms-4(href=`/${entityURL}` type="button", class="custom-button2" style="width: 50px; padding:5px;") 
                img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")

//-Tablas de entidades con busqueda y filtros para las paginas de listar

mixin tablaConBuscador(entityURL, entityName, singleEntityAttr)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id=`tabla${entityName}`)
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                    table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                        thead(style="position: sticky; top: 0;")
                            tr.table-info
                                th.col(style="width: 10%") ID
                                th.col(style="width: 22.5%") Nombre
                                th.col(style="width: 22.5%") Apellido
                                th.col(style="width: 22.5%") Telefono
                                th.col(style="width: 22.5%") #{singleEntityAttr}
                        tbody

            div.mt-3(id="filtros")
                button.btn.btn-info.me-4(type="button", id=`btn${singleEntityAttr}` class="custom-button2") Filtrar por #{singleEntityAttr}
                button.btn.btn-info.ms-4.me-4(type="button", id="btnNombre" class="custom-button2") Buscar por Apellido
                a.btn.btn-danger.ms-4(href=`/${entityURL}` type="button", class="custom-button2" style="width: 50px; padding:5px;") 
                    img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")

            +inputGroup(`input${singleEntityAttr}`, `Ingrese ${singleEntityAttr}`, "Filtrar", "Limpiar", "Volver")
            +inputGroup("inputApe", "Ingrese el Apellido", "Filtrar", "Limpiar", "Volver")

        script.
            document.addEventListener("DOMContentLoaded", () => {
                async function cargarEntidad(entityURL, entityName, singleEntityAttr) {
                    try {
                        const response = await fetch(`/${entityURL}/listado`);
                        if (!response.ok) {
                            throw new Error(`Error al obtener los ${entityURL} de la DB: ${response.status} ${response.statusText}`);
                        }
                        const entidades = await response.json();

                        const tbody = document.querySelector(`#tabla${entityName} tbody`);
                        if (!tbody) {
                            throw new Error(`No se encontró el tbody para la tabla con ID 'tabla${entityName}'`);
                        }

                        tbody.innerHTML = ""; // Limpia la tabla antes de llenarla

                        entidades.forEach((entidad) => {
                            const fila = `
                                <tr>
                                    <td>${entidad.id || "N/A"}</td>
                                    <td>${entidad.nombre || "N/A"}</td>
                                    <td>${entidad.apellido || "N/A"}</td>
                                    <td>${entidad.telefono || "N/A"}</td>
                                    <td>${entidad[singleEntityAttr.toLowerCase()] || "N/A"}</td>
                                </tr>
                            `;
                            tbody.innerHTML += fila;
                        });
                    } catch (error) {
                        console.error(`Error al cargar los ${entityURL}:`, error);
                        alert(`No se pudieron cargar los ${entityURL}.`);
                    }
                }

                cargarEntidad("#{entityURL}", "#{entityName}", "#{singleEntityAttr}");

                const btnSingle = document.getElementById("btn#{singleEntityAttr}");
                const btnNombre = document.getElementById("btnNombre");
                const containerFiltros = document.getElementById("filtros");
                const inputSingle = document.getElementById("input#{singleEntityAttr}");
                const inputApe = document.getElementById("inputApe");
                const btnVolver = document.querySelectorAll(".volver");

                if (btnSingle) {
                    btnSingle.addEventListener("click", (e) => {
                        e.preventDefault();
                        containerFiltros.style.display = "none";
                        inputSingle.style.display = "block";
                        inputSingle.querySelector("input").focus();
                    });
                }

                if (btnNombre) {
                    btnNombre.addEventListener("click", (e) => {
                        e.preventDefault();
                        containerFiltros.style.display = "none";
                        inputApe.style.display = "block";
                        inputApe.querySelector("input").focus();
                    });
                }

                if (btnVolver.length > 0) {
                    btnVolver.forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            e.preventDefault();
                            inputSingle.style.display = "none";
                            inputApe.style.display = "none";
                            containerFiltros.style.display = "block";
                        });
                    });
                }
            });

//-Tablas para las vistas de editar y borrar con botobn de volvler

mixin tablaEditErase(entityURL, entityName, singleEntityAttr, context)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id=`tabla${entityName}`)
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        tr.table-info
                            th.col(style="width: 10%") ID
                            th.col(style="width: 22.5%") Nombre
                            th.col(style="width: 22.5%") Apellido
                            th.col(style="width: 22.5%") Telefono
                            th.col(style="width: 22.5%") #{singleEntityAttr}
                            th.col(style="width: 10%") #{context.charAt(0).toUpperCase() + context.slice(1)}
                            
                    
                    tbody
            a.btn.btn-danger.ms-2.mt-5(href=`/${entityURL}/admin` type="button" id="volver" class="volver custom-button2") Volver

        script.
            //carga de medicos en tabla
            async function cargarEntidad(entityURL, entityName, singleEntityAttr, context) {
                try {
                    const response = await fetch(`/${entityURL}/listado`);
                    console.log(response);
                    if(!response.ok) {
                        throw new Error(`Error al obtener ${entityURL}  de la DB`);
                    }
                    const entidades = await response.json();

                    const tbody = document.querySelector(`#tabla${entityName} tbody`);
                    tbody.innerHTML = ""; //Limpia la tabla si se hizo una modificacion o busqueda.

                    entidades.forEach((entidad) => {
                        const fila = `
                            <tr>
                                <td>${entidad.id}</td>
                                <td>${entidad.nombre}</td>
                                <td>${entidad.apellido}</td>
                                <td>${entidad.telefono}</td>
                                <td>${entidad[singleEntityAttr.toLowerCase()]}</td>
                                ${
                                    context === "Editar"
                                        ? `<td>
                                            <button type="button" class="btn btn-warning" style="width: 100%; padding:5px;" onclick="editarEntidad(${entidad.id}, '${entidad.nombre}', '${entidad.apellido}', '${entidad.telefono}', '${entidad[singleEntityAttr.toLowerCase()]}', '${context}')">
                                                <img src="/icons/user-pen-solid.svg" alt="Editar" style="width: 25px; height: 25px;">
                                            </button>
                                        </td>`
                                        : context === "Borrar"
                                        ? `<td>
                                            <button type="button" class="btn btn-danger" style="width: 100%; padding:5px;" onclick="borrarEntidad(${entidad.id}, '${entidad.nombre}', '${entidad.apellido}')">
                                                <img src="/icons/user-slash-solid.svg" alt="Borrar" style="width: 25px; height: 25px;">
                                            </button>
                                        </td>`
                                        : ""
                                }
                            </tr>
                        `;
                        tbody.innerHTML += fila;
                    });
                } catch (error) {
                    console.error(`Error al cargar los ${entityURL}:`, error);
                    alert(`No se pudieron cargar los ${entityURL}.`)
                }};

            cargarEntidad("#{entityURL}", "#{entityName}", "#{singleEntityAttr}", "#{context}");

            async function editarEntidad(id, nombre, apellido, telefono, singleEntityAttr, context) {
                
                const nombreLimpio = nombre.trim();
                const apellidoLimpio = apellido.trim();
                const telefonoLimpio = telefono.trim();
                const attrLimpio = singleEntityAttr.trim();
                const contextLimpio = context.toLowerCase().trim();
                
                window.location.href = 
                `/#{entityURL}/admin/${contextLimpio }?id=${id}
                &nombre=${encodeURIComponent(nombreLimpio)}
                &apellido=${encodeURIComponent(apellidoLimpio)}
                &telefono=${encodeURIComponent(telefonoLimpio)}
                &attr=${encodeURIComponent(attrLimpio)}`; 
            }

            async function borrarEntidad(id, nombre, apellido) {
            const confirmacion = confirm(`¿Estás seguro de que deseas borrar al médico ${nombre} ${apellido}?`);
            if (!confirmacion) {
                return;
            }
            try {
                const response = await fetch(`/#{entityURL}/borrar/${id}`, {
                    method: "DELETE",
                });

                if (!response.ok) {
                    throw new Error(`Error al borrar el ${entityName}`);
                }

                alert(`#{entityName} ID: ${id}, Nombre y Apellido: ${nombre} ${apellido} borrado con éxito`);
                location.reload(); // Recarga la página para actualizar la tabla
            } catch (error) {
                console.error(`Error al borrar el #{entityName}:`, error);
                alert(`No se pudo borrar el #{entityName}`);
            }
            }

//- Crear nueva entidad

mixin nuevaEntidad(entityURL, entityName, singleEntityAttr)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rouded-3(style="width: 80%;" id=`formulario${entityName}`)
            div.d-flex.justify-content-center
                form.w-75(id=`form${entityName}`, method="POST", action=`/${entityURL}/admin/new`)
                    div.form-floating.mb-3
                        input.form-control(type="text", id="nombre", name="nombre", placeholder="Nombre" required)
                        label(for="nombre") Nombre
                    div.form-floating.mb-3
                        input.form-control(type="text", id="apellido", name="apellido", placeholder="Apellido" required)
                        label(for="apellido") Apellido
                    div.form-floating.mb-3
                        input.form-control(type="text", id=`${singleEntityAttr.toLowerCase()}`, name=`${singleEntityAttr.toLowerCase()}` placeholder="Area" required)
                        label(for=`${singleEntityAttr}`) #{singleEntityAttr}
                    div.form-floating.mb-3
                        input.form-control(type="text", id="telefono", name="telefono", placeholder="Teléfono" required)
                        label(for="telefono") Teléfono
                    div.d-flex.justify-content-center.mt-4
                        button.btn.btn-primary.me-5.w-25(type="submit") Guardar #{entityName}
                        a.btn.btn-danger.ms-5.w-25(href=`/${entityURL}/admin` type="button", id="cancelar") Cancelar

        script.
            
            document.getElementById(`form#{entityName}`).addEventListener("submit", async function(event) {
                event.preventDefault();

                const form = document.getElementById(`form#{entityName}`);
                
                const formData = new FormData(form);

                const datos = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch(`/#{entityURL}/admin/new`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(datos),
                    });

                    const result = await response.json();
                    console.log(result);
                    console.log(response);
                    if (response.ok) {
                        alert(`#{entityName}: ${result.nombre} ${result.apellido} agregado con exito.`); //si ok
                        form.reset(); // limpia
                    } else {
                        alert(result.error); // si no ok
                    }
                } catch (error) {
                    console.error("Error al enviar el formulario:", error);
                    alert("Ha ocurrido un error inesperado");
                }
                
            })