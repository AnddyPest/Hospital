//-Header de la pag con título e icono

mixin header(title, iconSrc)
    div.position-absolute.start-50.translate-middle-x.text-center.text-white.mb-5(style="top: 10%; opacity: 0.8;")
        h1(style="padding: 15px; background-color: rgba(0, 0, 0, 0.5); border-radius: 10px;")
            span(id="cabecera" style="font-size: 2.2rem;")= title
            img(src=iconSrc, alt="Medicos", class="ms-4", style="width: 60px; height: 60px;")

//-Botones de admin de entidades

mixin adminGeneral(entityURL, entityName)
    div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.w-75(id="adminControl")
        div.d-flex.justify-content-center.align-items-center.gap-4.mt-5
            a.btn.btn-success.ms-4(href=`/${entityURL}/admin/new` type="button", id="agregar" class="custom-button2" style="width: 350px;") 
                span() Agregar #{entityName}
                img(src="/icons/user-plus-solid.svg", alt=`Agregar ${entityName}`, class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
            a.btn.btn-warning(href=`/${entityURL}/admin/seleccionar`, type="button", id="editar" class="custom-button2" style="width: 350px;") 
                span() Editar #{entityName}
                img(src="/icons/user-pen-solid.svg", alt=`Editar ${entityName}`, class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
            a.btn.btn-danger.me-4(href=`/${entityURL}/admin/borrar`, type="button", id="borrar" class="custom-button2" style="width: 350px;") 
                span() Borrar #{entityName}
                img(src="/icons/user-slash-solid.svg", alt=`Borrar ${entityName}`, class="ms-4", style="width: 40px; height: 40px; opacity: 0.8;")
            a.btn.btn-danger.ms-4(href=`/${entityURL}` type="button", class="custom-button2" style="width: 50px; padding:5px;") 
                img(src="/icons/backward-solid.svg", alt="Volver", style="width: 35px; height: 35px;")


//-Tablas de turnos con filtros y busqueda
mixin turnosListar(profesionalTypeOf, context)
        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5(style="width: 80%" id=`tabla${profesionalTypeOf}`)
            div.table-container(style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px;")    
                table.table.table-hover.table-dark.table-bordered.border-info.table-striped
                    thead(style="position: sticky; top: 0;")
                        if profesionalTypeOf === "Medico"
                            tr.table-info
                                th.col(style="width: 10%") Fecha
                                th.col(style="width: 20%") Paciente
                                th.col(style="width: 12%") D.N.I.
                                th.col(style="width: 15%") #{profesionalTypeOf}
                                th.col(style="width: 10%") Hora
                                th.col(style="width: 20%") Especialidad
                                th.col(style="width: 8%") Estado
                                if context === "editar"
                                    th.col(style="width: 5%") Editar
                                else if context === "borrar"
                                    th.col(style="width: 5%") Borrar
                        
                        else
                            tr.table-info
                                th.col(style="width: 10%") Fecha
                                th.col(style="width: 20%") Paciente
                                th.col(style="width: 15%") D.N.I.
                                th.col(style="width: 15%") #{profesionalTypeOf}
                                th.col(style="width: 10%") Hora
                                th.col(style="width: 10%") Estado
                                if context === "editar"
                                    th.col(style="width: 5%") Editar
                                else if context === "borrar"
                                    th.col(style="width: 5%") Borrar
                    tbody
            
            div.mt-3(style="width: 100%;" id="filtros")
                    div.d-flex.align-items-center.justify-content-center
                        div.row(style="width: 100%;")
                            div.col.w-25
                                div.input-group.date(id="datepicker")
                                    input.form-control(id="inputDate", type="text", placeholder="Seleccione Fecha")
                                    span.input-group-text
                                        img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                            div.col.w-25
                                input.form-control.me-4(id="inputDni", type="text", placeholder="Ingrese DNI")
                            
                            div.col.w-25(id="conMedico")
                                select.form-select.mb-3.me-4(id="inputEspecialidad")
                                    option.selected(value="0") Filtro de Medicos por Especialidad
                                select.form-select(id="inputProf", type="text", placeholder="Ingrese Profesional")
                                    option.selected(value="0") Seleccione #{profesionalTypeOf}
                    div.d-flex.align-items-center.justify-content-center.mt-4
                        div.row(style="width: 100%;")   
                            div.col.w-25
                                button.btn.btn-info.w-50(id="aplicarFiltros" type="button" class="custom-button2" onclick="event.preventDefault(); aplicarFiltros();") Aplicar Filtros
                            div.col.w-25
                                button.btn.btn-warning.w-50(type="button" class="custom-button2" onclick="event.preventDefault(); location.reload();") Limpiar Filtros
                            div.col.w-25
                                if context === "listar"
                                    a.btn.btn-danger.w-50(href="/turnos/listar", type="button" id="volver" class="volver custom-button2") Volver
                                else if context === "editar"
                                    a.btn.btn-danger.w-50(href="/turnos/admin/seleccionar", type="button" id="volver" class="volver custom-button2") Volver
                                else if context === "borrar"
                                    a.btn.btn-danger.w-50(href="/turnos/admin/borrar", type="button" id="volver" class="volver custom-button2") Volver

        script.
            const fecha = document.getElementById("inputDate");
            const dni = document.getElementById("inputDni");
            const especialidad = document.getElementById("inputEspecialidad");
            const profesional = document.getElementById("inputProf");
            const conMedico = document.getElementById("conMedico");
            const sinMedico = document.getElementById("sinMedico");
            const aplicarFiltrosBtn = document.getElementById("aplicarFiltros");

            document.addEventListener("DOMContentLoaded", () => {
                async function cargarTurnos(profesionalTypeOf) {
                    const response = await fetch("/turnos/listado/join");
                    
                    if (!response.ok) {
                        throw new Error("Error al obtener los turnos de la DB");
                    }
                    const turnos = await response.json();
                    console.log("JSON de los turnos:", turnos); //POR FIN CARAJO
                    const tbody = document.querySelector(`#tabla${profesionalTypeOf} tbody`);
                    tbody.innerHTML = ""; // Limpia la tabla antes de llenarla
                    if('#{profesionalTypeOf}' === "Medico") {
                        turnos.forEach((turno) => {
                            if (!turno.Medico) {return;} //si medico viene null vuelve al foreach
                            const partesFecha = turno.fecha.split("-");
                            const fechaFormateada = `${partesFecha[2]}/${partesFecha[1]}/${partesFecha[0]}`; 
                            const fila = `
                                <tr>
                                    <td>${fechaFormateada}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.nombre} ${turno.Paciente.apellido}` : "N/A"}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.dni}` : "N/A"}</td>
                                    <td>${turno.Medico ? `${turno.Medico.nombre} ${turno.Medico.apellido}`: "N/A"}</td>
                                    <td>${turno.hora}</td>
                                    <td>${turno.Medico ? `${turno.Medico.especialidad}`: "N/A"}</td>
                                    <td>${turno.estado}</td>
                                    ${
                                        '#{context}' === "Editar" || '#{context}' === "editar"
                                            ? `<td>
                                                <button type="button" class="btn btn-warning" style="width: 100%; padding:5px;" onclick="editarTurno(${turno.id}, '${turno.fecha}', '${turno.hora}', '${turno.estado}', '${turno.Paciente.dni}', '${turno.Medico.nombre} ${turno.Medico.apellido}', '${turno.Medico.especialidad}')">
                                                <img src="/icons/user-pen-solid.svg" alt="Editar" style="width: 25px; height: 25px;">
                                                </button>
                                            </td>`
                                            : '#{context}' === "Borrar" || '#{context}' === "borrar"
                                            ? `<td>
                                                <button type="button" class="btn btn-danger" style="width: 100%; padding:5px;" onclick="borrarTurno(${turno.id}, '${turno.fecha}', '${turno.hora}', '${turno.estado}', '${turno.Paciente.dni}', '${turno.Medico.nombre} ${turno.Medico.apellido}')">
                                                <img src="/icons/user-slash-solid.svg" alt="Borrar" style="width: 25px; height: 25px;">
                                                </button>
                                            </td>`
                                            : ""
                                    }
                                </tr>
                            `;
                            tbody.innerHTML += fila;
                        });
                    } else {
                        turnos.forEach((turno) => {
                            if (!turno.Enfermero) {return;}
                            const partesFecha = turno.fecha.split("-");
                            const fechaFormateada = `${partesFecha[2]}/${partesFecha[1]}/${partesFecha[0]}`; 
                            const fila = `
                                <tr>
                                    <td>${fechaFormateada}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.nombre} ${turno.Paciente.apellido}` : "N/A"}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.dni}` : "N/A"}</td>
                                    <td>${turno.Enfermero ? `${turno.Enfermero.nombre} ${turno.Enfermero.apellido}`: "N/A"}</td>
                                    <td>${turno.hora}</td>
                                    <td>${turno.estado}</td>
                                    ${
                                        '#{context}' === "Editar" || '#{context}' === "editar"
                                            ? `<td>
                                                <button type="button" class="btn btn-warning" style="width: 100%; padding:5px;" onclick="editarTurno(${turno.id}, '${turno.fecha}', '${turno.hora}', '${turno.estado}', '${turno.Paciente ? turno.Paciente.dni : ""}', '${turno.Enfermero ? turno.Enfermero.nombre + " " + turno.Enfermero.apellido : ""}', '')">
                                                <img src="/icons/user-pen-solid.svg" alt="Editar" style="width: 25px; height: 25px;">
                                                </button>
                                            </td>`
                                            : '#{context}' === "Borrar" || '#{context}' === "borrar"
                                            ? `<td>
                                                <button type="button" class="btn btn-danger" style="width: 100%; padding:5px;" onclick="borrarTurno(${turno.id}, '${turno.fecha}', '${turno.hora}', '${turno.estado}', '${turno.Paciente ? turno.Paciente.dni : ""}', '${turno.Enfermero ? turno.Enfermero.nombre + " " + turno.Enfermero.apellido : ""}')">
                                                <img src="/icons/user-slash-solid.svg" alt="Borrar" style="width: 25px; height: 25px;">
                                                </button>
                                            </td>`
                                            : ""
                                    }
                                </tr>
                            `;
                            tbody.innerHTML += fila;
                        });
                    }
                    if('#{profesionalTypeOf}' === "Enfermero") {
                        especialidad.remove();
                    }


                }
                cargarTurnos('#{profesionalTypeOf}');
            });

            $(document).ready(function() {
                $('#datepicker input').datepicker({
                    format: 'dd/mm/yyyy',
                    autoclose: true,
                    todayHighlight: true,
                    language: 'es',
                    

                });
            });
            // especialidades... el metodo de filtros deberia incluir especialidades
            document.addEventListener("DOMContentLoaded", () => {
                const profesionalTypeOf = "#{profesionalTypeOf}";
                if(profesionalTypeOf === "Medico") {
                    async function cargarEspecialidades() {
                        const response = await fetch("/medicos/especialidades");
                        if (!response.ok) {
                            throw new Error("Error al obtener las especialidades de la DB");
                        }
                        const especialidades = await response.json();
                        console.log("JSON de las especialidades:", especialidades);
                        especialidades.forEach((esp) => {
                            const option = document.createElement("option");
                            option.value = esp;
                            option.textContent = esp;
                            especialidad.appendChild(option);
                        });

                    };
                    cargarEspecialidades();
                    
                };
            });

          

            document.addEventListener("DOMContentLoaded", () => {
                const profesionalTypeOf = "#{profesionalTypeOf}";
                if(profesionalTypeOf === "Medico") {
                    async function cargarMedicos() {
                        if(especialidad.value === "0") {
                            return
                        }
                        const response = await fetch(`/medicos/especialidades/${especialidad.value}`);
                        if (!response.ok) {
                            throw new Error("Error al obtener los medicos de la DB");
                        }
                        const medicos = await response.json();
                        console.log("JSON de los medicos:", medicos);
                        profesional.innerHTML = ""; // Limpiar las opciones anteriores
                        medicos.forEach((medico) => {
                            const option = document.createElement("option");
                            option.value = medico.id;
                            option.textContent = `${medico.nombre} ${medico.apellido}`;
                            profesional.appendChild(option);
                        });
                    }
                    especialidad.addEventListener("change", cargarMedicos);
                }else{
                    async function cargarEnfermeros() {
                        const response = await fetch("/enfermeros/areas/Triage de Ingreso");
                        if (!response.ok) {
                            throw new Error("Error al obtener los enfermeros de la DB");
                        }
                        const enfermeros = await response.json();
                        console.log("JSON de los enfermeros:", enfermeros);
                        enfermeros.forEach((enfermero) => {
                            const option = document.createElement("option");
                            option.value = enfermero.id;
                            option.textContent = `${enfermero.nombre} ${enfermero.apellido}`;
                            profesional.appendChild(option);
                        });
                    };
                    cargarEnfermeros();
                    
                }
            })
        
            async function aplicarFiltros() {
                const profesionalTypeOf = "#{profesionalTypeOf}";
                const tbody = document.querySelector(`#tabla${profesionalTypeOf} tbody`);
                fechaValue = fecha.value.trim();
                dniValue = dni.value.trim();
                profesionalValue = profesional.options[profesional.selectedIndex]?.textContent.trim();
                console.log("Valores de los filtros:", fechaValue, dniValue, profesionalValue);
                if(fechaValue) {
                    const partesFecha = fechaValue.split("/");
                    fechaFormateada = `${partesFecha[2]}-${partesFecha[1]}-${partesFecha[0]}`; // Formato YYYY-MM-DD
                }
             
                

                //hay que armar el query con los filros opcionales
                const query = new URLSearchParams();
                if (fechaValue) {
                    query.append("fecha", fechaFormateada);
                }
                if (dniValue) {
                    query.append("dni", dniValue);
                }
                if (profesional.value != "0") {
                    query.append("profesional", profesionalValue);
                }

                const response = await fetch(`/turnos/listado/filtros?${query.toString()}`);
                console.log("Response del filtro:", response);
                if (!response.ok) {
                    throw new Error("Error al obtener los turnos de la DB");
                }
                const turnos = await response.json();
                console.log("JSON de los turnos:", turnos);

                if(profesionalTypeOf === "Medico") {
                    tbody.innerHTML = "";
                    turnos.forEach((turno) => {
                            if (!turno.Medico) {return;} //si medico viene null vuelve al foreach
                            const partesFecha = turno.fecha.split("-");
                            const fechaFormateada = `${partesFecha[2]}/${partesFecha[1]}/${partesFecha[0]}`; 
                            const fila = `
                                <tr>
                                    <td>${fechaFormateada}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.nombre} ${turno.Paciente.apellido}` : "N/A"}</td>
                                    <td>${turno.Paciente ? `${turno.Paciente.dni}` : "N/A"}</td>
                                    <td>${turno.Medico ? `${turno.Medico.nombre} ${turno.Medico.apellido}`: "N/A"}</td>
                                    <td>${turno.hora}</td>
                                    <td>${turno.Medico ? `${turno.Medico.especialidad}`: "N/A"}</td>
                                    <td>${turno.estado}</td>
                                </tr>
                            `;
                            tbody.innerHTML += fila;
                        });
                }else{
                     turnos.forEach((turno) => {
                        tbody.innerHTML = "";
                        if (!turno.Enfermero) {return;}
                        const partesFecha = turno.fecha.split("-");
                        const fechaFormateada = `${partesFecha[2]}/${partesFecha[1]}/${partesFecha[0]}`; 
                        const fila = `
                            <tr>
                                <td>${fechaFormateada}</td>
                                <td>${turno.Paciente ? `${turno.Paciente.nombre} ${turno.Paciente.apellido}` : "N/A"}</td>
                                <td>${turno.Paciente ? `${turno.Paciente.dni}` : "N/A"}</td>
                                <td>${turno.Enfermero ? `${turno.Enfermero.nombre} ${turno.Enfermero.apellido}`: "N/A"}</td>
                                <td>${turno.hora}</td>
                                <td>${turno.estado}</td>
                            </tr>
                        `;
                        tbody.innerHTML += fila;
                    });
                    
                }
            }

