extends ../templates/layout.pug

include ../templates/mixins.pug

block content
    div
        img(src="/images/fachada.jpeg" class="d-block w-100" alt="Imagen 3" style="height: calc(83vh - 10vh); object-fit: cover; border-radius: 10px; opacity: 0.5;")
        
        +header("Emergencia", "/icons/triangle-exclamation-solid.svg")

        div.position-absolute.top-50.start-50.translate-middle.text-center.mt-5.rounded-3(style="width: 80%" id="formularioNewTriage")
            
            // Radio buttons para seleccionar tipo de paciente
            div.row.align-items-center.mb-3
                div.col.w-25
                    div.form-check.form-check-inline
                        input.form-check-input#pacienteExistente(type="radio" name="tipoPaciente" value="existente" checked)
                        label.form-check-label(for="pacienteExistente") Paciente Existente
                    div.form-check.form-check-inline
                        input.form-check-input#pacienteSinIdentificacion(type="radio" name="tipoPaciente" value="sinIdentificacion")
                        label.form-check-label(for="pacienteSinIdentificacion") Paciente Sin Identificación

            div.row.align-items-center.mb-5.mt-3
                div.col.w-25
                    div.input-group#seccionDNI
                        input.form-control.form-control-lg(type="text" id="inputDNI" name="inputDNI" placeholder="Ingrese D.N.I." aria-label="DNI" aria-describedby="basic-addon1")
                        span.input-group-text(id="dniSpan" style="background-color: #0d6efd;")
                            img(src="/icons/user-solid.svg" style="width: 20px; height: 20px;")
                    
                    // Selector de sexo (oculto inicialmente)
                    div#seccionSexo(style="display: none;")
                        select#sexoPaciente.form-select.form-select-lg.w-100.h-100(name="sexoPaciente")
                            option(value="" selected disabled) Seleccione sexo
                            option(value="M") Masculino
                            option(value="F") Femenino
                            
                div.col.w-25
                    // Área fija - no seleccionable
                    select.form-select.form-select-lg.h-100.bg-danger.text-white(disabled)
                        option(selected) Emergentología
                        
                div.col.w-25
                    select.form-select.form-select-lg.w-100.h-100(id="selectMedico" name="selectMedico")
                        option(selected disabled) Seleccione un Médico
                        each medico in medicos || []
                            option(value=medico.id) #{medico.apellido}, #{medico.nombre}
            
            div.row.align-items-center.mb-5
                div.col.w-25
                    // Selector de motivos
                    select#motivo.form-select.form-select-lg.w-100.h-100(name="motivo")
                        option(selected disabled value="") Seleccione un Motivo
                        each mot in motivos || []
                            option(value=mot.id) #{mot.nombre}
                            
                div.col.w-25
                    div.input-group.date(id="datepicker")
                        input.form-control.form-control-lg(type="text" id="inputFecha" placeholder="Seleccione una fecha" value=fechaActual disabled)
                        span.input-group-text
                            img(src="/icons/calendar-days-solid.svg" style="width: 20px; height: 20px;")
                            
                div.col.w-25
                   
                
            
                
                
                        
            div.row.align-items-center.mt-5
                div.col.w-25
                    button.btn.w-75.btn-danger(class="custom-button2" id="botonNext" onclick="event.preventDefault(); aceptarDatos();") Registrar Emergencia
            div.row.align-items-center  
                div.col.w-25
                div.col.w-50
                    a.btn.w-75.btn-warning.mt-5(href="#" class="btn-secondary custom-button2" id="botonReiniciar" onclick="event.preventDefault(); location.reload();") Reiniciar Formulario
                div.col.w-25
            div.row.align-items-center   
                div.col.w-25
                div.col.w-50
                div.col.w-25
                    a.btn.w-50.btn-dark(href="/emergencias" class="btn-secondary custom-button2" id="botonAtras") Atrás

    script.
        let idPaciente = null;

        // Buscar paciente por DNI cuando se pierde el foco del input
        document.getElementById('inputDNI').addEventListener('blur', async function() {
            const dni = this.value.trim();
            if (!dni) return;
            try {
            const res = await fetch(`/pacientes/listado/${dni}`);
            if (res.ok) {
                const paciente = await res.json();
                idPaciente = paciente.id;
                document.getElementById('dniSpan').style.backgroundColor = "#28a745"; // verde
            } else {
                idPaciente = null;
                document.getElementById('dniSpan').style.backgroundColor = "#dc3545"; // rojo
            }
            } catch (e) {
            idPaciente = null;
            document.getElementById('dniSpan').style.backgroundColor = "#dc3545";
            }
        });

        // Mostrar/ocultar selector de sexo según tipo de paciente
        document.querySelectorAll('input[name="tipoPaciente"]').forEach(radio => {
            radio.addEventListener('change', function() {
            if (this.value === 'sinIdentificacion') {
                document.getElementById('seccionSexo').style.display = '';
            } else {
                document.getElementById('seccionSexo').style.display = 'none';
            }
            });
        });

        async function aceptarDatos() {
            const tipoPaciente = document.querySelector('input[name="tipoPaciente"]:checked').value;
            const motivo_Id = document.getElementById('motivo').value;
            const medico_Id = document.getElementById('selectMedico').value;
            const descripcion = ""; // Puedes agregar un campo de descripción si lo necesitas

            if (!motivo_Id || !medico_Id) {
            alert("Debe seleccionar un motivo y un médico.");
            return;
            }

            let datos = {};

            if (tipoPaciente === 'existente') {
            if (!idPaciente) {
                alert("Debe ingresar un DNI válido de un paciente existente.");
                return;
            }
            datos = {
                paciente_Id: idPaciente,
                motivo_Id,
                medico_Id,
                descripcion
            };
            } else {
            // Paciente sin identificación
            const sexo = document.getElementById('sexoPaciente').value;
            if (!sexo) {
                alert("Debe seleccionar el sexo.");
                return;
            }
            // Generar DNI tipo EddMMhhmm
            const now = new Date();
            const pad = n => n.toString().padStart(2, "0");
            const dniEmergencia = `E${pad(now.getDate())}${pad(now.getMonth() + 1)}${pad(now.getHours())}${pad(now.getMinutes())}`;

            datos = {
                nombre: "Emergencia",
                apellido: "Emergencia", // El backend lo actualizará con el ID real
                sexo,
                dni: dniEmergencia,
                telefono: "Desconocido",
                email: "Desconocido",
                obra_social: "Desconocido",
                motivo_Id,
                medico_Id,
                descripcion
            };
            }

            try {
            const res = await fetch('/emergencias/crear', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(datos)
            });
            if (res.redirected) {
                window.location.href = res.url;
                return;
            }
            if (res.ok) {
                const data = await res.json();
                if (data.success && data.turnoId) {
                window.location.href = `/atencion/paciente/turno/${data.turnoId}`;
                } else if (data.success) {
                // fallback por si solo retorna success
                window.location.href = `/atencion/paciente/turno/${data.pacienteId}`;
                } else {
                alert(data.error || "Error al crear la emergencia.");
                }
            } else {
                alert("Error al crear la emergencia.");
            }
            } catch (e) {
            alert("Error de red o del servidor.");
            }
        }

